<http://vidwaan.ai/ontology> rdf:type owl:Ontology ;
    rdfs:comment "Vidwaan AI Vedic Ontology generated via Multi-LLM Pipeline" ;
    owl:versionInfo "2026-07-01" .

:Character rdf:type owl:Class .
:Place rdf:type owl:Class .
:Text rdf:type owl:Class .
:Concept rdf:type owl:Class .
:Deity rdf:type owl:Class .
:Event rdf:type owl:Class .

:Shiva rdf:type :Deity ;
    rdfs:label "Shiva" ;
    :description "The destroyer deity of the Hindu trimurti, major deity of Shaiva Puranas." ;
    .

:Agni rdf:type :Deity ;
    rdfs:label "Agni" ;
    :description "The fire god, acting as the mediator between humans and gods in rituals." ;
    .

:Yama rdf:type :Deity ;
    rdfs:label "Yama" ;
    :description "The god of death and justice." ;
    .

:Vyasa rdf:type :Character ;
    rdfs:label "Vyasa" ;
    :description "The legendary sage credited with compiling the Vedas and Puranas." ;
    .

:Manu rdf:type :Character ;
    rdfs:label "Manu" ;
    :description "The progenitor of humanity and ruler of each Manvantara." ;
    .

:Dhruva rdf:type :Character ;
    rdfs:label "Dhruva" ;
    :description "A devotee of Vishnu who attained the status of the pole star." ;
    .

:Mahapuranas rdf:type :Text ;
    rdfs:label "Mahapuranas" ;
    :description "The genre of 18 major Hindu encyclopedic scriptures." ;
    .

:Devi rdf:type :Deity ;
    rdfs:label "Devi" ;
    :description "The supreme goddess, representing cosmic energy and female divinity." ;
    .

:Surya rdf:type :Deity ;
    rdfs:label "Surya" ;
    :description "The solar deity, source of light and life." ;
    .

:Yajna rdf:type :Concept ;
    rdfs:label "Yajna" ;
    :description "Ritual fire sacrifices and offerings." ;
    .

:Yuga rdf:type :Concept ;
    rdfs:label "Yuga" ;
    :description "Cosmic age cyclical divisions (Satya, Treta, Dvapara, Kali)." ;
    .

:Daksha rdf:type :Character ;
    rdfs:label "Daksha" ;
    :description "A creator patriarch (Prajapati), son of Brahma." ;
    .

:Dharma rdf:type :Concept ;
    rdfs:label "Dharma" ;
    :description "Universal cosmic order and righteous duty." ;
    .

:Vishnu rdf:type :Deity ;
    rdfs:label "Vishnu" ;
    :description "The preserver deity of the Hindu trimurti, major deity of Vaishnava Puranas." ;
    .

:Brahma rdf:type :Deity ;
    rdfs:label "Brahma" ;
    :description "The creator deity of the Hindu trimurti." ;
    .

:Ganesha rdf:type :Deity ;
    rdfs:label "Ganesha" ;
    :description "The elephant-headed deity of wisdom and remover of obstacles." ;
    .

:Skanda rdf:type :Deity ;
    rdfs:label "Skanda" ;
    :description "The god of war, son of Shiva and Parvati." ;
    .

:Indra rdf:type :Deity ;
    rdfs:label "Indra" ;
    :description "The king of the gods and ruler of Svarga (heaven)." ;
    .

:Varuna rdf:type :Deity ;
    rdfs:label "Varuna" ;
    :description "The god of oceans, waters, and cosmic law." ;
    .

:Creation rdf:type :Event ;
    rdfs:label "Creation" ;
    :description "The cosmic creation process described in the Sarga sections of Puranas." ;
    .

:Krishna rdf:type :Deity ;
    rdfs:label "Krishna" ;
    :description "Avatara of Vishnu, supreme deity, ally of the Pandavas, and teacher of Arjuna." ;
    .

:Arjuna rdf:type :Character ;
    rdfs:label "Arjuna" ;
    :description "Third Pandava prince, the archer disciple of Sri Krishna on the battlefield of Kurukshetra." ;
    .

:Yudhishthira rdf:type :Character ;
    rdfs:label "Yudhishthira" ;
    :description "Eldest Pandava prince, known for his adherence to truth and righteousness." ;
    .

:Bhima rdf:type :Character ;
    rdfs:label "Bhima" ;
    :description "Second Pandava brother, known for his colossal physical strength." ;
    .

:Nakula rdf:type :Character ;
    rdfs:label "Nakula" ;
    :description "Fourth Pandava prince, twin of Sahadeva, known for his beauty and expertise with swords." ;
    .

:Sahadeva rdf:type :Character ;
    rdfs:label "Sahadeva" ;
    :description "Fifth Pandava prince, twin of Nakula, renowned for his wisdom and astrological skills." ;
    .

:Draupadi rdf:type :Character ;
    rdfs:label "Draupadi" ;
    :description "The princess of Panchala, common wife of the five Pandava brothers." ;
    .

:Karna rdf:type :Character ;
    rdfs:label "Karna" ;
    :description "Great warrior and ally of Duryodhana, son of Surya and Kunti." ;
    .

:Duryodhana rdf:type :Character ;
    rdfs:label "Duryodhana" ;
    :description "The eldest son of Dhritarashtra and leader of the Kaurava faction." ;
    .

:Dhritarashtra rdf:type :Character ;
    rdfs:label "Dhritarashtra" ;
    :description "The blind king of Hastinapura, father of the Kauravas." ;
    .

:Vidura rdf:type :Character ;
    rdfs:label "Vidura" ;
    :description "Half-brother of Dhritarashtra and Pandu, prime minister of Hastinapura, famous for his wisdom." ;
    .

:Bhishma rdf:type :Character ;
    rdfs:label "Bhishma" ;
    :description "The grand patriarch of the Kuru dynasty, commander of the Kaurava army." ;
    .

:Drona rdf:type :Character ;
    rdfs:label "Drona" ;
    :description "The royal preceptor and teacher of military arts to both Pandavas and Kauravas." ;
    .

:Kripa rdf:type :Character ;
    rdfs:label "Kripa" ;
    :description "A family preceptor of the Kurus who fought on the Kaurava side." ;
    .

:Pandu rdf:type :Character ;
    rdfs:label "Pandu" ;
    :description "King of Hastinapura, younger brother of Dhritarashtra, father of the Pandavas." ;
    .

:Hastinapura rdf:type :Place ;
    rdfs:label "Hastinapura" ;
    :description "The capital city of the Kuru kingdom, over which the war is fought." ;
    .

:Indraprastha rdf:type :Place ;
    rdfs:label "Indraprastha" ;
    :description "The capital city built by the Pandavas in the forest of Khandavaprastha." ;
    .

:Dwarka rdf:type :Place ;
    rdfs:label "Dwarka" ;
    :description "The island city ruled by Krishna." ;
    .

:Karma rdf:type :Concept ;
    rdfs:label "Karma" ;
    :description "Action and its corresponding consequences." ;
    .

:Kurukshetra_War rdf:type :Event ;
    rdfs:label "Kurukshetra War" ;
    :description "The great 18-day battle between the Pandavas and Kauravas." ;
    .

:Mahabharata rdf:type :Text ;
    rdfs:label "Mahabharata" ;
    :description "The monumental Sanskrit epic detailing the history of the Kuru dynasty." ;
    .

:Kurukshetra rdf:type :Place ;
    rdfs:label "Kurukshetra" ;
    :description "The sacred battlefield where the Mahabharata war and Gita dialogue occur." ;
    .

:Moksha rdf:type :Concept ;
    rdfs:label "Moksha" ;
    :description "Liberation from the cycle of samsara." ;
    .

:Bhakti rdf:type :Concept ;
    rdfs:label "Bhakti" ;
    :description "The spiritual path of love, devotion, and surrender to the Divine." ;
    .

:Shakuni rdf:type :Character ;
    rdfs:label "Shakuni" ;
    :description "Prince of Gandhara, maternal uncle of Duryodhana, architect of the game of dice." ;
    .

:Vaikuntha rdf:type :Place ;
    rdfs:label "Vaikuntha" ;
    :description "The celestial abode of Lord Vishnu." ;
    .

:Narada rdf:type :Character ;
    rdfs:label "Narada" ;
    :description "The divine sage and messenger of the gods." ;
    .

:Bali rdf:type :Character ;
    rdfs:label "Bali" ;
    :description "The benevolent demon king who offered three paces of land to Vamana avatar." ;
    .

:Kashi rdf:type :Place ;
    rdfs:label "Kashi" ;
    :description "The sacred city of Shiva, center of pilgrimage." ;
    .

:Vishvamitra rdf:type :Character ;
    rdfs:label "Vishvamitra" ;
    :description "A great sage and king who attained the status of Brahmarishi through asceticism." ;
    .

:Mitra rdf:type :Deity ;
    rdfs:label "Mitra" ;
    :description "Vedic solar deity of friendship, contracts, and alliances, closely associated with Varuna." ;
    .

:Rta rdf:type :Concept ;
    rdfs:label "Rta" ;
    :description "The physical and moral order of the universe that gods and humans must follow." ;
    .

:Rigveda rdf:type :Text ;
    rdfs:label "Rigveda" ;
    :description "The oldest of the four Vedas, containing hymns to the deities." ;
    .

:Purusha rdf:type :Concept ;
    rdfs:label "Purusha" ;
    :description "The cosmic giant or primeval being from whose sacrifice the universe was created." ;
    .

:Ushas rdf:type :Deity ;
    rdfs:label "Ushas" ;
    :description "The goddess of dawn, bringing light and life to the world." ;
    .

:Ashvins rdf:type :Deity ;
    rdfs:label "Ashvins" ;
    :description "The twin horsemen, divine physicians who rescue and heal." ;
    .

:Savitr rdf:type :Deity ;
    rdfs:label "Savitr" ;
    :description "Vedic solar deity representing the morning sun, associated with the Gayatri mantra." ;
    .

:Soma rdf:type :Deity ;
    rdfs:label "Soma" ;
    :description "The deified sacred plant and drink of immortality offered in Vedic rituals." ;
    .

:Prithvi rdf:type :Deity ;
    rdfs:label "Prithvi" ;
    :description "The earth goddess, consort of Dyaus Pita." ;
    .

:Maruts rdf:type :Deity ;
    rdfs:label "Maruts" ;
    :description "The storm deities, companions of Indra and sons of Rudra." ;
    .

:Prahlada rdf:type :Character ;
    rdfs:label "Prahlada" ;
    :description "A saintly prince, devotee of Vishnu, saved from his demon father Hiranyakashipu." ;
    .

:Manvantara rdf:type :Concept ;
    rdfs:label "Manvantara" ;
    :description "Cosmic era ruled by a specific Manu, consisting of 71 Mahayugas." ;
    .

:Kailash rdf:type :Place ;
    rdfs:label "Kailash" ;
    :description "The sacred mountain abode of Lord Shiva." ;
    .

:Vashishtha rdf:type :Character ;
    rdfs:label "Vashishtha" ;
    :description "One of the Saptarishis (seven great sages), preceptor of Ikshvaku dynasty." ;
    .

:Ganga rdf:type :Place ;
    rdfs:label "Ganga" ;
    :description "The sacred river deity, who descended from heaven to purify souls." ;
    .

:Samaveda rdf:type :Text ;
    rdfs:label "Samaveda" ;
    :description "The Veda of melodies and chants chanted by Udgatri priests." ;
    .

:Rama rdf:type :Character ;
    rdfs:label "Rama" ;
    :description "The exiled prince of Ayodhyá, son of Dasaratha, and a hero of the Ikshváku race who searches for his abducted wife, Sítá." ;
    .

:Sita rdf:type :Character ;
    rdfs:label "Sita" ;
    :description "The daughter of Janak (Videhan Queen) and wife of Ráma, who is lured by a magic deer and abducted by RávaG." ;
    .

:Lakshmana rdf:type :Character ;
    rdfs:label "Lakshmana" ;
    :description "The loyal younger brother of Ráma who accompanies him in exile and serves as his guardian and confidant." ;
    .

:Ravana rdf:type :Character ;
    rdfs:label "Ravana" ;
    :description "The ten-necked Rákshas king of Lanká who abducts Sítá through guile and force." ;
    .

:Márícha rdf:type :Character ;
    rdfs:label "Márícha" ;
    :description "A fiend who transforms into a wondrous golden deer to lure Ráma away from Sítá, leading to her abduction." ;
    .

:Jatayu rdf:type :Character ;
    rdfs:label "Jatayu" ;
    :description "The noble vulture king and friend of Dasaratha who dies heroically while attempting to rescue Sítá from RávaG." ;
    .

:Sugriva rdf:type :Character ;
    rdfs:label "Sugriva" ;
    :description "The Vánar king and son of the Sun, exiled by his brother Báli, who forms a sacred alliance with Ráma on Mount Rishyamúka." ;
    .

:Hanuman rdf:type :Character ;
    rdfs:label "Hanuman" ;
    :description "The son of the Wind-God and chief counselor to Sugríva, who approaches Ráma and LakshmaG as an envoy." ;
    .

:Kabandha rdf:type :Character ;
    rdfs:label "Kabandha" ;
    :description "A misshapen, headless giant (formerly the Gandharva Danu) who is released from a curse by Ráma and directs him to seek Sugríva." ;
    .

:Savarí rdf:type :Character ;
    rdfs:label "Savarí" ;
    :description "An aged, pious votaress and pupil of Matanga who waits for Ráma's arrival before ascending to heaven." ;
    .

:Vali rdf:type :Character ;
    rdfs:label "Vali" ;
    :description "The powerful elder brother of Sugríva and son of Indra, who usurped Sugríva's throne and wife." ;
    .

:Dasharatha rdf:type :Character ;
    rdfs:label "Dasharatha" ;
    :description "The deceased King of Ayodhyá and father of Ráma, whose decree sent Ráma into exile." ;
    .

:Brahmá rdf:type :Deity ;
    rdfs:label "Brahmá" ;
    :description "The Eternal Father and Creator who decreed the events leading to the giants' overthrow." ;
    .

:Vayu rdf:type :Deity ;
    rdfs:label "Vayu" ;
    :description "The God of Wind and father of Hanumán." ;
    .

:Lanka rdf:type :Place ;
    rdfs:label "Lanka" ;
    :description "The magnificent island city and fortress of RávaG, surrounded by the ocean." ;
    .

:Rishyamuka rdf:type :Place ;
    rdfs:label "Rishyamuka" ;
    :description "The mountain where Sugríva and his ministers hide from Báli and where the alliance with Ráma is formed." ;
    .

:Pampa rdf:type :Place ;
    rdfs:label "Pampa" ;
    :description "A beautiful lake and brook where Ráma laments for Sítá and encounters Sugríva's envoy." ;
    .

:Janasthán rdf:type :Place ;
    rdfs:label "Janasthán" ;
    :description "The forest region where Ráma dwelt in exile and where he slew the giant Khara and his host." ;
    .

:Matanga's_Wood rdf:type :Place ;
    rdfs:label "Matanga's Wood" ;
    :description "A sacred grove once inhabited by Saint Matanga and his pupils, where Savarí maintains her hermitage." ;
    .

:The_League rdf:type :Event ;
    rdfs:label "The League" ;
    :description "The formal alliance between Ráma and Sugríva, witnessed by the sacred fire." ;
    .

:Ramayana rdf:type :Text ;
    rdfs:label "Ramayana" ;
    :description "The epic narrative detailing the life and adventures of Ráma." ;
    .

:King_Dasaratha rdf:type :Character ;
    rdfs:label "King Dasaratha" ;
    :description "Monarch of Ayodhya and father of Rama, Bharat, Lakshmana, and Shatrughna." ;
    :state "Grief-stricken by the exile of his son" ;
    .

:King_Janaka rdf:type :Character ;
    rdfs:label "King Janaka" ;
    :description "Ruler of Mithila and father of Sita and Urmila." ;
    :legacy "Guardian of the Great Bow of Rudra" ;
    .

:Kaikeyi rdf:type :Character ;
    rdfs:label "Kaikeyi" ;
    :description "Dasaratha's youngest queen who demands Rama's exile and Bharat's throning." ;
    :motivation "Securing her son's future at the urging of Manthara" ;
    .

:Manthara rdf:type :Character ;
    rdfs:label "Manthara" ;
    :description "A hump-backed slave-born handmaid who plots against Rama." ;
    .

:Parashurama rdf:type :Character ;
    rdfs:label "Parashurama" ;
    :description "The 'Rama with the Axe' who challenges Rama and is eventually debarred from heavenly worlds." ;
    :lineage "Son of Jamadagni" ;
    .

:Rudra rdf:type :Deity ;
    rdfs:label "Rudra" ;
    :description "Also known as Shiva, the bearer of the bow broken by Rama at Mithila." ;
    .

:Fate rdf:type :Concept ;
    rdfs:label "Fate" ;
    :description "The resistless power described by Rama as the reason for his sudden change in fortune." ;
    .

:Ayodhya rdf:type :Place ;
    rdfs:label "Ayodhya" ;
    :description "The capital of the Ikshvaku dynasty." ;
    .

:Dandaka_Forest rdf:type :Place ;
    rdfs:label "Dandaka Forest" ;
    :description "The wild forest where Rama is sentenced to spend 14 years in exile." ;
    .

:Breaking_of_the_Bow rdf:type :Event ;
    rdfs:label "Breaking of the Bow" ;
    :description "Rama strings and snaps the celestial bow of Shiva, winning Sita's hand." ;
    .

:The_Two_Boons rdf:type :Event ;
    rdfs:label "The Two Boons" ;
    :description "Kaikeyi's demand for Bharat's kingship and Rama's 14-year banishment." ;
    .

:Dyaus rdf:type :Deity ;
    rdfs:label "Dyaus" ;
    :description "The sky father deity, oldest deity of the Vedic pantheon." ;
    .

:Yajurveda rdf:type :Text ;
    rdfs:label "Yajurveda" ;
    :description "The Veda of prose mantras and ritual formulas." ;
    .

:Atharvaveda rdf:type :Text ;
    rdfs:label "Atharvaveda" ;
    :description "The Veda of spells, charms, and everyday procedures." ;
    .

:Satyavati rdf:type :Character ;
    rdfs:label "Satyavati" ;
    :description "Matriarch of the Kuru dynasty, wife of King Shantanu, mother of Vyasa." ;
    .

:Ashwatthama rdf:type :Character ;
    rdfs:label "Ashwatthama" ;
    :description "Son of Dronacharya, powerful warrior and survivor of the Kurukshetra War." ;
    .

:Bhagavad_Gita rdf:type :Text ;
    rdfs:label "Bhagavad Gita" ;
    :description "The sacred dialogue spoken by Krishna to Arjuna before the Kurukshetra War." ;
    .

:Sati rdf:type :Deity ;
    rdfs:label "Sati" ;
    :description "First consort of Shiva, who self-immolated at her father Daksha's sacrifice." ;
    .

:Veerabhadra rdf:type :Deity ;
    rdfs:label "Veerabhadra" ;
    :description "A fierce manifestation of Shiva created to destroy Daksha's sacrifice." ;
    .

:Bhairava rdf:type :Deity ;
    rdfs:label "Bhairava" ;
    :description "A terrifying manifestation of Shiva associated with destruction and protection." ;
    .

:Markandeya rdf:type :Character ;
    rdfs:label "Markandeya" ;
    :description "Sage blessed with eternal youth, saved from Yama by Shiva." ;
    .

:Mount_Kailash rdf:type :Place ;
    rdfs:label "Mount Kailash" ;
    :description "The sacred mountain home of Lord Shiva." ;
    .

:Lokas rdf:type :Concept ;
    rdfs:label "Lokas" ;
    :description "The fourteen cosmic realms of the universe." ;
    .

:Yugas rdf:type :Concept ;
    rdfs:label "Yugas" ;
    :description "The four cosmic eras: Satya, Treta, Dvapara, and Kali." ;
    .

:Srishti rdf:type :Event ;
    rdfs:label "Srishti" ;
    :description "The creation of the universe by Brahma." ;
    .

:Pralaya rdf:type :Event ;
    rdfs:label "Pralaya" ;
    :description "The dissolution of the cosmos." ;
    .

:Samudra_Manthan rdf:type :Event ;
    rdfs:label "Samudra Manthan" ;
    :description "The churning of the cosmic ocean to obtain Amrita (nectar of immortality)." ;
    .

:Daksha_Yajna rdf:type :Event ;
    rdfs:label "Daksha Yajna" ;
    :description "The sacrificial ritual hosted by Daksha that ended in destruction." ;
    .

:Puranas rdf:type :Text ;
    rdfs:label "Puranas" ;
    :description "Genre of eighteen major sacred texts detailing cosmology, genealogies, and myths." ;
    .

:King_Daśaratha rdf:type :Character ;
    rdfs:label "King Daśaratha" ;
    :description "The deceased King of Ayodhyá, father of Ráma, Bharat, LakshmaG, and Śatrughna. He died of a broken heart following Ráma's exile." ;
    .

:Kauśalyá rdf:type :Character ;
    rdfs:label "Kauśalyá" ;
    :description "The chief queen of King Daśaratha and mother of Ráma. She is depicted as a prostrate, lustreless star in her grief." ;
    .

:Sumitra rdf:type :Character ;
    rdfs:label "Sumitra" ;
    :description "A queen of Daśaratha and mother of LakshmaG and Śatrughna." ;
    .

:Bharat rdf:type :Character ;
    rdfs:label "Bharat" ;
    :description "The son of Kaikeyí, staying in Rájagriha with his maternal grandfather during the king's death." ;
    .

:Vaśishmha rdf:type :Character ;
    rdfs:label "Vaśishmha" ;
    :description "The chief household priest who manages the transition of power and sends envoys to fetch Bharat." ;
    .

:Aśvapati rdf:type :Character ;
    rdfs:label "Aśvapati" ;
    :description "The King of Kekaya and Bharat's maternal grandfather." ;
    .

:Rájagriha rdf:type :Place ;
    rdfs:label "Rájagriha" ;
    :description "Also called Girivraja, the capital of Kekaya where Bharat and Śatrughna were residing." ;
    .

:Kingless_Land rdf:type :Concept ;
    rdfs:label "Kingless Land" ;
    :description "A state of anarchy where no law is known, the strong prey on the weak like fish, and religious/social order collapses." ;
    .

:Bharat's_Dream rdf:type :Event ;
    rdfs:label "Bharat's Dream" ;
    :description "A prophetic nightmare where Bharat saw his father falling into a lake of mire, drinking oil, and heading south in an ass-drawn chariot." ;
    .

:Embalming_of_Daśaratha rdf:type :Event ;
    rdfs:label "Embalming of Daśaratha" ;
    :description "The process of preserving the king's body in a cask of oil until Bharat's return." ;
    .

:Tá_aká rdf:type :Character ;
    rdfs:label "Tá aká" ;
    :description "A spirit possessing the strength of a thousand elephants, cursed to be a man-eating monster." ;
    .

:VishGu rdf:type :Deity ;
    rdfs:label "VishGu" ;
    :description "The Supreme Lord who took the form of a Dwarf to defeat King Bali." ;
    .

:Agastya rdf:type :Character ;
    rdfs:label "Agastya" ;
    :description "A celebrated saint who cursed Tá aká and Márícha." ;
    .

:Sarayu rdf:type :Place ;
    rdfs:label "Sarayu" ;
    :description "A holy river born from Brahmá's will, flowing from Lake Mánas." ;
    .

:Perfect_Hermitage rdf:type :Place ;
    rdfs:label "Perfect Hermitage" ;
    :description "Also known as Siddháshrama; the site of VishGu's penance and Vi[vámitra's sacrifice." ;
    .

:Mánas rdf:type :Place ;
    rdfs:label "Mánas" ;
    :description "The sacred, mind-born lake of Brahmá located near Mount Kailása." ;
    .

:Game_of_Dice rdf:type :Event ;
    rdfs:label "Game of Dice" ;
    :description "The gambling match between Yudhishthira and Shakuni which led to the exile." ;
    .

:King_Da[aratha rdf:type :Character ;
    rdfs:label "King Da[aratha" ;
    :description "The childless monarch of Ayodhyá who decrees a great sacrifice to obtain sons." ;
    .

:Rishya[ring rdf:type :Character ;
    rdfs:label "Rishya[ring" ;
    :description "The holy hermit and son of VibháGdak who guides the specific sacrificial forms of the Ashvamedha." ;
    .

:Kausalya rdf:type :Character ;
    rdfs:label "Kausalya" ;
    :description "The chief queen of Da[aratha who participates in the rites, including the symbolic slaying of the steed." ;
    .

:Mithila rdf:type :Place ;
    rdfs:label "Mithila" ;
    :description "The kingdom ruled by King Janak, an old ally of Da[aratha." ;
    .

:Ashvamedha rdf:type :Event ;
    rdfs:label "Ashvamedha" ;
    :description "The Sacrifice of the Steed, involving 21 sacrificial stakes and 300 victims to ensure the king's sovereignty and offspring." ;
    .

:Putrakama_Yajna rdf:type :Event ;
    rdfs:label "Putrakama Yajna" ;
    :description "The second rite begun by Rishya[ring using Atharva texts specifically to win sons for the king." ;
    .

:Vedas rdf:type :Text ;
    rdfs:label "Vedas" ;
    :description "The sacred scriptures (including Rig, Yajur, Sama, and Atharva) that govern the ritual laws." ;
    .

:Janaka rdf:type :Character ;
    rdfs:label "Janaka" ;
    :description "The King of Míthilá and ally invited to the sacrifice." ;
    .

:Lomapád rdf:type :Character ;
    rdfs:label "Lomapád" ;
    :description "The King of the Angas invited to participate in the gathering." ;
    .

:Bharadvája rdf:type :Character ;
    rdfs:label "Bharadvája" ;
    :description "A high-souled hermit residing at Prayág near the confluence of the Gangá and Yamuná." ;
    .

:Kálindí rdf:type :Deity ;
    rdfs:label "Kálindí" ;
    :description "Another name for the river Yamuná, personified as the Sun-born Goddess." ;
    .

:Chitrakuta rdf:type :Place ;
    rdfs:label "Chitrakuta" ;
    :description "A holy mountain with varied peaks, located ten leagues from Prayág, chosen as Ráma's forest home." ;
    .

:Prayág rdf:type :Place ;
    rdfs:label "Prayág" ;
    :description "The sacred confluence where the Yamuná and Gangá rivers meet." ;
    .

:Banishment rdf:type :Event ;
    rdfs:label "Banishment" ;
    :duration "14 years" ;
    :description "The forced exile of Ráma from Ayodhyá due to Kaikeyí's wish." ;
    .

:Scripture rdf:type :Text ;
    rdfs:label "Scripture" ;
    :description "The sacred Hindu texts (Vedas) prescribing religious rites and social duties." ;
    .

:SutíkshGa rdf:type :Character ;
    rdfs:label "SutíkshGa" ;
    :description "A virtuous sage whose hermitage Ráma visits and who directs Ráma to Agastya." ;
    .

:Dharmabhrit rdf:type :Character ;
    rdfs:label "Dharmabhrit" ;
    :description "A hermit who follows Ráma and explains the mystery of the Panchápsaras lake." ;
    .

:MáG_akarGi rdf:type :Character ;
    rdfs:label "MáG akarGi" ;
    :description "A great votary who created the Panchápsaras lake through his rites and was seduced by five nymphs." ;
    .

:Agastya's_Brother rdf:type :Character ;
    rdfs:label "Agastya's Brother" ;
    :description "A holy hermit living south of SutíkshGa’s retreat, whose home Ráma visits first." ;
    .

:Vátápi rdf:type :Character ;
    rdfs:label "Vátápi" ;
    :description "A demon who took the form of a ram to kill Bráhmans, eventually devoured and destroyed by Agastya." ;
    .

:Ilval rdf:type :Character ;
    rdfs:label "Ilval" ;
    :description "A fierce demon who spoke Sanskrit to trick Bráhmans; he was consumed to dust by Agastya's glance." ;
    .

:Mahendra rdf:type :Deity ;
    rdfs:label "Mahendra" ;
    :description "The Lord divine (Indra) who provided Ráma with a sunbright shaft and an endless quiver." ;
    .

:Panchápsaras rdf:type :Place ;
    rdfs:label "Panchápsaras" ;
    :description "The 'Lake of the Five Nymphs,' created by MáG akarGi, featuring a hidden palace beneath the waters." ;
    .

:Vindhya rdf:type :Place ;
    rdfs:label "Vindhya" ;
    :description "The 'best of hills' that bowed its crest at Agastya's command to allow the sun's journey." ;
    .

:Bráhmans rdf:type :Character ;
    rdfs:label "Bráhmans" ;
    :description "The saintly crowd and hermits of the wood who sought Ráma's protection from fiends." ;
    .

:Rákshas rdf:type :Concept ;
    rdfs:label "Rákshas" ;
    :description "Fiends or giants of the wood who torment hermits and devour bleeding flesh." ;
    .

:Ambarísha rdf:type :Character ;
    rdfs:label "Ambarísha" ;
    :description "A king of the Ikshváku line who sought a human victim for his sacrifice." ;
    .

:Zunah[epha rdf:type :Character ;
    rdfs:label "Zunah[epha" ;
    :description "The middle son of Richíka who sold himself as a sacrificial victim and was saved by Vi[vámitra's hymns." ;
    .

:Pushkar rdf:type :Place ;
    rdfs:label "Pushkar" ;
    :description "A sacred lake where Vi[vámitra performed his austerities and met Zunah[epha." ;
    .

:Brahmanhood rdf:type :Concept ;
    rdfs:label "Brahmanhood" ;
    :description "The highest spiritual rank sought by Vi[vámitra, requiring total control over rage and desire." ;
    .

:Guha rdf:type :Character ;
    rdfs:label "Guha" ;
    :description "King of the Nishádas and Ráma's ally; he assists Bharat in locating Ráma's hermitage." ;
    .

:Mandákiní rdf:type :Place ;
    rdfs:label "Mandákiní" ;
    :description "The holy river flowing near the Chitrakúma mountain." ;
    .

:Funeral_Libation rdf:type :Event ;
    rdfs:label "Funeral Libation" ;
    :description "The ritual offering of water for the deceased King Daśaratha." ;
    .

:Válmíki rdf:type :Character ;
    rdfs:label "Válmíki" ;
    :description "The 'First of Bards' and author of the Rámáyan; a holy hermit and saint who receives the story from Nárad." ;
    .

:Nárad rdf:type :Deity ;
    rdfs:label "Nárad" ;
    :description "A divine saint and son of Brahmá, known as the eloquent messenger of the Gods and inventor of the víGá." ;
    .

:Rámáyan rdf:type :Text ;
    rdfs:label "Rámáyan" ;
    :description "The sacred epic poem that tells the deeds of Ráma, intended to free the world from sin." ;
    .

:Golden_Age rdf:type :Concept ;
    rdfs:label "Golden Age" ;
    :description "Also known as Krita Yuga; a period of truth and perfection that returned during Ráma's reign." ;
    .

:Atman rdf:type :Concept ;
    rdfs:label "Atman" ;
    :description "The individual soul or self, which is immortal and distinct from the body." ;
    .

:Brahman rdf:type :Concept ;
    rdfs:label "Brahman" ;
    :description "The ultimate impersonal reality or supreme cosmic spirit." ;
    .

:Jnana_Yoga rdf:type :Concept ;
    rdfs:label "Jnana Yoga" ;
    :description "The spiritual path of knowledge and discrimination between the real and unreal." ;
    .

:Gunas rdf:type :Concept ;
    rdfs:label "Gunas" ;
    :description "The three qualities of nature: Sattva (purity), Rajas (activity), and Tamas (inertia)." ;
    .

:Svadharma rdf:type :Concept ;
    rdfs:label "Svadharma" ;
    :description "Personal duty or right action aligned with one's nature and social position." ;
    .

:Bhakti_Yoga rdf:type :Concept ;
    rdfs:label "Bhakti Yoga" ;
    :description "The spiritual path of love, devotion, and surrender to the Supreme Lord." ;
    .

:Samsara rdf:type :Concept ;
    rdfs:label "Samsara" ;
    :description "The cycle of birth, death, and rebirth." ;
    .

:Nishkama_Karma rdf:type :Concept ;
    rdfs:label "Nishkama Karma" ;
    :description "Selfless or desireless action performed as an offering to the Divine." ;
    .

:Karma_Yoga rdf:type :Concept ;
    rdfs:label "Karma Yoga" ;
    :description "The spiritual path of action performed without attachment to results." ;
    .

:Shatrughna rdf:type :Character ;
    rdfs:label "Shatrughna" ;
    :description "The younger brother of Ráma and Bharat, who accompanies Bharat on the journey to the forest." ;
    .

:Sumantra rdf:type :Character ;
    rdfs:label "Sumantra" ;
    :description "The royal charioteer and counselor who manages the logistics of the march." ;
    .

:Śringavera rdf:type :Place ;
    rdfs:label "Śringavera" ;
    :description "The town on the banks of the Gangá ruled by King Guha." ;
    .

:Viṣṇu rdf:type :Deity ;
    rdfs:label "Viṣṇu" ;
    :description "The supreme deity mentioned in the context of his triple step in the Vamana (dwarf) avatar." ;
    .

:Daṇḍak_Wood rdf:type :Place ;
    rdfs:label "Daṇḍak Wood" ;
    :description "The wild and vast forest where Ráma must spend his fourteen years of exile." ;
    .

:Banishment_of_Ráma rdf:type :Event ;
    rdfs:label "Banishment of Ráma" ;
    :duration "14 years" ;
    :cause "Boons given to Queen Kaikeyí" ;
    .

:Amrit rdf:type :Concept ;
    rdfs:label "Amrit" ;
    :description "The nectar of immortality mentioned in the context of the struggle between Gods and Daityas." ;
    .

:Vritra rdf:type :Character ;
    rdfs:label "Vritra" ;
    :description "A demon slain by Indra, mentioned to symbolize the victory of good over evil." ;
    .

:Sanjaya rdf:type :Character ;
    rdfs:label "Sanjaya" ;
    :description "Charioteer and advisor to Dhritarashtra, endowed with divine vision to narrate the war." ;
    .

:Vishwarupa rdf:type :Concept ;
    rdfs:label "Vishwarupa" ;
    :description "The cosmic form of Lord Krishna containing the entire universe revealed to Arjuna." ;
    .

:Yayáti rdf:type :Character ;
    rdfs:label "Yayáti" ;
    :description "An ancient king whose fall from heaven is used as a metaphor for Da[aratha's distress." ;
    .

:Truth rdf:type :Concept ;
    rdfs:label "Truth" ;
    :description "The supreme duty and religious foundation cited by Kaikeyí to bind the king." ;
    .

:Pushya rdf:type :Concept ;
    rdfs:label "Pushya" ;
    :description "The auspicious planetary hour and lunar sign for the intended consecration." ;
    .

:Anasuya rdf:type :Character ;
    rdfs:label "Anasuya" ;
    :description "The aged, saintly wife of Atri who performed ten thousand years of penance and gifted Sítá celestial cosmetics and robes." ;
    .

:Atri rdf:type :Character ;
    rdfs:label "Atri" ;
    :description "A high-souled hermit whose hermitage Ráma visits after leaving Chitrakúta." ;
    .

:Khara rdf:type :Character ;
    rdfs:label "Khara" ;
    :description "A giant demon and brother of RávaG who dwells in Janasthán and harasses the hermits." ;
    .

:Nandigrám rdf:type :Place ;
    rdfs:label "Nandigrám" ;
    :description "The town where Bharat establishes his seat of government to avoid ruling from the capital." ;
    .

:Sacred_Sandals rdf:type :Concept ;
    rdfs:label "Sacred Sandals" ;
    :description "Gold-wrought emblems of Ráma's authority, placed on the throne by Bharat." ;
    .

:Consecration_of_Ráma rdf:type :Event ;
    rdfs:label "Consecration of Ráma" ;
    :description "The planned ceremony to install Ráma as the Regent Heir to the throne of Ayodhyá." ;
    .

:Kshetra rdf:type :Concept ;
    rdfs:label "Kshetra" ;
    :description "The field of experience, referring to the material body and mind." ;
    .

:Kshetrajna rdf:type :Concept ;
    rdfs:label "Kshetrajna" ;
    :description "The knower of the field, representing the soul or conscious witness." ;
    .

:Aswattha rdf:type :Concept ;
    rdfs:label "Aswattha" ;
    :description "The inverted cosmic banyan tree representing material manifestation in Chapter 15." ;
    .

:Avatara rdf:type :Concept ;
    rdfs:label "Avatara" ;
    :description "Divine descent or incarnation of God on earth to restore dharma." ;
    .

:Dushasana rdf:type :Character ;
    rdfs:label "Dushasana" ;
    :description "Second Kaurava prince, loyal helper of Duryodhana who insulted Draupadi." ;
    .

:Gandhari rdf:type :Character ;
    rdfs:label "Gandhari" ;
    :description "Queen consort of Dhritarashtra, who blindfolded herself out of devotion to her husband." ;
    .

:Kunti rdf:type :Character ;
    rdfs:label "Kunti" ;
    :description "Mother of the three elder Pandavas and Karna, queen of Pandu." ;
    .

:Veda_Vyasa rdf:type :Character ;
    rdfs:label "Veda Vyasa" ;
    :description "The sage composer of the Mahabharata, father of Pandu and Dhritarashtra." ;
    .

:Krishna's_Peace_Embassy rdf:type :Event ;
    rdfs:label "Krishna's Peace Embassy" ;
    :description "Krishna's mission to Hastinapura to negotiate a peaceful settlement, rejected by Duryodhana." ;
    .

:Prasthana_Trayi rdf:type :Concept ;
    rdfs:label "Prasthana Trayi" ;
    :description "The three scriptural pillars of Vedanta: Upanishads, Brahma Sutras, and Bhagavad Gita." ;
    .

:Upanishads rdf:type :Text ;
    rdfs:label "Upanishads" ;
    :description "The philosophical texts concluding the Vedas (Vedanta), focusing on Atman and Brahman." ;
    .

:Ráma's_Departure rdf:type :Event ;
    rdfs:label "Ráma's Departure" ;
    :description "The momentous exit of Ráma, Sítá, and LakshmaG from Ayodhyá, marked by cosmic omens and city-wide mourning." ;
    .

:Bhagírath rdf:type :Character ;
    rdfs:label "Bhagírath" ;
    :description "The royal saint whose penance brought the river Gangá from heaven to earth to liberate the sons of Sagar." ;
    .

:Ziva rdf:type :Deity ;
    rdfs:label "Ziva" ;
    :description "The deity who received Gangá on his head and quaffed the Halahala poison during the churning of the sea." ;
    .

:Jahnu rdf:type :Character ;
    rdfs:label "Jahnu" ;
    :description "A saint who drank the Gangá in anger but later released her through his ears, becoming her symbolic father." ;
    .

:Sagara rdf:type :Character ;
    rdfs:label "Sagara" ;
    :description "The ancient king whose sixty thousand sons were reduced to ashes and later liberated by Gangá's water." ;
    .

:Diti rdf:type :Character ;
    rdfs:label "Diti" ;
    :description "Wife of Ka[yap and mother of the Titans who performed penance to birth a son capable of slaying Indra." ;
    .

:Aditi rdf:type :Character ;
    rdfs:label "Aditi" ;
    :description "Wife of Ka[yap and mother of the Gods (Suras)." ;
    .

:Ahalya rdf:type :Character ;
    rdfs:label "Ahalya" ;
    :description "The wife of Gautam who was cursed to remain invisible and subsist on air until Ráma's arrival." ;
    .

:Gautama rdf:type :Character ;
    rdfs:label "Gautama" ;
    :description "A powerful ascetic who cursed both Indra and his wife Ahalyá for their betrayal." ;
    .

:Vi[álá rdf:type :Place ;
    rdfs:label "Vi[álá" ;
    :description "A beautiful city built by King Vi[ála, compared to heaven itself." ;
    .

:Milky_Sea rdf:type :Place ;
    rdfs:label "Milky Sea" ;
    :description "The cosmic ocean churned by Gods and Titans to obtain the Amrit." ;
    .

