    :description "Válmíki composes entire epic using meditation and divine sight" ;
    .

:Ráma's_exile rdf:type :Event ;
    rdfs:label "Ráma's exile" ;
    :description "Ráma banished from Ayodhyá due to Kaikeyí's counsel" ;
    .

:Sítá's_abduction rdf:type :Event ;
    rdfs:label "Sítá's abduction" ;
    :description "Rávana abducts Sítá from forest" ;
    .

:Battle_with_Rávana rdf:type :Event ;
    rdfs:label "Battle with Rávana" ;
    :description "War in Lanká resulting in Rávana's death" ;
    .

:Bridge_construction rdf:type :Event ;
    rdfs:label "Bridge construction" ;
    :description "Nala builds bridge across ocean to Lanká" ;
    .

:Burning_of_Lanká rdf:type :Event ;
    rdfs:label "Burning of Lanká" ;
    :description "Hanumán sets fire to Lanká" ;
    .

:Ráma's_coronation rdf:type :Event ;
    rdfs:label "Ráma's coronation" ;
    :description "Ráma ordained as king after return" ;
    .

:Sítá's_repudiation rdf:type :Event ;
    rdfs:label "Sítá's repudiation" ;
    :description "Ráma casts away his queen Sítá" ;
    .

:Recitation_before_Ráma rdf:type :Event ;
    rdfs:label "Recitation before Ráma" ;
    :description "Kuśa and Lava sing Rámáyan before King Ráma" ;
    .

:Breaking_of_bow rdf:type :Event ;
    rdfs:label "Breaking of bow" ;
    :description "Ráma wins Sítá by breaking bow that bent to none" ;
    .

:Death_of_Dasharatha rdf:type :Event ;
    rdfs:label "Death of Dasharatha" ;
    :description "King dies grieving after Ráma's banishment" ;
    .

:Friendship_with_Sugríva rdf:type :Event ;
    rdfs:label "Friendship with Sugríva" ;
    :description "Ráma and Sugríva make treaty and friendship" ;
    .

:Slaying_of_Báli rdf:type :Event ;
    rdfs:label "Slaying of Báli" ;
    :description "Ráma kills Báli in fight with Sugríva" ;
    .

:Hanumán's_leap rdf:type :Event ;
    rdfs:label "Hanumán's leap" ;
    :description "Hanumán leaps across ocean to Lanká" ;
    .

:Discovery_of_Sítá rdf:type :Event ;
    rdfs:label "Discovery of Sítá" ;
    :description "Hanumán finds Sítá in Aśoka garden" ;
    .

:Gods/Blessed_Gods rdf:type :Deity ;
    rdfs:label "Gods/Blessed Gods" ;
    :description "Ne'er refuse to eat food their children use, with whom Dasharatha enrolled on high, pure as Gods" ;
    .

:Brihaspati/Heavenly_Teacher rdf:type :Deity ;
    rdfs:label "Brihaspati/Heavenly Teacher" ;
    :description "Preceptor of the Gods whose feet Indra clasps in realms above" ;
    .

:Garuda/Tárkshya rdf:type :Deity ;
    rdfs:label "Garuda/Tárkshya" ;
    :description "King of birds with whom other birds cannot vie" ;
    .

:Gods_of_Storm rdf:type :Deity ;
    rdfs:label "Gods of Storm" ;
    :description "Deities by whom imperial Indra is girt, comparison to king's might" ;
    .

:Jáváli rdf:type :Character ;
    rdfs:label "Jáváli" ;
    :description "Virtuous chief of twice-born sages, replied in words that virtue's law defied" ;
    .

:Royal_widows rdf:type :Character ;
    rdfs:label "Royal widows" ;
    :description "Ladies placed in line by Vasishtha, moving faint and slow, mournful queens" ;
    .

:Counselors_and_peers rdf:type :Character ;
    rdfs:label "Counselors and peers" ;
    :description "Nobles, each counselor and peer sat humbly behind, pressed around, priests and lords of state" ;
    .

:Citizens_and_captains rdf:type :Character ;
    rdfs:label "Citizens and captains" ;
    :description "People, youthful captains, crowd whose cheeks were wet, multitude with longing moved" ;
    .

:Hump_back rdf:type :Character ;
    rdfs:label "Hump-back" ;
    :description "Person loaded with curses deep and loud by crowd" ;
    .

:Gayá rdf:type :Place ;
    rdfs:label "Gayá" ;
    :description "Holy town in Behar where funeral offerings made, every good Hindu ought make offerings to ancestors" ;
    .

:River/stream rdf:type :Place ;
    rdfs:label "River/stream" ;
    :description "Holy side, lovely stream ever blossomed crowned, fair descent, pure pellucid shallow, shore, bank's descent" ;
    .

:Ráma's_hermitage/cottage rdf:type :Place ;
    rdfs:label "Ráma's hermitage/cottage" ;
    :description "Door gained, sacrificial ground, where hero met ladies' eyes, dwelling" ;
    .

:Mountain rdf:type :Place ;
    rdfs:label "Mountain" ;
    :description "Pleasant side, lovely lawns, rolled echoing sound like roar of lions" ;
    .

:Dandaka/DaG_ak_wood rdf:type :Place ;
    rdfs:label "Dandaka/DaG ak wood" ;
    :description "Mighty wilderness, wild forest, lonely wood, silvan world, wild domain, woods for devotee" ;
    .

:Put rdf:type :Place ;
    rdfs:label "Put" ;
    :description "Region of hell, infernal pains, to which men doomed who leave no son for funeral rites" ;
    .

:Ocean/sea rdf:type :Place ;
    rdfs:label "Ocean/sea" ;
    :description "For which Yamuná yearns, king ruled earth from sea to sea, boundless main" ;
    .

:Yamuná rdf:type :Place ;
    rdfs:label "Yamuná" ;
    :description "River that yearns for Ocean, impetuous waters flee" ;
    .

:Funeral_libation rdf:type :Concept ;
    rdfs:label "Funeral libation" ;
    :description "Due offerings to parting shade, sacred water to spirits, drops duly shed, tribute to father's shade, offering which shall aye endure" ;
    .

:Ingudí_offering rdf:type :Concept ;
    rdfs:label "Ingudí offering" ;
    :description "Pressed fruit, fresh bark mantle, seed mixed with jujube, cake offered on sacred grass, points laid directed to southern sky, humble gift" ;
    .

:Funereal_procession_order rdf:type :Concept ;
    rdfs:label "Funereal procession order" ;
    :description "Children precede by age, then women, then men youngest first eldest last, reversed descending into water" ;
    .

:Ráma's_grief_philosophy rdf:type :Concept ;
    rdfs:label "Ráma's grief philosophy" ;
    :description "All gathered heaps must waste, death is end of life, all joined apart must fall, ripened fruit must fall, inevitable death, life flies as torrents" ;
    .

:Impermanence_doctrine rdf:type :Concept ;
    rdfs:label "Impermanence doctrine" ;
    :description "Night flies no more returns, days nights pass swiftly, death travels with us, lives decay as seasons smile, drifting logs meet and part" ;
    .

:Bharat's_entreaty rdf:type :Concept ;
    rdfs:label "Bharat's entreaty" ;
    :description "Yield government to Ráma, return to realm, roars of elephants, women rejoice, consecration paramount, four castes justest care" ;
    .

:Sacred_duty_hierarchy rdf:type :Concept ;
    rdfs:label "Sacred duty hierarchy" ;
    :description "Householder order best of four orders: student, householder, anchorite, mendicant, three debts: to Gods men Manes" ;
    .

:Father's_promise rdf:type :Concept ;
    rdfs:label "Father's promise" ;
    :description "King wed Kaikeyí swore best kingdoms, on Gods' and demons' fray gave future boon, promise brought to mind, boons given, word inviolate" ;
    .

:Son's_duty rdf:type :Concept ;
    rdfs:label "Son's duty" ;
    :description "Puttra from Put and tra deliverer, son born to free sire from infernal pains, funeral rites at Gayá, release from pains of hell" ;
    .

:Jáváli's_heresy rdf:type :Concept ;
    rdfs:label "Jáváli's heresy" ;
    :description "Words that virtue's law defied, weak and vain thought, ties of kindred mean nothing, alone babe opens eyes alone dies" ;
    .

:News_of_death rdf:type :Event ;
    rdfs:label "News of death" ;
    :description "Bharat told king is gone, enrolled with Gods on high, mournful news, Sítá knew king's fate, sharp pangs smote" ;
    .

:Funeral_rite_preparation rdf:type :Event ;
    rdfs:label "Funeral rite preparation" ;
    :description "Ráma asked Lakshmana bring Ingudí fruit and bark mantle, Sítá go first, then thou, then I last" ;
    .

:Descent_to_river rdf:type :Event ;
    rdfs:label "Descent to river" ;
    :description "Sumantra and brothers guided Ráma to holy side, heroes found lovely stream, bent in bitter sorrow" ;
    .

:Offering_funeral_drops rdf:type :Event ;
    rdfs:label "Offering funeral drops" ;
    :description "Where stream showed pure shallow, duly shed drops, said 'Father this be thine', Ráma turned to southern side stretched arm weeping" ;
    .

:Mixed_offering_made rdf:type :Event ;
    rdfs:label "Mixed offering made" ;
    :description "Ráma offered fresh tribute with brothers' aid, jujube mixed with Ingudí seed on sacred grass, weeping said enjoy cake" ;
    .

:Return_to_cottage rdf:type :Event ;
    rdfs:label "Return to cottage" ;
    :description "Ráma retraced path up mountain's pleasant side, gained cottage door, strained brothers and Sítá to breast, cry of weeping rose" ;
    .

:Army's_rush rdf:type :Event ;
    rdfs:label "Army's rush" ;
    :description "Army shook with fear hearing weeping, left car and wain, ran toward weeping, earth sent deafening noise, elephants fled in fear" ;
    .

:Meeting_the_multitude rdf:type :Event ;
    rdfs:label "Meeting the multitude" ;
    :description "Chief found on sacrificial ground, crowd loaded curses on hump-back and queen, ran in fond affection, looked on multitude" ;
    .

:Queens'_arrival rdf:type :Event ;
    rdfs:label "Queens' arrival" ;
    :description "Vasishtha placed royal widows in line, ladies saw stream, saw bank's descent, saw funeral offering, came to hermitage" ;
    .

:Meeting_the_queens rdf:type :Event ;
    rdfs:label "Meeting the queens" ;
    :description "Hero met their eyes like God fallen from skies, clasped lotus feet, brushed dust, Lakshmana paid reverence, Sítá bent before widows" ;
    .

:Vasishtha_honored rdf:type :Event ;
    rdfs:label "Vasishtha honored" ;
    :description "Ráma pressed saint's feet with reverential love, took seat near him as Indra clasps Heavenly Teacher's feet" ;
    .

:Assembly_gathered rdf:type :Event ;
    rdfs:label "Assembly gathered" ;
    :description "Bharat with counselors, peers, citizens, captains sat humbly behind, nobles pressed round, like three fires with holy priests" ;
    .

:Bharat's_first_speech rdf:type :Event ;
    rdfs:label "Bharat's first speech" ;
    :description "Mother made content, government given to Bharat, now yield to thee, people long to see lord restored, roars of elephants" ;
    .

:Ráma's_philosophy_speech rdf:type :Event ;
    rdfs:label "Ráma's philosophy speech" ;
    :description "Ráma consoled lamenting prince: mortal still, fate's slave, death inevitable, grief for father useless, virtue wins bliss, keep father's decree" ;
    .

:Bharat's_supplication rdf:type :Event ;
    rdfs:label "Bharat's supplication" ;
    :description "Good Bharat replied: pardon mother's sin, dismiss trespass, preserve us all, consecration paramount, take royal might, I pray with head bent low" ;
    .

:Ráma's_refusal rdf:type :Event ;
    rdfs:label "Ráma's refusal" ;
    :description "Ráma inexorable still, would keep sire's decree, firmness moved people, bent heads then weeping, queens filled with joy as Bharat prayed" ;
    .

:Ráma's_counter_speech rdf:type :Event ;
    rdfs:label "Ráma's counter-speech" ;
    :description "Ráma replied: father swore kingdoms to Kaikeyí, gave boons, bade me to forest, I keep father's word, thou maintain word inviolate" ;
    .

:Division_of_domains rdf:type :Event ;
    rdfs:label "Division of domains" ;
    :description "Bharat lord of men reign over Ayodhyá, Ráma king of wild domain, white umbrella over Bharat, Ráma to shadow of bough" ;
    .

:Jáváli's_intervention rdf:type :Event ;
    rdfs:label "Jáváli's intervention" ;
    :description "Virtuous Jáváli chief of sages replied in words that defied virtue's law: ties of kindred mean nothing, alone babe opens eyes alone dies" ;
    .

:Soma/Moon_God rdf:type :Deity ;
    rdfs:label "Soma/Moon-God" ;
    :description "Deity in evening air, special deity of Bráhmans, Ráma fair as Soma" ;
    .

:Yama/Him_who_rules_the_dead rdf:type :Deity ;
    rdfs:label "Yama/Him who rules the dead" ;
    :description "Death-God, grisly King when stricken worlds perishing, dark God who rules dead, Kálántaka destroyer" ;
    .

:Kuvera rdf:type :Deity ;
    rdfs:label "Kuvera" ;
    :description "Lord of wealth, stern decree cursed Tumburu, angry God whose wrath fell on Tumburu for loving Rambhá" ;
    .

:Suparna/King_of_birds rdf:type :Deity ;
    rdfs:label "Suparna/King of birds" ;
    :description "Bird deity arrows left behind, winged being" ;
    .

:Urmilá rdf:type :Character ;
    rdfs:label "Urmilá" ;
    :description "Sister next to Sítá, graced with all gifts, most fair to see, given to be Lakshmana's bride" ;
    .

:Hermit_band rdf:type :Character ;
    rdfs:label "Hermit band" ;
    :description "Saints with pitchers, fresh from bath, locks wet, bark coats dripping, tend worship fires, pure dwellers in shade" ;
    .

:Mighty_saints rdf:type :Character ;
    rdfs:label "Mighty saints" ;
    :description "Endued with keen celestial sight, viewed chieftain with joy, came to meet prince, blessed guests, duty-loving, pure, old reverend sires bright as sun" ;
    .

:Sharabhanga rdf:type :Character ;
    rdfs:label "Sharabhanga" ;
    :description "Holy hermit, very sun is not more bright, most glorious anchorite, cot stands league beyond, blessings to earn" ;
    .

:Tumburu rdf:type :Character ;
    rdfs:label "Tumburu" ;
    :description "Celestial minstrel, renowned among minstrel throng for song, cursed by Kuvera for loving Rambhá, wore hideous shape as Virádha, freed by Ráma's favor, spirit fled to heaven" ;
    .

:Rambhá rdf:type :Character ;
    rdfs:label "Rambhá" ;
    :description "Celestial temptress, Apsaras whose charms Tumburu loved too well, caused Kuvera's curse" ;
    .

:Apsarases rdf:type :Character ;
    rdfs:label "Apsarases" ;
    :description "Heavenly nymphs, gay dancers beneath well-loved trees" ;
    .

:Hermitage/settlement rdf:type :Place ;
    rdfs:label "Hermitage/settlement" ;
    :description "Circle where saints abode, court well-swept bright and fair, delightful grove like Brahmá's sphere, coats of bark hung, holy grass bestrewed, wild creatures refuge, birds roedeer dwelling, sheds where holy fire fed, cot with leaves overhead" ;
    .

:Night_sky rdf:type :Place ;
    rdfs:label "Night sky" ;
    :description "O'er all sky is spread, with lunar stars engarlanded, moon risen in robes of light beautifully bright" ;
    .

:Distant_forest rdf:type :Place ;
    rdfs:label "Distant forest" ;
    :description "Where monsters fierce and fell dwell, savage beasts of fearful power, pathless forests far away" ;
    .

:Heaven/sky rdf:type :Place ;
    rdfs:label "Heaven/sky" ;
    :description "Where Virádha's spirit fled, homes eternal in skies, Brahmá's glorious sphere" ;
    .

:Maiden's_Choice/Svayamvara rdf:type :Concept ;
    rdfs:label "Maiden's Choice/Svayamvara" ;
    :description "Unparalleled ceremony held by King Janak, how Ráma won Sítá's maiden hand" ;
    .

:Night_worship rdf:type :Concept ;
    rdfs:label "Night worship" ;
    :description "Sun sunk from sight, world left to holy Night, hermits return with pitchers, fires of worship tended, curling wreaths of smoke" ;
    .

:Heavenly_raiment rdf:type :Concept ;
    rdfs:label "Heavenly raiment" ;
    :description "Divine garments, ornaments, garland of celestial twine given by Anasúyá, Sítá shone like heavenly Goddess, honours high mortal dames scarce obtained" ;
    .

:Sacred_hermitage_life rdf:type :Concept ;
    rdfs:label "Sacred hermitage life" ;
    :description "Bright with Bráhmanic lustre, holy fire fed, sacred grass and deer skins, ladles and sacrificial gear, roots fruit wood, water-urns, Veda chants, offerings burnt with fire, worldly sense subdued" ;
    .

:King's_essence rdf:type :Concept ;
    rdfs:label "King's essence" ;
    :description "One fourth of Indra's essence king bears, protector bright in fame, maintainer of right, bears awful sword, deserves elder's reverence" ;
    .

:Forest_monsters rdf:type :Concept ;
    rdfs:label "Forest monsters" ;
    :description "Fierce and fell creatures, feed on blood from human veins, assume various forms at need, savage beasts devour human flesh, rend and tear holy saints, eat them in cruel joy" ;
    .

:Virádha's_boon rdf:type :Concept ;
    rdfs:label "Virádha's boon" ;
    :description "Charmed frame from Brahmá's grace, weapon or shaft may never pierce or tear, rites austere long maintained" ;
    .

:Kuvera's_curse rdf:type :Concept ;
    rdfs:label "Kuvera's curse" ;
    :description "Stern decree made Tumburu wear hideous shape, when Ráma destroys thee proper shape resume and heaven give room, anger fell for loving Rambhá too well" ;
    .

:Giant_burial_law rdf:type :Concept ;
    rdfs:label "Giant burial law" ;
    :description "Law ordained of old for giants when days are told, bodies laid in earth they rise to homes eternal in skies" ;
    .

:Charmed_immortality rdf:type :Concept ;
    rdfs:label "Charmed immortality" ;
    :description "No arms might slay charmed life, preserving life unharmed by Brahmá's saving promise, swords might rend arrows smite breast in vain, mortal arms defied" ;
    .

:Sítá's_tale_to_Anasúyá rdf:type :Event ;
    rdfs:label "Sítá's tale to Anasúyá" ;
    :description "Story told of how Janak held Maiden's Choice, Ráma won hand, princes declined gift till father's mind learned, aged monarch brought, Sítá given, Urmilá to Lakshmana" ;
    .

:Evening_at_hermitage rdf:type :Event ;
    rdfs:label "Evening at hermitage" ;
    :description "Sun sunk, world left to holy Night, leafy thickets sound with birds, hermit band comes with pitchers, fires tended, smoke ascends, beasts prowl, deer reclined, night spread with lunar stars" ;
    .

:Gift_of_heavenly_raiment rdf:type :Event ;
    rdfs:label "Gift of heavenly raiment" ;
    :description "Anasúyá bade Sítá array in heavenly raiment, shone like Goddess, love-gifts of garland ornaments robes divine, bowed to matron's feet, met lord" ;
    .

:Night_at_hermitage rdf:type :Event ;
    rdfs:label "Night at hermitage" ;
    :description "Ráma's heart and Lakshmana's filled with pride happiness, honored by every pious sage, sacred night hero spent well content beside darling" ;
    .

:Departure_from_hermitage rdf:type :Event ;
    rdfs:label "Departure from hermitage" ;
    :description "When night fled princes said farewell, gazed on distant shade, paid lustral rites and offerings, saints addressed warning about monsters" ;
    .

:Entering_Dandaka rdf:type :Event ;
    rdfs:label "Entering Dandaka" ;
    :description "Ráma stood in vast shade, saw hermit settlement, bright with Bráhmanic lustre, loosed mighty bow-string, drew nearer to holy men" ;
    .

:Saints'_reception rdf:type :Event ;
    rdfs:label "Saints' reception" ;
    :description "Mighty saints with keen celestial sight viewed chieftain with joy, came to meet prince/Sítá/Lakshmana, gave glad blessings, received in hermitage" ;
    .

:Honoring_the_guests rdf:type :Event ;
    rdfs:label "Honoring the guests" ;
    :description "Pure hermits led guest within cot, received with highest honor, kind observance, gave water for feet, brought stores of roots and fruit, poured blessings" ;
    .

:Saints'_pledge rdf:type :Event ;
    rdfs:label "Saints' pledge" ;
    :description "Duty-loving hermits reverent hand to hand: king is protector, thou shouldst give protection, we live in thy realm, people turn to guardian" ;
    .

:Piercing_the_forest rdf:type :Event ;
    rdfs:label "Piercing the forest" ;
    :description "Entertained passed night, with morning's light bade adieu, pierced mighty forest where roamed deer pard bear, ruined pools scarce seen, creeper rent prostrate tree" ;
    .

:Encounter_with_Virádha rdf:type :Event ;
    rdfs:label "Encounter with Virádha" ;
    :description "Deep in thickets stood, saw giant passing nature's law, vast as mountain, hideous, wore tiger's hide, carried beasts on iron spear, charged with roar and yell" ;
    .

:Virádha_seizes_Sítá rdf:type :Event ;
    rdfs:label "Virádha seizes Sítá" ;
    :description "Fierce eye fell on three, took trembling Sítá to side, withdrew little space, demanded who are ye, threatened to make saints his meal, woman to be dame" ;
    .

:Ráma's_lament rdf:type :Event ;
    rdfs:label "Ráma's lament" ;
    :description "Saw Virádha clasp Sítá, cried to brother with pale lips terror dried, Kaikeyí's blow falls, cruel soul triumphant, bitterest grief another touch Maithil dame" ;
    .

:Battle_with_Virádha rdf:type :Event ;
    rdfs:label "Battle with Virádha" ;
    :description "Ráma raised cord and arrow, seven arrows flew winged with gold, smote giant's breast, passed through bulk, fiend grasped spear wild with rage, rushed at brothers" ;
    .

:Arrow_rain_on_giant rdf:type :Event ;
    rdfs:label "Arrow rain on giant" ;
    :description "Princely brothers poured fiery flood of arrowy rain, unmoved he stood, opened dire mouth laughed, arrows escaped from jaws, life unharmed by Brahmá's promise" ;
    .

:Sword_combat rdf:type :Event ;
    rdfs:label "Sword combat" ;
    :description "Each warrior drew sword black as serpent, gathering fury rushed on giant, giant cast arm around each held heroes fast, bearing twain turned and fled" ;
    .

:Abduction_through_forest rdf:type :Event ;
    rdfs:label "Abduction through forest" ;
    :description "Giant upraised them to lofty shoulders, like children clung to neck, rover of night bore princes through wood vast as cloud, where birds flew trees threw shadows" ;
    .

:Sítá's_plea rdf:type :Event ;
    rdfs:label "Sítá's plea" ;
    :description "Viewed with wild affright heroes hurried from sight, tossed shapely arms high, shrieked bitter cry, begged take me leave Raghu's sons free" ;
    .

:Breaking_Virádha's_arms rdf:type :Event ;
    rdfs:label "Breaking Virádha's arms" ;
    :description "Heroes heard mournful cry, hastened for lady's sake, Lakshmana broke foe's left arm, Ráma smashed right with heavy hand, giant came to earth fainting" ;
    .

:Crushing_the_giant rdf:type :Event ;
    rdfs:label "Crushing the giant" ;
    :description "Rushed on crushed and beat with arms fists feet, nerved mighty limb to pound and bray on ground, arrows and blades made wide rents, crushed torn mangled still lived could not kill" ;
    .

:Digging_the_pit rdf:type :Event ;
    rdfs:label "Digging the pit" ;
    :description "Ráma saw no arms might slay charmed life, gave counsel dig pit to fit elephantine bulk, let hollowed earth enfold giant, pressed foot upon breast" ;
    .

:Virádha's_revelation rdf:type :Event ;
    rdfs:label "Virádha's revelation" ;
    :description "Prostrate monster heard Ráma's word with joy, addressed Kakutstha's son: I yield overthrown by might like Indra's, my name was Tumburu renowned for song, cursed by Kuvera, when Ráma destroys me proper shape assume" ;
    .

:Direction_to_Sharabhanga rdf:type :Event ;
    rdfs:label "Direction to Sharabhanga" ;
    :description "Tumburu freed by Ráma's favor saved to heaven go, league beyond stands holy Sharabhanga's cot, sun not more bright, quickly turn earn blessings" ;
    .

:Burial_instructions rdf:type :Event ;
    rdfs:label "Burial instructions" ;
    :description "First under earth throw body then go rejoicing, law ordained of old for giants, bodies laid in earth rise to homes eternal in skies" ;
    .

:Virádha's_death rdf:type :Event ;
    rdfs:label "Virádha's death" ;
    :description "Ráma dug pit to fit bulk, put foot on neck, Lakshmana plied spade dug deep wide, withdrew foot threw down mighty form, awful shout gave sank into grave, spirit fled to heaven" ;
    .

:Victory_celebration rdf:type :Event ;
    rdfs:label "Victory celebration" ;
    :description "Princes rejoiced to see him die, strayed in boundless wood like great sun and moon triumphant in sky" ;
    .

:Journey_to_Sharabhanga rdf:type :Event ;
    rdfs:label "Journey to Sharabhanga" ;
    :description "Having slain Virádha, consoled spouse with gentle words, clasped in loving hold, gave counsel to brother: wild woods hard rough ground, never viewed so dark drear solitude, let us haste to Sharabhanga" ;
    .

:Lord_of_Life rdf:type :Deity ;
    rdfs:label "Lord of Life" ;
    :description "Divine being compared to Dasharatha with four sons, shining with worlds' guardians" ;
    .

:Spirits rdf:type :Deity ;
    rdfs:label "Spirits" ;
    :description "Beings to whom due offerings must be paid" ;
    .

:Two_daughters_of_Kushadhwaj rdf:type :Character ;
    rdfs:label "Two daughters of Kushadhwaj" ;
