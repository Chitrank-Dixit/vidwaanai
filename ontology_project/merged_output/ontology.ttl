    :description "Son of Shíghraga" ;
    .

:Prashushruka rdf:type :Character ;
    rdfs:label "Prashushruka" ;
    :description "Son of Maru" ;
    .

:Ambarísha rdf:type :Character ;
    rdfs:label "Ambarísha" ;
    :description "Son of Prashushruka" ;
    .

:Nábhág rdf:type :Character ;
    rdfs:label "Nábhág" ;
    :description "Son of Yayáti, of happy destiny" ;
    .

:Aja rdf:type :Character ;
    rdfs:label "Aja" ;
    :description "Son of Nábhág, his son is Dasharatha" ;
    .

:Nimi rdf:type :Character ;
    rdfs:label "Nimi" ;
    :description "Ancient king, most virtuous from youth, best of truth-lovers, founder of Videha line" ;
    .

