    rdfs:label "Shankan" ;
    :description "Son of Purushádak" ;
    .

:Sudarshan rdf:type :Character ;
    rdfs:label "Sudarshan" ;
    :description "Son of Shankan, fair in face and limb, beautiful" ;
    .

:Agnivarná rdf:type :Character ;
    rdfs:label "Agnivarná" ;
    :description "Son of Sudarshan, bright as flame" ;
    .

:Shíghraga rdf:type :Character ;
