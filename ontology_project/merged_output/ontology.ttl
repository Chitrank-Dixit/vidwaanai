    .

:Bhárunda_forest rdf:type :Place ;
    rdfs:label "Bhárunda forest" ;
    :description "Forest northward of Viramatsya through which sped" ;
    .

:Kálinda's_child/Yamuná rdf:type :Place ;
    rdfs:label "Kálinda's child/Yamuná" ;
    :description "River that fills soul with joy, begirt by hills, where army rested, horses bathed" ;
    .

:Anshudhána rdf:type :Place ;
    rdfs:label "Anshudhána" ;
    :description "Place where Gangá hard to cross barred journey" ;
    .

:Prágvam's_city rdf:type :Place ;
