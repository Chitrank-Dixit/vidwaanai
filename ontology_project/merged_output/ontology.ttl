    :description "City dear to fame where turned from Anshudhána" ;
    .

:Kumikoshmiká rdf:type :Place ;
    rdfs:label "Kumikoshmiká" ;
    :description "Place hied to after Prágvam, stream crossed" ;
    .

:Dharmavardhan rdf:type :Place ;
    rdfs:label "Dharmavardhan" ;
    :description "Place brought men to after crossing stream" ;
    .

:Torana rdf:type :Place ;
    rdfs:label "Torana" ;
    :description "Place left on north" ;
    .

:Jambuprastha rdf:type :Place ;
    rdfs:label "Jambuprastha" ;
    :description "Place journeyed forth to from Torana" ;
    .

:Varútha's_town rdf:type :Place ;
    rdfs:label "Varútha's town" ;
    :description "Town with pleasant grove where drove and stayed" ;
    .

:Ujjiháná rdf:type :Place ;
    rdfs:label "Ujjiháná" ;
    :description "Place eastward of which with fair tall Priyak trees passed" ;
    .

:Sarvatírtha rdf:type :Place ;
    rdfs:label "Sarvatírtha" ;
    :description "Place where spent a while" ;
    .

:Uttániká rdf:type :Place ;
    rdfs:label "Uttániká" ;
    :description "Place over which went" ;
    .

:Hastiprishmhak rdf:type :Place ;
    rdfs:label "Hastiprishmhak" ;
    :description "Place passed" ;
    .

:Kumiká_brook rdf:type :Place ;
    rdfs:label "Kumiká brook" ;
    :description "Fair brook over which took road" ;
    .

:Lohitya's_village rdf:type :Place ;
    rdfs:label "Lohitya's village" ;
    :description "Village where crossed swift Kapívatí" ;
    .

:Kapívatí_river rdf:type :Place ;
    rdfs:label "Kapívatí river" ;
    :description "Swift river crossed at Lohitya's village" ;
    .

:Ekashálá rdf:type :Place ;
    rdfs:label "Ekashálá" ;
    :description "Place where passed Sthánumatí's flood" ;
    .

:Sthánumatí_river rdf:type :Place ;
    rdfs:label "Sthánumatí river" ;
    :description "Flood and sands passed at Ekashálá" ;
    .

:Gomatí_river rdf:type :Place ;
    rdfs:label "Gomatí river" ;
    :description "River of fair renown by Vinata's town" ;
    .

:Vinata's_town rdf:type :Place ;
    rdfs:label "Vinata's town" ;
    :description "Delightful town by Gomatí" ;
    .

:Kalinga rdf:type :Place ;
    rdfs:label "Kalinga" ;
    :description "Place near which wood of Sal trees charmed view" ;
    .

:Sal_wood rdf:type :Place ;
    rdfs:label "Sal wood" ;
    :description "Wood of Sal trees near Kalinga" ;
    .

:Vaijayanta_gate rdf:type :Place ;
    rdfs:label "Vaijayanta gate" ;
    :description "Gate through which Bharat passed with weary steeds" ;
    .

:Dandaka_wilderness rdf:type :Place ;
    rdfs:label "Dandaka wilderness" ;
    :description "Mighty forest to which Ráma exiled in hermit dress" ;
    .

:Seven_nights_journey rdf:type :Concept ;
    rdfs:label "Seven nights journey" ;
    :description "Duration of Bharat's return journey from grandsire's realm to Ayodhyá" ;
    .

:Omens_of_doom rdf:type :Concept ;
    rdfs:label "Omens of doom" ;
    :description "Dire signs crowding sight: lifeless city, silent streets, joyless gardens, desolate groves, mute drums, hushed music, dark houses" ;
    .

:Signs_of_monarch's_death rdf:type :Concept ;
    rdfs:label "Signs of monarch's death" ;
    :description "Changes seen when kings die: houses dark and grim, doors open wide, no morning rites, no incense, all sit joyless fasting" ;
    .

:Kaikeyí's_scheme rdf:type :Concept ;
    rdfs:label "Kaikeyí's scheme" ;
    :description "Crafty plan: claimed two boons, sent Ráma to exile, throne for Bharat, king maintained name and did her prayer" ;
    .

:Bharat's_reproach rdf:type :Concept ;
    rdfs:label "Bharat's reproach" ;
    :description "Anger-sharpened tongue: accused mother of sin, called her line's destroyer, cruel sinner, direst foe, refused to obey" ;
    .

:Filial_duty_hierarchy rdf:type :Concept ;
    rdfs:label "Filial duty hierarchy" ;
    :description "Eldest son anointed king, no monarchs decline rule, ancient sires' tradition, lineal honor, lofty birth" ;
    .

:Bharat's_abjuration rdf:type :Concept ;
    rdfs:label "Bharat's abjuration" ;
    :description "No lust for kingly sway, no obey to mother, knew naught of consecration or exile, was in distant clime" ;
    .

:Mother's_love_for_son rdf:type :Concept ;
    rdfs:label "Mother's love for son" ;
    :description "Ancient legend: Surabhí wept for toiling children, to mother naught with son can vie, sons dearer than kinsmen" ;
    .

:Elemental_Five rdf:type :Concept ;
    rdfs:label "Elemental Five" ;
    :description "Five elements to which Dasharatha joined when died" ;
    .

:Bharat's_departure rdf:type :Event ;
    rdfs:label "Bharat's departure" ;
    :description "Bid adieu to grandsire and uncle, mounted car with Shatrughna, more than hundred strong-wheeled cars, servants with horses/asses/kine followed" ;
    .

:Epic_journey rdf:type :Event ;
    rdfs:label "Epic journey" ;
    :description "Crossed many rivers, forests, hills, towns over seven nights, swift coursers, exhausted steeds, mountain-bred horses" ;
    .

:Arrival_at_Ayodhyá rdf:type :Event ;
    rdfs:label "Arrival at Ayodhyá" ;
    :description "Sun began to rise, saw city from afar, seventh night passed, passed through Vaijayanta gate weary and disconsolate" ;
    .

:City's_desolation_observed rdf:type :Event ;
    rdfs:label "City's desolation observed" ;
    :description "Bharat saw lifeless city, silent streets, joyless gardens, mute music, dark houses, gathered dire omens, terror influenced senses" ;
    .

:Meeting_Kaikeyí rdf:type :Event ;
    rdfs:label "Meeting Kaikeyí" ;
    :description "Entered mother's bower no longer bright, clasped feet, long kisses pressed, held to breast, questioned about visit" ;
    .

:Revelation_of_death rdf:type :Event ;
    rdfs:label "Revelation of death" ;
    :description "Kaikeyí revealed father gone way all life must go, Bharat fell prostrate, wailed 'Ah woe is me', grief's intolerable weight" ;
    .

:Kaikeyí's_confession rdf:type :Event ;
    rdfs:label "Kaikeyí's confession" ;
    :description "Told as glad news: claimed throne for Bharat, sent Ráma/Lakshmana/Sítá to exile, king did her prayer, urged Bharat to reign" ;
    .

:Bharat's_fury rdf:type :Event ;
    rdfs:label "Bharat's fury" ;
    :description "Burning grief, anger-sharpened tongue, reproaches flung, called mother cruel wicked sinner, line's destroyer, refused throne" ;
    .

:Surabhí's_legend_recounted rdf:type :Event ;
    rdfs:label "Surabhí's legend recounted" ;
    :description "Bharat told ancient story: cow saw children toiling, wept tears on Indra, proved mother's love for son supreme" ;
    .

:Bharat's_vow rdf:type :Event ;
    rdfs:label "Bharat's vow" ;
    :description "Will bring Ráma home, serve as faithful slave, pay funeral rites, betake to hermit woods, cannot bear people's sad eyes" ;
    .

:Abjuration_before_assembly rdf:type :Event ;
    rdfs:label "Abjuration before assembly" ;
    :description "Bharat fell to earth like serpent maimed, rose, spoke before lords and ministers: no lust for sway, no obey mother, knew naught" ;
    .

:KumbhakarGa rdf:type :Character ;
    rdfs:label "KumbhakarGa" ;
    :description "Ravana's giant brother, who is woken from deep sleep and slain by Rama." ;
    .

:Vajradanshtra rdf:type :Character ;
    rdfs:label "Vajradanshtra" ;
    :description "A Rakshasa general who sallies forth and is slain by Angada." ;
    .

:Atikáya rdf:type :Character ;
    rdfs:label "Atikáya" ;
    :description "A giant son of Ravana who is slain by Lakshmana." ;
    .

:Nandigráma rdf:type :Place ;
    rdfs:label "Nandigráma" ;
    :description "The village where Bharat lived in asceticism waiting for Rama." ;
    .

:Himalayas rdf:type :Place ;
    rdfs:label "Himalayas" ;
    :description "The northern mountain range from which Hanuman fetches the healing herbs." ;
    .

:Nagapasa rdf:type :Concept ;
    rdfs:label "Nagapasa" ;
    :description "The magic serpent weapon used by Indrajit to bind Rama and Lakshmana." ;
    .

:Healing_Herbs rdf:type :Concept ;
    rdfs:label "Healing Herbs" ;
    :description "The magical life-giving herbs brought by Hanuman to revive the fallen princes." ;
    .

:Pushpaka rdf:type :Concept ;
    rdfs:label "Pushpaka" ;
    :description "The aerial vehicle used by Rama, Sita, and the Vanaras to return to Ayodhya." ;
    .

:Aditya_Hridaya rdf:type :Concept ;
    rdfs:label "Aditya Hridaya" ;
    :description "The sacred sun hymn taught to Rama to ensure victory." ;
    .

:Slaying_of_KumbhakarGa rdf:type :Event ;
    rdfs:label "Slaying of KumbhakarGa" ;
    :description "The battle where the sleeping giant Kumbhakarna is defeated and slain by Rama." ;
    .

:Slaying_of_Indrajít rdf:type :Event ;
    rdfs:label "Slaying of Indrajít" ;
    :description "The battle where Lakshmana kills Ravana's son Indrajit near Nikumbhila." ;
    .

:Ordeal_of_Fire rdf:type :Event ;
    rdfs:label "Ordeal of Fire" ;
    :description "Sita enters the burning pyre to prove her chastity, and Agni attests to her purity." ;
    .

:Consecration_of_VibhíshaGa rdf:type :Event ;
    rdfs:label "Consecration of VibhíshaGa" ;
    :description "Rama ordains Vibhishana as the king of Lanka." ;
    .

:Return_to_Ayodhyá rdf:type :Event ;
    rdfs:label "Return to Ayodhyá" ;
    :description "The triumphant return of Rama, Sita, and their allies in the Pushpaka car." ;
    .

:Coronation_of_Ráma rdf:type :Event ;
    rdfs:label "Coronation of Ráma" ;
    :description "Rama's consecration and coronation as the king of Ayodhya." ;
    .

:Nárāyana rdf:type :Deity ;
    rdfs:label "Nárāyana" ;
    :description "Heavenly Sire, God supreme sought by Ráma, besought as votary, blessed and aided" ;
    .

:Vrihaspati rdf:type :Deity ;
    rdfs:label "Vrihaspati" ;
    :description "Priest of Gods, compared to Vasishtha rising to meet king" ;
    .

:Manthará rdf:type :Character ;
    rdfs:label "Manthará" ;
    :description "Slave-born handmaid, hump-back maid, bred with Kaikeyí, artful, treacherous, skilled to deceive, wicked, sin in thoughts, possessed thousand wiles" ;
    .

:Ráma's_nurse rdf:type :Character ;
    rdfs:label "Ráma's nurse" ;
    :description "Attendant in white attire, joy-expanded eye, told glad tidings to Manthará" ;
    .

:Sumantra rdf:type :Character ;
    rdfs:label "Sumantra" ;
    :description "Minister mentioned in context" ;
    .

:Nahush rdf:type :Character ;
    rdfs:label "Nahush" ;
    :description "King of Lunar race, father of Yayáti, consecrated son as wise relate" ;
    .

:Yayáti rdf:type :Character ;
    rdfs:label "Yayáti" ;
    :description "Son of Nahush, joyed to consecrate as king" ;
    .

:Zambara rdf:type :Character ;
    rdfs:label "Zambara" ;
    :description "Demon lord of Vaijayanta city, flag displayed hugest sea monster, lord of hundred wiles, fought Gods, possessed thousand wiles" ;
    .

:Vishnu's_chapel rdf:type :Place ;
    rdfs:label "Vishnu's chapel" ;
    :description "Sacred place where Ráma reclined on bed of holy grass seeking supreme God" ;
    .

:Mourner's_chamber rdf:type :Place ;
    rdfs:label "Mourner's chamber" ;
    :description "Chamber of wrath, growlery, small dark unfurnished room for offended ladies, where Kaikeyí went" ;
    .

:Vaijayanta rdf:type :Place ;
    rdfs:label "Vaijayanta" ;
    :description "City swayed by demon Zambara" ;
    .

:Paradise rdf:type :Place ;
    rdfs:label "Paradise" ;
    :description "Heavenly realm, nymph compared to Kaikeyí" ;
    .

:Kailása rdf:type :Place ;
    rdfs:label "Kailása" ;
    :description "High hill, Manthará's descent compared to its head" ;
    .

:Consecration_rite rdf:type :Concept ;
    rdfs:label "Consecration rite" ;
    :description "Ceremony to make Ráma heir, people-honored festival, solemn rite on Pushya's favoring hour, when moon and Pushya meet" ;
    .

:Fast rdf:type :Concept ;
    rdfs:label "Fast" ;
    :description "Vow ordained by rule and text for Ráma and Sítá, preparation for consecration, fasted till morning light" ;
    .

:Holy_grass rdf:type :Concept ;
    rdfs:label "Holy grass" ;
    :description "Sacred grass spread on bed in Vishnu's chapel" ;
    .

:Holy_oil rdf:type :Concept ;
    rdfs:label "Holy oil" ;
    :description "Brimming cup lifted on Ráma's head, offering to heavenly Sire" ;
    .

:Two_boons rdf:type :Concept ;
    rdfs:label "Two boons" ;
    :description "Two prayers/gifts promised by Dasharatha to Kaikeyí for saving his life in battle, reserved for season due" ;
    .

:Pushya rdf:type :Concept ;
    rdfs:label "Pushya" ;
    :description "Favoring hour, lunar asterism, auspicious time for consecration" ;
    .

:Fourteen_years_exile rdf:type :Concept ;
    rdfs:label "Fourteen years exile" ;
    :description "Twice seven years/five and nine years banishment to wild demanded for Ráma" ;
    .

:Heavenly_Twins rdf:type :Concept ;
    rdfs:label "Heavenly Twins" ;
    :description "Divine pair whose friendship wins fame, compared to Ráma-Lakshmana bond" ;
    .

:Ráma's_consecration_preparation rdf:type :Event ;
    rdfs:label "Ráma's consecration preparation" ;
    :description "Eve of ceremony, Ráma fasted, bathed, worshipped, city decorated, crowds gathered" ;
    .

:City_decoration rdf:type :Event ;
    rdfs:label "City decoration" ;
    :description "Ayodhyá adorned with banners, flowers, garlands, watered streets, temples gleaming, lamps erected" ;
    .

:Vasishtha's_visit rdf:type :Event ;
    rdfs:label "Vasishtha's visit" ;
    :description "Priest came to palace, met king, ordained fast, departed honored" ;
    .

:Manthará's_discovery rdf:type :Event ;
    rdfs:label "Manthará's discovery" ;
    :description "Hump-back climbed terrace, saw decorated city, learned of Ráma's consecration from nurse" ;
    .

:Manthará's_scheme rdf:type :Event ;
    rdfs:label "Manthará's scheme" ;
    :description "Wicked maid plotted to turn Kaikeyí against Ráma, advised claiming two boons" ;
    .

:Ancient_demon_war rdf:type :Event ;
    rdfs:label "Ancient demon war" ;
    :description "Gods fought demons, Dasharatha aided Indra, battled in Dandaka wilds, wounded and saved by Kaikeyí" ;
    .

:Kaikeyí's_retreat_to_mourner's_chamber rdf:type :Event ;
    rdfs:label "Kaikeyí's retreat to mourner's chamber" ;
    :description "Queen went to chamber of wrath, lay prostrate, removed ornaments, prepared to manipulate king" ;
    .

:Lord_of_Gold rdf:type :Deity ;
    rdfs:label "Lord of Gold" ;
    :description "Deity associated with wealth, mentioned in comparison to Dasharatha's riches" ;
    .

:Nágas rdf:type :Deity ;
    rdfs:label "Nágas" ;
    :description "Demigods with human face and serpent body, inhabitants of Pátála" ;
    .

:Airávat rdf:type :Deity ;
    rdfs:label "Airávat" ;
    :description "Divine elephant, upholder of the skies" ;
    .

:Válmíki rdf:type :Character ;
