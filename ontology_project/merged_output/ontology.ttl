    :description "Son of Bharat, warrior with fierce warfare, fled to Himálaya, died there" ;
    .

:Asamanj rdf:type :Character ;
    rdfs:label "Asamanj" ;
    :description "Son of Sagar, heir" ;
    .

:Anshumán rdf:type :Character ;
    rdfs:label "Anshumán" ;
    :description "Son of Asamanj, bright" ;
    .

:Dilípa rdf:type :Character ;
