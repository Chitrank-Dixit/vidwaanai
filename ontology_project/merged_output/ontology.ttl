    .

:Lords_divine rdf:type :Deity ;
    rdfs:label "Lords divine" ;
    :description "Guiltless deities, no fault in them" ;
    .

:Storm_God rdf:type :Deity ;
    rdfs:label "Storm-God" ;
    :description "Flies through skies in fair chariot, compared to Bharat's journey" ;
    .

:Grandsire rdf:type :Character ;
    rdfs:label "Grandsire" ;
    :description "Bharat's maternal grandfather, king, conqueror" ;
    .

:Uncle_Yudhájit rdf:type :Character ;
    rdfs:label "Uncle Yudhájit" ;
    :description "Bharat's maternal uncle, well, free from trouble" ;
    .

:Ministers_and_lords rdf:type :Character ;
    rdfs:label "Ministers and lords" ;
    :description "Lordly band on whom king relied, each minister before whom Bharat spoke" ;
    .

:Surabhí rdf:type :Character ;
    rdfs:label "Surabhí" ;
    :description "God-loved cow, gentle, learned in eloquence, saw children toiling, wept tears on Indra, many thousand children bred" ;
    .

:Ikshváku rdf:type :Character ;
    rdfs:label "Ikshváku" ;
    :description "Ancient ancestor, old Ikshváku's famous son, children kept city, Ikshváku's line follows eldest son rule" ;
    .

:Grandsire's_kingdom rdf:type :Place ;
    rdfs:label "Grandsire's kingdom" ;
    :description "Royal town from which Bharat departed, maternal grandfather's realm" ;
    .

:Sudámá_river rdf:type :Place ;
    rdfs:label "Sudámá river" ;
    :description "River whose farther side Bharat reached, glorious tide" ;
    .

:Hládiní_river rdf:type :Place ;
    rdfs:label "Hládiní river" ;
    :description "River with westering billows hard to cross" ;
    .

:Shatadrú_river rdf:type :Place ;
    rdfs:label "Shatadrú river" ;
    :description "Hundred-channeled river, Sharadrus of Ptolemy, Hesydrus of Pliny, the Sutlej" ;
    .

:Ailadhána rdf:type :Place ;
    rdfs:label "Ailadhána" ;
    :description "Place on strand near Shatadrú" ;
    .

:Aparparyat's_land rdf:type :Place ;
    rdfs:label "Aparparyat's land" ;
    :description "Territory reached after Ailadhána" ;
    .

:Shilá_river rdf:type :Place ;
    rdfs:label "Shilá river" ;
    :description "Flood over which hurried fast" ;
    .

:Akurvatí_stream rdf:type :Place ;
    rdfs:label "Akurvatí stream" ;
    :description "Fair stream passed" ;
    .

:Ágneya's_rill rdf:type :Place ;
    rdfs:label "Ágneya's rill" ;
    :description "Rapid rill crossed" ;
    .

:Shalyakartan rdf:type :Place ;
    rdfs:label "Shalyakartan" ;
    :description "Place passed onward still" ;
    .

:Shiláváhá_stream rdf:type :Place ;
    rdfs:label "Shiláváhá stream" ;
    :description "Swift stream eyed, true to vows and purified" ;
    .

:Chaitraratha_wood rdf:type :Place ;
    rdfs:label "Chaitraratha wood" ;
