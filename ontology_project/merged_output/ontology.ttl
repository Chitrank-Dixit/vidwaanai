@prefix : <http://vidwaan.ai/ontology/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://vidwaan.ai/ontology/> .


<http://vidwaan.ai/ontology> rdf:type owl:Ontology ;
    rdfs:comment "Vidwaan AI Vedic Ontology generated via Multi-LLM Pipeline" ;
    owl:versionInfo "2026-06-06" .

:Concept rdf:type owl:Class .
:Character rdf:type owl:Class .
:Event rdf:type owl:Class .
:Text rdf:type owl:Class .
:Place rdf:type owl:Class .
:Deity rdf:type owl:Class .

:Brahmá rdf:type :Deity ;
    rdfs:label "Brahmá" ;
    :description "Creator deity, father of Vasishtha, produced Bálakhilyas from hair, celestial seat" ;
    .

:Shiva rdf:type :Deity ;
    rdfs:label "Shiva" ;
    :description "Also called Mahádeva, the Great God, Lord most High, bountiful, whose banner shows pictured bull Nandi" ;
    .

:Nandi rdf:type :Deity ;
    rdfs:label "Nandi" ;
    :description "Snow-white bull, attendant and favourite vehicle of Shiva" ;
    .

:Ashvins rdf:type :Deity ;
    rdfs:label "Ashvins" ;
    :description "Divine twin children of Sun, princes compared to them" ;
    .

:Gods rdf:type :Deity ;
    rdfs:label "Gods" ;
    :description "Divine beings who praised Ahalyá, came to claim dues at sacrifice" ;
    .

:Ahalya rdf:type :Character ;
    rdfs:label "Ahalya" ;
    :description "Glorious dame, wife of Gautam, freed from curse by Ráma, purified from sin and folly" ;
    .

:Gautama rdf:type :Character ;
    rdfs:label "Gautama" ;
    :description "Holy hermit, sage with godlike view, husband of Ahalyá, reconciled with wife, shares austerities" ;
    .

:Vishvamitra rdf:type :Character ;
    rdfs:label "Vishvamitra" ;
    :description "Mighty saint, son of Gádhi of Kusha's line, guide to Ráma, formerly warrior king, royal sage" ;
    .

:Vashishtha rdf:type :Character ;
    rdfs:label "Vashishtha" ;
    :description "Prince of saintly men, arch-hermit, son of Brahmá, best of those who pray, owns Dapple-skin cow" ;
    .

:Shatánanda rdf:type :Character ;
    rdfs:label "Shatánanda" ;
    :description "Eldest son of Gautam and Ahalyá, far-renowned, crowned with glory by austerities, filled with wonder" ;
    .

:Renuka rdf:type :Character ;
    rdfs:label "Renuka" ;
    :description "Dame mentioned in comparison to Ahalyá, reconciled with Bhrigu's child" ;
    .

:Bhrigu's_child rdf:type :Character ;
    rdfs:label "Bhrigu's child" ;
    :description "Saint mentioned in comparison, reconciled with Renuka" ;
    .

:Rama rdf:type :Character ;
    rdfs:label "Rama" ;
    :description "Prince, pride of Raghu's race, lotus-eyed, freed Ahalyá, scion of King Raghu's line, strong of arm" ;
    .

:Lakshmana rdf:type :Character ;
    rdfs:label "Lakshmana" ;
    :description "Son of Raghu, brother of Ráma, accompanied on journey" ;
    .

:Janaka rdf:type :Character ;
    rdfs:label "Janaka" ;
    :description "Best of kings, high-souled, lofty-souled, planned sacrifice, ruled Mithilá" ;
    .

:Dasharatha rdf:type :Character ;
    rdfs:label "Dasharatha" ;
    :description "Father of Ráma and Lakshmana, king" ;
    .

:Kusha rdf:type :Character ;
    rdfs:label "Kusha" ;
    :description "Mighty king of earth, given birth by Lord of Life, ancestor of Vishvámitra" ;
    .

:Kushanábha rdf:type :Character ;
    rdfs:label "Kushanábha" ;
    :description "Son of Kusha, strong, friend of right, foe of wrong" ;
    .

:Gádhi rdf:type :Character ;
    rdfs:label "Gádhi" ;
    :description "Son of Kushanábha, father of Vishvámitra, governed land, fame undimmed by time" ;
    .

:Vishvámitra_the_King rdf:type :Character ;
    rdfs:label "Vishvámitra the King" ;
    :description "Heir of Gádhi, governed with kingly care, led warriors, peerless for warlike enterprise, later became hermit" ;
    .

:Hundred_sons_of_Vishvámitra rdf:type :Character ;
    rdfs:label "Hundred sons of Vishvámitra" ;
    :description "Armed warriors, mad with rage, rushed on Vasishtha, burnt to ashes by sage's glance" ;
    .

:One_remaining_son rdf:type :Character ;
    rdfs:label "One remaining son" ;
    :description "Only surviving son of Vishvámitra, given empire, ruled as kings are taught" ;
    .

:Bálakhilyas rdf:type :Character ;
    rdfs:label "Bálakhilyas" ;
    :description "Divine personages of minute size, produced from hair of Brahmá, small infantry" ;
    .

:Mithilá rdf:type :Place ;
    rdfs:label "Mithilá" ;
    :description "City ruled by Janak, destination of Ráma's journey, also called Visálá" ;
    .

:Visálá rdf:type :Place ;
    rdfs:label "Visálá" ;
    :description "City with fair towers, another name for Mithilá" ;
    .

:Sacrificial_ground rdf:type :Place ;
    rdfs:label "Sacrificial ground" ;
    :description "Enclosed area prepared by Janak, with thousands of Bráhmans, tents, wains" ;
    .

:Vasishtha's_hermitage rdf:type :Place ;
    rdfs:label "Vasishtha's hermitage" ;
    :description "Pure abode where trees, flowers, creepers glowed, visited by saints and angels, like Brahmá's celestial seat" ;
    .

:Himálaya rdf:type :Place ;
    rdfs:label "Himálaya" ;
    :description "Mountain region visited by bards and Nágas, where Vishvámitra sought penance" ;
    .

:Dapple_skin_cow rdf:type :Concept ;
    rdfs:label "Dapple-skin cow" ;
    :description "Cow of spotted skin, cow of plenty, provides all needs, yields offerings, guardian and minister of Vasishtha" ;
    .

:Curse_of_Ahalyá rdf:type :Concept ;
    rdfs:label "Curse of Ahalyá" ;
    :description "Gautam's decree that removed Ahalyá from sight, ended when Ráma came" ;
    .

:Guest_gift rdf:type :Concept ;
    rdfs:label "Guest-gift" ;
    :description "Traditional offering for strangers, water for feet" ;
    .

:Six_fold_taste rdf:type :Concept ;
    rdfs:label "Six-fold taste" ;
    :description "Sweet, salt, pungent, bitter, acid, and astringent flavors" ;
    .

:Sacred_flame rdf:type :Concept ;
    rdfs:label "Sacred flame" ;
    :description "Fire requiring ghee/clarified butter for sacrifice" ;
    .

:Five_principal_duties rdf:type :Concept ;
    rdfs:label "Five principal duties" ;
    :description "Study and teaching Veda, oblations to manes, sacrifice to Gods, hospitality, gift of food to creatures" ;
    .

:Sacred_invocations rdf:type :Concept ;
    rdfs:label "Sacred invocations" ;
    :description "Words like váhá, vasham pronounced at sacrifice" ;
    .

:Science_of_the_bow rdf:type :Concept ;
    rdfs:label "Science of the bow" ;
    :description "Wondrous knowledge with secret spell and mystic art, all arms revealed" ;
    .

:Famous_bow rdf:type :Concept ;
    rdfs:label "Famous bow" ;
    :description "Wondrous bow at Janak's court, virtue to be known" ;
    .

:Freeing_of_Ahalyá rdf:type :Event ;
    rdfs:label "Freeing of Ahalyá" ;
    :description "Ráma's presence freed Ahalyá from curse, flowers rained, nymphs and minstrels sang" ;
    .

:Reconciliation_of_Gautam_and_Ahalyá rdf:type :Event ;
    rdfs:label "Reconciliation of Gautam and Ahalyá" ;
    :description "Gautam received Ahalyá purified from sin, she shared in his austerities" ;
    .

:Journey_to_Mithilá rdf:type :Event ;
    rdfs:label "Journey to Mithilá" ;
    :description "Ráma and Lakshmana traveled with Vishvámitra to Janak's sacrifice" ;
    .

:Janak's_sacrifice rdf:type :Event ;
    rdfs:label "Janak's sacrifice" ;
    :description "Noble rite prepared by King Janak, twelve days to completion, festival" ;
    .

:Meeting_with_Janak rdf:type :Event ;
    rdfs:label "Meeting with Janak" ;
    :description "Vishvámitra met Janak with chaplain Shatánanda, exchanged honors" ;
    .

:Vishvámitra's_visit_to_Vasishtha rdf:type :Event ;
    rdfs:label "Vishvámitra's visit to Vasishtha" ;
    :description "King Vishvámitra visited hermit Vasishtha's abode with mighty army" ;
    .

:Vasishtha's_feast rdf:type :Event ;
    rdfs:label "Vasishtha's feast" ;
    :description "Banquet prepared by Dapple-skin cow, fed entire army with all delicacies" ;
    .

:Battle_for_Dapple_skin rdf:type :Event ;
    rdfs:label "Battle for Dapple-skin" ;
    :description "Vishvámitra tried to take cow by force, cow created armies, Vasishtha defeated Vishvámitra" ;
    .

:Death_of_hundred_sons rdf:type :Event ;
    rdfs:label "Death of hundred sons" ;
    :description "Vishvámitra's hundred sons burnt to ashes by Vasishtha's glance" ;
    .

:Vishvámitra's_penance rdf:type :Event ;
    rdfs:label "Vishvámitra's penance" ;
    :description "King fled to Himálaya, performed stern penance to earn Shiva's grace" ;
    .

:Shiva's_boon rdf:type :Event ;
    rdfs:label "Shiva's boon" ;
    :description "Shiva appeared to Vishvámitra, granted him science of the bow" ;
    .

:Pahlavas rdf:type :Character ;
    rdfs:label "Pahlavas" ;
    :description "Warriors created by cow, Persians, burning for strife, slain by Vishvámitra" ;
    .

:Yavans rdf:type :Character ;
    rdfs:label "Yavans" ;
    :description "Warriors created by cow, Greeks, bright and strong, in gold-hued mail" ;
    .

:Shakas rdf:type :Character ;
    rdfs:label "Shakas" ;
    :description "Warriors created by cow, nomad tribes from Central Asia, Scythes, fierce and dire" ;
    .

:Kámbojas rdf:type :Character ;
    rdfs:label "Kámbojas" ;
    :description "Warriors created by cow from her lowing, faces bright as sun" ;
    .

:Barbars rdf:type :Character ;
    rdfs:label "Barbars" ;
    :description "Warriors created from cow's udder, brandished spear and sword" ;
    .

:Mlechchhas rdf:type :Character ;
    rdfs:label "Mlechchhas" ;
    :description "Foreign or outcast races, created from cow's pores" ;
    .

:Kirátas rdf:type :Character ;
    rdfs:label "Kirátas" ;
    :description "Savage aborigines occupying hills and jungles, created from cow" ;
    .

:Hárítas rdf:type :Character ;
    rdfs:label "Hárítas" ;
    :description "Savage aborigines, streamed forth from cow" ;
    .

:Sita rdf:type :Character ;
    rdfs:label "Sita" ;
    :description "Wife of Rama, princess of Videha (Mithila), called the Maithil dame" ;
    .

:Agastya rdf:type :Character ;
    rdfs:label "Agastya" ;
    :description "Revered hermit-sage who counsels Rama and directs him to Panchavati" ;
    .

:Jatayu rdf:type :Character ;
    rdfs:label "Jatayu" ;
    :description "Mighty vulture king, old friend of Dasharatha, guardian and ally of Rama; son of Aruna; self-identifies as son of Shyeni lineage" ;
    .

:Sampati rdf:type :Character ;
    rdfs:label "Sampati" ;
    :description "Elder son of Aruna, brother of Jatayu" ;
    .

:Bharat rdf:type :Character ;
    rdfs:label "Bharat" ;
    :description "Son of Dasharatha and Kaikeyi; grieves Rama's exile and lives austerely at Ayodhya" ;
    .

:Shatrughna rdf:type :Character ;
    rdfs:label "Shatrughna" ;
    :description "Youngest son of Dasharatha, brother of Rama" ;
    .

:Kaikeyi rdf:type :Character ;
    rdfs:label "Kaikeyi" ;
    :description "Second queen of Dasharatha, mother of Bharata, whose plot caused Rama's exile" ;
    .

:Sumitra rdf:type :Character ;
    rdfs:label "Sumitra" ;
    :description "Queen of Dasharatha and mother of Lakshmana" ;
    .

:Surpanakha rdf:type :Character ;
    rdfs:label "Surpanakha" ;
    :description "Rakshasi (giantess) who encounters Rama at Panchavati; sister of Ravana (the Ten-necked tyrant)" ;
    .

:Ravana rdf:type :Character ;
    rdfs:label "Ravana" ;
    :description "The Ten-necked demon tyrant; brother of Surpanakha" ;
    .

:Aruna rdf:type :Character ;
    rdfs:label "Aruna" ;
    :description "Son of Vinata, red as the dawn; father of Sampati and Jatayu" ;
    .

:Garuda rdf:type :Character ;
    rdfs:label "Garuda" ;
    :description "Son of Vinata; divine eagle, swift of flight" ;
    .

:Vinata rdf:type :Character ;
    rdfs:label "Vinata" ;
    :description "Daughter of Daksha via Shuki-Nala lineage; wife of Kashyapa; mother of Aruna and Garuda" ;
    .

:Airavata rdf:type :Character ;
    rdfs:label "Airavata" ;
    :description "Divine elephant of Indra; born of Iravati (daughter of Bhadramada)" ;
    .

:Kashyapa rdf:type :Character ;
    rdfs:label "Kashyapa" ;
    :description "Primordial sage, son of Marichi; married eight daughters of Daksha; progenitor of gods, demons, humans, and animals" ;
    .

:Daksha rdf:type :Character ;
    rdfs:label "Daksha" ;
    :description "Lord of Life; father of sixty daughters, eight of whom married Kashyapa" ;
    .

:Kardam rdf:type :Character ;
    rdfs:label "Kardam" ;
    :description "First-born Lord of Life in the primordial genealogy" ;
    .

:Vikrit rdf:type :Character ;
    rdfs:label "Vikrit" ;
    :description "Second Lord of Life in the primordial genealogy" ;
    .

:Sesha rdf:type :Character ;
    rdfs:label "Sesha" ;
    :description "Third Lord of Life in the primordial genealogy" ;
    .

:Sankhya rdf:type :Character ;
    rdfs:label "Sankhya" ;
    :description "Fourth Lord of Life in the primordial genealogy" ;
    .

:Bahuputra rdf:type :Character ;
    rdfs:label "Bahuputra" ;
    :description "Fifth Lord of Life in the primordial genealogy" ;
    .

:Sthanu rdf:type :Character ;
    rdfs:label "Sthanu" ;
    :description "Sixth Lord of Life in the primordial genealogy" ;
    .

:Marichi rdf:type :Character ;
    rdfs:label "Marichi" ;
    :description "Seventh Lord of Life; father of Kashyapa" ;
    .

:Atri rdf:type :Character ;
    rdfs:label "Atri" ;
    :description "Lord of Life in the primordial genealogy" ;
    .

:Kratu rdf:type :Character ;
    rdfs:label "Kratu" ;
    :description "Lord of Life in the primordial genealogy" ;
    .

:Pulastya rdf:type :Character ;
    rdfs:label "Pulastya" ;
    :description "Lord of Life; ancestor of Ravana" ;
    .

:Angiras rdf:type :Character ;
    rdfs:label "Angiras" ;
    :description "Lord of Life; celestial sage" ;
    .

:Prachetas rdf:type :Character ;
    rdfs:label "Prachetas" ;
    :description "Lord of Life in the primordial genealogy" ;
    .

:Pulaha rdf:type :Character ;
    rdfs:label "Pulaha" ;
    :description "Lord of Life in the primordial genealogy" ;
    .

:Vivasvat rdf:type :Character ;
    rdfs:label "Vivasvat" ;
    :description "Lord of Life; sun deity; praised of men" ;
    .

:Arishmanemi rdf:type :Character ;
    rdfs:label "Arishmanemi" ;
    :description "Lord of Life in the primordial genealogy" ;
    .

:Aditi rdf:type :Character ;
    rdfs:label "Aditi" ;
    :description "First wife of Kashyapa; mother of thirty-three gods — Vasus, Adityas, Rudras, and the twin Ashvins" ;
    .

:Diti rdf:type :Character ;
    rdfs:label "Diti" ;
    :description "Wife of Kashyapa; mother of the Daityas (demons)" ;
    .

:Danu rdf:type :Character ;
    rdfs:label "Danu" ;
    :description "Wife of Kashyapa; mother of Asvagriva" ;
    .

:Kalaka rdf:type :Character ;
    rdfs:label "Kalaka" ;
    :description "Wife of Kashyapa; mother of Narak and Kalak" ;
    .

:Tamra rdf:type :Character ;
    rdfs:label "Tamra" ;
    :description "Wife of Kashyapa; mother of five daughters: Kraunchi, Bhasi, Shyeni, Shuki, Dhritarashtri" ;
    .

:Anala rdf:type :Character ;
    rdfs:label "Anala" ;
    :description "Wife of Kashyapa; mother of all fruit-bearing trees" ;
    .

:Krodhavasa rdf:type :Character ;
    rdfs:label "Krodhavasa" ;
    :description "Wife of Kashyapa, swift to ire; mother of ten daughters including Mrighi, Surasa, Kadru, etc." ;
    .

:Manu rdf:type :Character ;
    rdfs:label "Manu" ;
    :description "Wife of Kashyapa (daughter of Daksha); mother of the four human castes — Brahman, Kshatriya, Vaishya, Shudra" ;
    .

:Kraunchi rdf:type :Character ;
    rdfs:label "Kraunchi" ;
    :description "Daughter of Tamra; mother of cranes and owls" ;
    .

:Bhasi rdf:type :Character ;
    rdfs:label "Bhasi" ;
    :description "Daughter of Tamra; mother of water fowl" ;
    .

:Shyeni rdf:type :Character ;
    rdfs:label "Shyeni" ;
    :description "Daughter of Tamra; mother of vultures and hawks; ancestress of Jatayu's lineage" ;
    .

:Shuki rdf:type :Character ;
    rdfs:label "Shuki" ;
    :description "Daughter of Tamra; grandmother of Vinata via daughter Nala" ;
    .

:Dhritarashtri rdf:type :Character ;
    rdfs:label "Dhritarashtri" ;
    :description "Daughter of Tamra; mother of all swans, geese, and river-haunting ducks" ;
    .

:Nala rdf:type :Character ;
    rdfs:label "Nala" ;
    :description "Daughter of Shuki; mother of Vinata" ;
    .

:Mrighi rdf:type :Character ;
    rdfs:label "Mrighi" ;
    :description "Daughter of Krodhavasa; mother of deer" ;
    .

:Mrigamanda rdf:type :Character ;
    rdfs:label "Mrigamanda" ;
    :description "Daughter of Krodhavasa; mother of bears, yaks, and mountain roe" ;
    .

:Hari rdf:type :Character ;
    rdfs:label "Hari" ;
    :description "Daughter of Krodhavasa; mother of lions and wild monkeys" ;
    .

:Bhadramada rdf:type :Character ;
    rdfs:label "Bhadramada" ;
    :description "Daughter of Krodhavasa; mother of Iravati" ;
    .

:Sharduli rdf:type :Character ;
    rdfs:label "Sharduli" ;
    :description "Daughter of Krodhavasa; mother of leopards, langurs, and tigers" ;
    .

:Shveta rdf:type :Character ;
    rdfs:label "Shveta" ;
    :description "Daughter of Krodhavasa; mother of the eight directional guardian elephants" ;
    .

:Matangi rdf:type :Character ;
    rdfs:label "Matangi" ;
    :description "Daughter of Krodhavasa; mother of elephants (Matangas)" ;
    .

:Surabhi rdf:type :Character ;
    rdfs:label "Surabhi" ;
    :description "Daughter of Krodhavasa; mother of two celestial daughters: Gandharvi and Rohini" ;
    .

:Surasa rdf:type :Character ;
    rdfs:label "Surasa" ;
    :description "Daughter of Krodhavasa; mother of hooded serpents" ;
    .

:Kadru rdf:type :Character ;
    rdfs:label "Kadru" ;
    :description "Daughter of Krodhavasa (also called daughter of Kashyapa elsewhere); mother of countless snakes" ;
    .

:Iravati rdf:type :Character ;
    rdfs:label "Iravati" ;
    :description "Daughter of Bhadramada; mother of Airavata, the elephant of Indra" ;
    .

:Gandharvi rdf:type :Character ;
    rdfs:label "Gandharvi" ;
    :description "Daughter of Surabhi; mother of horses" ;
    .

:Rohini rdf:type :Character ;
    rdfs:label "Rohini" ;
    :description "Daughter of Surabhi; mother of cattle / kine" ;
    .

:Asvagriva rdf:type :Character ;
    rdfs:label "Asvagriva" ;
    :description "Son of Danu" ;
    .

:Narak rdf:type :Character ;
    rdfs:label "Narak" ;
    :description "Son of Kalaka" ;
    .

:Kalak rdf:type :Character ;
    rdfs:label "Kalak" ;
    :description "Son of Kalaka" ;
    .

:Daityas rdf:type :Character ;
    rdfs:label "Daityas" ;
    :description "Demon race born of Diti; their empire once spread over earth, woods, and ocean" ;
    .

:Indra rdf:type :Deity ;
    rdfs:label "Indra" ;
    :description "King of the gods; owner of Airavata the divine elephant" ;
    .

:Rudra rdf:type :Deity ;
    rdfs:label "Rudra" ;
    :description "Also called Shiva; adored by all worlds; associated with Nandi and Uma-Parvati" ;
    .

:Uma rdf:type :Deity ;
    rdfs:label "Uma" ;
    :description "Also called Parvati; consort of Rudra/Shiva; daughter of Himalaya" ;
    .

:Kandarpa rdf:type :Deity ;
    rdfs:label "Kandarpa" ;
    :description "God of love (Kamadeva); Rama's youthful grace is compared to his" ;
    .

:Yama rdf:type :Deity ;
    rdfs:label "Yama" ;
    :description "Lord of the dead; the south is said to be his residence; the sun turns toward his domain in winter" ;
    .

:Vasus rdf:type :Deity ;
    rdfs:label "Vasus" ;
    :description "Group of eight celestial gods born of Aditi" ;
    .

:Adityas rdf:type :Deity ;
    rdfs:label "Adityas" ;
    :description "Twelve solar gods born of Aditi" ;
    .

:Rudras rdf:type :Deity ;
    rdfs:label "Rudras" ;
    :description "Eleven storm gods born of Aditi" ;
    .

:Chitra rdf:type :Character ;
    rdfs:label "Chitra" ;
    :description "A star; described as a dear delight of the Moon (Lord of Night)" ;
    .

:Panchavati rdf:type :Place ;
    rdfs:label "Panchavati" ;
    :description "Forest grove four leagues from Agastya's hermitage; recommended by Agastya as Rama's dwelling; site of Surpanakha's encounter" ;
    .

:Godavari rdf:type :Place ;
    rdfs:label "Godavari" ;
    :description "Sacred river near Panchavati; Rama and his companions bathe here" ;
    .

:Saryu rdf:type :Place ;
    rdfs:label "Saryu" ;
    :description "Silver river at Ayodhya where Bharata bathes" ;
    .

:Himalaya rdf:type :Place ;
    rdfs:label "Himalaya" ;
    :description "Mountain range; described as the treasure-house of frost and cold; father of Uma/Parvati" ;
    .

:Ayodhya rdf:type :Place ;
    rdfs:label "Ayodhya" ;
    :description "Royal capital of Dasharatha's kingdom; where Bharata remains during Rama's exile" ;
    .

:Videha rdf:type :Place ;
    rdfs:label "Videha" ;
    :description "Kingdom of Sita's origin (Mithila); she is called the Videhan/Maithil dame" ;
    .

:Agastya's_Hermitage rdf:type :Place ;
    rdfs:label "Agastya's Hermitage" ;
    :description "The hermitage of sage Agastya from which Panchavati is four leagues away" ;
    .

:Rama's_Exile rdf:type :Event ;
    rdfs:label "Rama's Exile" ;
    :description "Rama's banishment to the forest by Dasharatha at Kaikeyi's behest; context for the entire narrative" ;
    .

:Agastya's_Counsel rdf:type :Event ;
    rdfs:label "Agastya's Counsel" ;
    :description "Canto XIII — Agastya directs Rama, Lakshmana, and Sita to settle in Panchavati" ;
    .

:Meeting_of_Jatayu rdf:type :Event ;
    rdfs:label "Meeting of Jatayu" ;
    :description "Canto XIV — Rama and Lakshmana encounter Jatayu, who reveals his lineage and pledges to guard Sita" ;
    .

:Building_of_the_Hermitage rdf:type :Event ;
    rdfs:label "Building of the Hermitage" ;
    :description "Canto XV (Panchavatí) — Lakshmana builds a cottage at Panchavati for Rama and Sita" ;
    .

:Winter_Description rdf:type :Event ;
    rdfs:label "Winter Description" ;
    :description "Canto XVI — Lakshmana describes the winter season to Rama while walking to the Godavari" ;
    .

:Surpanakha's_Arrival rdf:type :Event ;
    rdfs:label "Surpanakha's Arrival" ;
    :description "Canto XVII — Surpanakha, Ravana's sister, arrives at Panchavati and is captivated by Rama" ;
    .

:Jatayu's_Genealogy_Recitation rdf:type :Event ;
    rdfs:label "Jatayu's Genealogy Recitation" ;
    :description "Canto XIV — Jatayu narrates the primordial lineage of the Prajapatis, Kashyapa, and all creation" ;
    .

:Dharma rdf:type :Concept ;
    rdfs:label "Dharma" ;
    :description "Virtue and righteous duty; Rama is described as 'true to virtue's path'" ;
    .

:Four_Varnas rdf:type :Concept ;
    rdfs:label "Four Varnas" ;
    :description "The four human castes born of Manu — Brahmans (mouth), Kshatriyas (chest), Vaishyas (thighs), Shudras (feet)" ;
    .

:Amrita rdf:type :Concept ;
    rdfs:label "Amrita" ;
    :description "Divine nectar of immortality; Bharata's speech is compared to Amrita" ;
    .

:Prajapatis rdf:type :Concept ;
    rdfs:label "Prajapatis" ;
    :description "The great Lords of Life — first-born progenitors of all creation, recited by Jatayu" ;
    .

:Ramayana rdf:type :Text ;
    rdfs:label "Ramayana" ;
    :description "The epic Sanskrit narrative from which all these verses are drawn (Cantos XIII–XVII, verses 863–882)" ;
    .

:Sugreeva rdf:type :Character ;
    rdfs:label "Sugreeva" ;
    :description "Vanara king, younger brother of Bali, son of Riksharajas; exiled by Bali and later restored as king of Kishkindha with Rama's help; commands the army that searches for Sita" ;
    .

:Vali rdf:type :Character ;
    rdfs:label "Vali" ;
    :description "Vanara king of Kishkindha, eldest son of Riksharajas and Indra's son; possessor of a golden chain from Indra; slain by Rama's arrow while fighting Sugreeva" ;
    .

:Angad rdf:type :Character ;
    rdfs:label "Angad" ;
    :description "Son of Bali; heir apparent; leads the southern search party for Sita; noble, brave, and installed as co-ruler by Sugreeva" ;
    .

:Hanuman rdf:type :Character ;
    rdfs:label "Hanuman" ;
    :description "Son of the Wind God (Vayu); wisest and mightiest Vanara; entrusted with Rama's ring and the mission to find Sita; leaps across the ocean to Lanka" ;
    .

:Tara rdf:type :Character ;
    rdfs:label "Tara" ;
    :description "Queen of Bali; wife who counselled Bali not to fight; her name means 'star'; later reconciled with Sugreeva" ;
    .

:Ruma rdf:type :Character ;
    rdfs:label "Ruma" ;
    :description "Wife of Sugreeva, taken by Bali; restored to Sugreeva after Bali's fall" ;
    .

:Riksharajas rdf:type :Character ;
    rdfs:label "Riksharajas" ;
    :description "Father of Bali and Sugreeva; former Vanara king" ;
    .

:Jambavan rdf:type :Character ;
    rdfs:label "Jambavan" ;
    :description "Aged and mighty bear-king; leads the southern army; rallies Hanuman to leap to Lanka" ;
    .

:Nila rdf:type :Character ;
    rdfs:label "Nila" ;
    :description "Son of Fire (Agni); Vanara chief; sent by Sugreeva to assemble armies from the northern posts" ;
    .

:Susena rdf:type :Character ;
    rdfs:label "Susena" ;
    :description "Wise Vanara physician who heals Lakshmana; Sugreeva's general who searches the west" ;
    .

:Gandhamadan rdf:type :Character ;
    rdfs:label "Gandhamadan" ;
    :description "Vanara chief in the southern search party; encourages the Vanaras to renew their toil" ;
    .

:Satabali rdf:type :Character ;
    rdfs:label "Satabali" ;
    :description "Fierce Vanara chief sent to lead the northern search with vast armies" ;
    .

:Mainda rdf:type :Character ;
    rdfs:label "Mainda" ;
    :description "Vanara chief; listed among the leaders who accompany Rama back to Ayodhya" ;
    .

:Dvivida rdf:type :Character ;
    rdfs:label "Dvivida" ;
    :description "Vanara chief; listed among the leaders on the Pushpaka Vimana return journey" ;
    .

:Gavaksha rdf:type :Character ;
    rdfs:label "Gavaksha" ;
    :description "Vanara warrior in Rama's allied army" ;
    .

:Kausalya rdf:type :Character ;
    rdfs:label "Kausalya" ;
    :description "First queen of Dasharatha; Rama's mother; greeted on Rama's return" ;
    .

:Vibhishana rdf:type :Character ;
    rdfs:label "Vibhishana" ;
    :description "Righteous brother of Ravana; defects to Rama's side; provides crucial intelligence; crowned king of Lanka after Ravana's death; owns the Pushpaka Vimana after Ravana" ;
    .

:Mandodari rdf:type :Character ;
    rdfs:label "Mandodari" ;
    :description "Chief queen of Ravana; weeps at his death; seen by Sita/Rama on the Pushpaka flight back" ;
    .

:Indrajit rdf:type :Character ;
    rdfs:label "Indrajit" ;
    :description "Son of Ravana; also called Meghanada; powerful warrior who uses serpent-arrow weapon to wound Lakshmana" ;
    .

:Kumbhakarna rdf:type :Character ;
    rdfs:label "Kumbhakarna" ;
    :description "Giant brother of Ravana; sleeps for months; awakened for the Lanka battle; slain by Rama" ;
    .

:Khara rdf:type :Character ;
    rdfs:label "Khara" ;
    :description "Demon chief of Janasthana; brother of Ravana; slain by Rama in Dandaka forest" ;
    .

:Dushana rdf:type :Character ;
    rdfs:label "Dushana" ;
    :description "Demon commander under Khara in Janasthana; killed by Rama" ;
    .

:Trisiras rdf:type :Character ;
    rdfs:label "Trisiras" ;
    :description "Three-headed demon, companion of Khara in Janasthana battle" ;
    .

:Maricha rdf:type :Character ;
    rdfs:label "Maricha" ;
    :description "Uncle of Ravana; takes form of the golden deer to lure Rama away from Sita; killed by Rama's arrow" ;
    .

:Viradha rdf:type :Character ;
    rdfs:label "Viradha" ;
    :description "Demon of Dandaka forest; first monster Rama encounters in exile; slain by Rama" ;
    .

:Kabandha rdf:type :Character ;
    rdfs:label "Kabandha" ;
    :description "Giant headless demon with long arms; killed by Rama in the forest near Janasthana; directed Rama to Sugreeva" ;
    .

:Mayavi rdf:type :Character ;
    rdfs:label "Mayavi" ;
    :description "Demon son of Dundubhi; fought with Bali for a woman's love; fled into a cave; killed by Bali; his cave episode caused Sugreeva's exile" ;
    .

:Dundubhi rdf:type :Character ;
    rdfs:label "Dundubhi" ;
    :description "Buffalo-demon of mountain size; challenged Ocean and Himalaya to fight; finally met and slain by Bali; his carcass was thrown a league by Bali" ;
    .

:Matanga rdf:type :Character ;
    rdfs:label "Matanga" ;
    :description "Holy sage whose hermitage was defiled by Bali throwing Dundubhi's carcass; cursed Bali to die if he approached Rishyamuka; his grove sheltered Sugreeva safely" ;
    .

:Nishakar rdf:type :Character ;
    rdfs:label "Nishakar" ;
    :description "Ancient sage who did 8000 seasons of penance on Vindhya hill; encountered by Sampati in his story" ;
    .

:Svayamprabha rdf:type :Character ;
    rdfs:label "Svayamprabha" ;
    :description "Ascetic woman who guards Maya's enchanted cave (the golden forest) on behalf of the apsara Hema; leads the lost Vanaras out of the cave and to the ocean shore" ;
    .

:Maya rdf:type :Character ;
    rdfs:label "Maya" ;
    :description "Chief artificer of the Danava race; built the enchanted golden cave using skills obtained by penance from Brahma; killed by Indra's thunderbolt for loving Hema" ;
    .

:Matali rdf:type :Character ;
    rdfs:label "Matali" ;
    :description "Indra's charioteer; descends from heaven to lend Indra's divine chariot to Rama for the final battle with Ravana" ;
    .

:Suparsva rdf:type :Character ;
    rdfs:label "Suparsva" ;
    :description "Son of Sampati; brings Sampati food and reports seeing Ravana carrying Sita southward over the ocean" ;
    .

:Brahma rdf:type :Deity ;
    rdfs:label "Brahma" ;
    :description "Creator God; granted Maya the boon of knowledge; the Pushpaka Vimana is described as fashioned by his creative mind; dwells beyond the northern ocean" ;
    .

:Vishnu rdf:type :Deity ;
    rdfs:label "Vishnu" ;
    :description "Preserver God; his three strides symbolising the rising, zenith, and setting of the sun are referenced in the description of the eastern mountain (Jatarupam)" ;
    .

:Varuna rdf:type :Deity ;
    rdfs:label "Varuna" ;
    :description "God of the sea; his realm is the ocean; Sampati asks to be led to offer libations at the sea (Varuna's home)" ;
    .

:Kubera rdf:type :Deity ;
    rdfs:label "Kubera" ;
    :description "God of Wealth; brother of Ravana (son of Vishravas); his celestial palace on Kailasa is described in the northern search canto; the Pushpaka Vimana was originally his, seized by Ravana" ;
    .

:Vayu rdf:type :Deity ;
    rdfs:label "Vayu" ;
    :description "Wind God; father of Hanuman; Hanuman's might and speed are attributed to his divine parentage" ;
    .

:Surya rdf:type :Deity ;
    rdfs:label "Surya" ;
    :description "Sun God (Vivasvat); burns Sampati's wings in the myth of the brothers' flight; Agastya's hymn to Surya (Aditya Hridayam) is recited before the final battle" ;
    .

:Ananta rdf:type :Character ;
    rdfs:label "Ananta" ;
    :description "Also called Sesha; cosmic serpent with a thousand heads; supports the earth; described in the eastern search canto resting on Mount Jatarupam; gods bow to him" ;
    .

:Apsaras rdf:type :Deity ;
    rdfs:label "Apsaras" ;
    :description "Nymphs of Paradise; play in Kubera's lotus pools on Kailasa; Hema is an apsara for whom Maya's cave was built" ;
    .

:Hema rdf:type :Character ;
    rdfs:label "Hema" ;
    :description "Celestial nymph (apsara); for whose love Maya built the enchanted cave; after Indra killed Maya, Brahma bestowed the cave to Hema" ;
    .

:Kishkindha rdf:type :Place ;
    rdfs:label "Kishkindha" ;
    :description "Mountain city and capital of the Vanara kingdom; Bali's royal town; Sugreeva is restored as its king after Bali's death" ;
    .

:Rishyamuka rdf:type :Place ;
    rdfs:label "Rishyamuka" ;
    :description "Hill near Matanga's hermitage; Sugreeva lives here in exile because Matanga's curse prevents Bali from approaching; Rama first meets Sugreeva here" ;
    .

:Prasravana rdf:type :Place ;
    rdfs:label "Prasravana" ;
    :description "Hill near Kishkindha where Rama and Lakshmana spend the rainy season while waiting for Sugreeva to act on his promise" ;
    .

:Malyavat rdf:type :Place ;
    rdfs:label "Malyavat" ;
    :description "Mountain (possibly Malaya range) where Rama observes the onset of the rains and mourns Sita" ;
    .

:Vindhya rdf:type :Place ;
    rdfs:label "Vindhya" ;
    :description "Major mountain range in central India; the southern search army passes through it; Sampati falls on Vindhya after his wings are burnt" ;
    .

:Mahendra rdf:type :Place ;
    rdfs:label "Mahendra" ;
    :description "Mountain on the eastern coast; Hanuman takes his great leap to Lanka from Mahendra's peak; Sampati's son Suparsva stood on Mahendra and saw Ravana carrying Sita" ;
    .

:Lanka rdf:type :Place ;
    rdfs:label "Lanka" ;
    :description "Island city of Ravana; situated on Trikuta mountain surrounded by the southern ocean; built by Vishwakarma; captured after the great battle" ;
    .

:Trikuta rdf:type :Place ;
    rdfs:label "Trikuta" ;
    :description "Three-peaked mountain on which Lanka is enthroned; seen from the Pushpaka Vimana on Rama's return journey" ;
    .

:Nandigrama rdf:type :Place ;
    rdfs:label "Nandigrama" ;
    :description "Village where Bharata waits in austerity with Rama's sandals on the throne; from which Bharata goes out to meet Rama" ;
    .

:Dandaka rdf:type :Place ;
    rdfs:label "Dandaka" ;
    :description "Forest where Rama spent exile; Viradha, Surpanakha encounter, Jatayu's death all occur here" ;
    .

:Janasthana rdf:type :Place ;
    rdfs:label "Janasthana" ;
    :description "Part of Dandaka forest; Khara's base; where Jatayu died fighting Ravana" ;
    .

:Pampa rdf:type :Place ;
    rdfs:label "Pampa" ;
    :description "Lotus-covered lake near Rishyamuka where Rama mourns Sita in the melancholy season" ;
    .

:Kailasa rdf:type :Place ;
    rdfs:label "Kailasa" ;
    :description "Mountain of Shiva; also site of Kubera's palace; described in the northern search canto" ;
    .

:Meru rdf:type :Place ;
    rdfs:label "Meru" ;
    :description "Cosmic golden mountain at the centre of Jambudvipa; Vishnu's second step rests on its crest; 84,000 yojanas high" ;
    .

:Gomati rdf:type :Place ;
    rdfs:label "Gomati" ;
    :description "River near Ayodhya; the Pushpaka crosses it as it returns" ;
    .

:Narmada rdf:type :Place ;
    rdfs:label "Narmada" ;
    :description "River (modern Nerbudda) in the southern search route; Sugreeva directs the search army through its valley" ;
    .

:Maya's_Enchanted_Cave rdf:type :Place ;
    rdfs:label "Maya's Enchanted Cave" ;
    :description "Magical underground forest of golden trees and silver streams built by the Danava architect Maya; guarded by Svayamprabha; the Vanaras wander in it for a month" ;
    .

:Jambudvipa rdf:type :Place ;
    rdfs:label "Jambudvipa" ;
    :description "The central continent; contains Meru at its centre; referenced in the description of the cosmic geography during the eastern search" ;
    .

:North_Kurus rdf:type :Place ;
    rdfs:label "North Kurus" ;
    :description "Blessed northern land of the holy spirits; described in the northern search canto as a paradise of golden lilies, pearl-decked maidens, and jewelled streams" ;
    .

:Sugreeva's_Exile rdf:type :Event ;
    rdfs:label "Sugreeva's Exile" ;
    :description "Canto IX — Sugreeva narrates how Bali drove him from the kingdom after mistakenly believing Sugreeva had usurped the throne while Bali was in Mayavi's cave" ;
    .

:Dundubhi_Episode rdf:type :Event ;
    rdfs:label "Dundubhi Episode" ;
    :description "Canto XI — Bali kills the buffalo-demon Dundubhi; the carcass thrown near Matanga's hermitage; Matanga's curse prevents Bali from entering Rishyamuka" ;
    .

:Test_of_the_Palm_Trees rdf:type :Event ;
    rdfs:label "Test of the Palm Trees" ;
    :description "Canto XII — Rama pierces seven palm trees with one arrow to prove his might to the doubting Sugreeva; the arrow passes through six subterranean realms and returns to the quiver" ;
    .

:Rama_Sugreeva_Alliance rdf:type :Event ;
    rdfs:label "Rama-Sugreeva Alliance" ;
    :description "Alliance forged between Rama and Sugreeva: Rama will slay Bali; Sugreeva will help find Sita" ;
    .

:First_Battle_of_Bali_and_Sugreeva rdf:type :Event ;
    rdfs:label "First Battle of Bali and Sugreeva" ;
    :description "Canto XII — Sugreeva challenges Bali; Rama cannot shoot because the brothers look identical; Sugreeva retreats to Rishyamuka wounded" ;
    .

:Fall_of_Bali rdf:type :Event ;
    rdfs:label "Fall of Bali" ;
    :description "Canto XVI — Rama's arrow pierces Bali's chest while Bali fights Sugreeva (wearing a garland to distinguish him); Bali delivers his famous speech before dying" ;
    .

:Bali's_Speech rdf:type :Event ;
    rdfs:label "Bali's Speech" ;
    :description "Canto XVII — Dying Bali rebukes Rama for shooting from hiding; Rama explains the justice of the act; Bali is reconciled and dies attaining Brahma's worlds" ;
    .

:Sugreeva's_Coronation rdf:type :Event ;
    rdfs:label "Sugreeva's Coronation" ;
    :description "Canto XXVI — Sugreeva is anointed king of Kishkindha with full Aryan coronation rites; Angad is made co-ruler; Rama cannot enter the city due to his 14-year forest vow" ;
    .

:Rainy_Season_on_Prasravana rdf:type :Event ;
    rdfs:label "Rainy Season on Prasravana" ;
    :description "Cantos XXVII-XXVIII — Rama and Lakshmana spend the four-month rainy season in a cave on Prasravana hill; Rama mourns Sita" ;
    .

:Hanuman's_Counsel_to_Sugreeva rdf:type :Event ;
    rdfs:label "Hanuman's Counsel to Sugreeva" ;
    :description "Canto XXIX — Hanuman rebukes the pleasure-absorbed Sugreeva and urges him to repay Rama's help by launching the search" ;
    .

:Dispatch_of_Search_Armies rdf:type :Event ;
    rdfs:label "Dispatch of Search Armies" ;
    :description "Cantos XL-XLIII — Sugreeva sends four armies to the east, south, west, and north to search for Sita; describes cosmic geography of all four directions" ;
    .

:Hanuman_Given_Rama's_Ring rdf:type :Event ;
    rdfs:label "Hanuman Given Rama's Ring" ;
    :description "Canto XLIV — Rama gives Hanuman his signet ring as a token for Sita; gives special counsel to Hanuman above all others" ;
    .

:Sampati_Episode rdf:type :Event ;
    rdfs:label "Sampati Episode" ;
    :description "Cantos LVI-LX — Sampati, brother of Jatayu, reveals Sita's location in Ravana's Lanka after hearing of Jatayu's death; his son Suparsva had seen Ravana carrying Sita" ;
    .

:Enchanted_Cave_Episode rdf:type :Event ;
    rdfs:label "Enchanted Cave Episode" ;
    :description "Cantos L-LII — The southern army stumbles into Maya's magic cave, wanders for a month; Svayamprabha feeds them and miraculously leads them out" ;
    .

:Hanuman's_Leap_to_Lanka rdf:type :Event ;
    rdfs:label "Hanuman's Leap to Lanka" ;
    :description "Hanuman takes his great leap of 100 leagues across the ocean from Mahendra's peak to Lanka; passes through sky, meets obstacles" ;
    .

:Hanuman_Finds_Sita rdf:type :Event ;
    rdfs:label "Hanuman Finds Sita" ;
    :description "Hanuman locates Sita imprisoned in Ravana's Ashoka grove in Lanka; gives her Rama's ring; receives Chudamani jewel for Rama" ;
    .

:Lanka_Burns rdf:type :Event ;
    rdfs:label "Lanka Burns" ;
    :description "After Ravana's court burns Hanuman's tail, Hanuman sets Lanka ablaze before returning to report to Rama" ;
    .

:Building_of_the_Bridge rdf:type :Event ;
    rdfs:label "Building of the Bridge" ;
    :description "Nala (son of Vishwakarma) architects a bridge 100 leagues long across the ocean from the Indian shore to Lanka; the Vanara armies cross it" ;
    .

:Battle_of_Lanka rdf:type :Event ;
    rdfs:label "Battle of Lanka" ;
    :description "The great battle between Rama's Vanara-bear army and Ravana's demon forces at Lanka; spanning many cantos; includes deaths of Indrajit, Kumbhakarna, and finally Ravana" ;
    .

:Lakshmana_Healed rdf:type :Event ;
    rdfs:label "Lakshmana Healed" ;
    :description "Canto CII — Lakshmana is gravely wounded by a serpent-weapon; Hanuman flies to Mahodaya/Himalaya, uproots the entire peak carrying healing herbs; Susena heals Lakshmana" ;
    .

:Indra's_Chariot_for_Rama rdf:type :Event ;
    rdfs:label "Indra's Chariot for Rama" ;
    :description "Canto CIII — Indra sends his divine chariot with Matali as charioteer so Rama can fight Ravana on equal footing from a chariot" ;
    .

:Aditya_Hridayam rdf:type :Event ;
    rdfs:label "Aditya Hridayam" ;
    :description "Canto CVI — Agastya appears on the battlefield and recites the Aditya Hridayam (hymn to the Sun) to Rama, infusing him with strength for the final duel with Ravana" ;
    .

:Ravana_Slain rdf:type :Event ;
    rdfs:label "Ravana Slain" ;
    :description "Rama slays the ten-headed Ravana with the divine Brahmastra arrow described by Agastya; the world is freed from the demon's tyranny" ;
    .

:Return_on_Pushpaka_Vimana rdf:type :Event ;
    rdfs:label "Return on Pushpaka Vimana" ;
    :description "Cantos CXXIII-CXXV — Vibhishana gives the divine chariot Pushpaka to Rama; Rama, Sita, Lakshmana, Sugreeva, Vibhishana, and their allies fly back to Ayodhya; Rama points out landmarks below" ;
    .

:Meeting_with_Bharata rdf:type :Event ;
    rdfs:label "Meeting with Bharata" ;
    :description "Canto CXXIX — Rama lands at Nandigrama; emotional reunion with Bharata who has kept the sandals; Rama is joyfully welcomed back to Ayodhya" ;
    .

:Pushpaka_Vimana rdf:type :Concept ;
    rdfs:label "Pushpaka Vimana" ;
    :description "Divine flying chariot originally owned by Kubera, seized by Ravana; gifted by Vibhishana to Rama after the victory; carries Rama's entire party back to Ayodhya" ;
    .

:Nala's_Bridge_(Setu) rdf:type :Concept ;
    rdfs:label "Nala's Bridge (Setu)" ;
    :description "Bridge built by Nala across 100 leagues of ocean from the Indian coast to Lanka; sacred to all worlds for all time; Hanuman rests on Hiranyanabha/Mainaka island midway" ;
    .

:Rama's_Signet_Ring rdf:type :Concept ;
    rdfs:label "Rama's Signet Ring" ;
    :description "Token given by Rama to Hanuman as proof of identity for Sita; bears Rama's name; Sita recognises it and trusts Hanuman" ;
    .

:Bali's_Golden_Chain rdf:type :Concept ;
    rdfs:label "Bali's Golden Chain" ;
    :description "Golden chain given to Bali by his father Indra/Mahendra as a divine gift; preserved Bali's life even as he lay wounded; still gleaming as he died" ;
    .

:Brahmastra rdf:type :Concept ;
    rdfs:label "Brahmastra" ;
    :description "Supreme divine weapon used by Rama to slay Ravana in the final duel; its impact is described as like Yama's discus ending the world" ;
    .

:Abhisheka rdf:type :Concept ;
    rdfs:label "Abhisheka" ;
    :description "Royal coronation rite performed for Sugreeva at Kishkindha and anticipated for Rama at Ayodhya; involves sacred water poured by Vanara chiefs" ;
    .

:Exile_(Vanavasa) rdf:type :Concept ;
    rdfs:label "Exile (Vanavasa)" ;
    :description "Fourteen-year forest exile of Rama; the vow that prevents him from entering cities during this period; context for the entire Kishkindha and Lanka episodes" ;
    .

:Aditya_Hridayam_Hymn rdf:type :Text ;
    rdfs:label "Aditya Hridayam Hymn" ;
    :description "Sacred hymn to the Sun recited by Agastya to Rama before the final battle; embedded within the Ramayana" ;
    .

:Sama_Veda rdf:type :Text ;
    rdfs:label "Sama Veda" ;
    :description "Third of the four Vedas; its sacred chants begin in the Sravana/rainy month; mentioned in the description of the rainy season" ;
    .

:Self_existent_God rdf:type :Deity ;
    rdfs:label "Self-existent God" ;
    :description "Supreme deity void of all fear, compared to Ráma's fearlessness" ;
    .

:Sun rdf:type :Deity ;
    rdfs:label "Sun" ;
    :description "Light's Queen clings to Sun as Ráma to Sítá, swords rival sun in sheen" ;
    .

:Lakshmí rdf:type :Deity ;
    rdfs:label "Lakshmí" ;
    :description "Goddess of wealth and prosperity, love shown in Ráma's bright abode" ;
    .

:Agni rdf:type :Deity ;
    rdfs:label "Agni" ;
    :description "Fire God, worship due to him shown to Suyajña" ;
    .

:Stern_Fate rdf:type :Deity ;
    rdfs:label "Stern Fate" ;
    :description "Force whose favor must be won through duty" ;
    .

:Suyajña rdf:type :Character ;
    rdfs:label "Suyajña" ;
    :description "Son of Vasishtha, of Bráhman race, first and holiest one, wise, knew Scripture, found in hall of Fire, performed noonday rites" ;
    .

:Kushika's_son rdf:type :Character ;
    rdfs:label "Kushika's son" ;
    :description "Best of Bráhmans, likely Vishvámitra, to receive gifts" ;
    .

:Chief_of_Taittiríya_sect rdf:type :Character ;
    rdfs:label "Chief of Taittiríya sect" ;
    :description "Deep in Scripture, serves Kausalyá with blessing and respect, true to queen" ;
    .

:Chitraratha rdf:type :Character ;
    rdfs:label "Chitraratha" ;
    :description "Tuneful bard and charioteer, true and dear, ancient friend and minister of Ráma" ;
    .

:Grammarians rdf:type :Character ;
    rdfs:label "Grammarians" ;
    :description "Numerous band who go with staff in hand, trained, prize deep study, love dainty fare, praised by good" ;
    .

:Trijata rdf:type :Character ;
    rdfs:label "Trijata" ;
    :description "Aged Bráhman born of Garga's race, long in evil case, earned living with spade and plough, poor with many children" ;
    .

:Trijata's_wife rdf:type :Character ;
    rdfs:label "Trijata's wife" ;
    :description "Young wife who bore babes, felt indigence, counseled husband to seek Ráma" ;
    .

:Brighu rdf:type :Character ;
    rdfs:label "Brighu" ;
    :description "Divine Prajápati first created by Brahmá, bright with saintly light" ;
    .

:Sávitrí rdf:type :Character ;
    rdfs:label "Sávitrí" ;
    :description "Woman who gave all to Satyaván in heart/body/soul/mind, exemplar of wifely devotion" ;
    .

:Satyaván rdf:type :Character ;
    rdfs:label "Satyaván" ;
    :description "Son of Dyumatsena, husband to whom Sávitrí was devoted" ;
    .

:Dyumatsena rdf:type :Character ;
    rdfs:label "Dyumatsena" ;
    :description "Father of Satyaván" ;
    .

:Ashvapati rdf:type :Character ;
    rdfs:label "Ashvapati" ;
    :description "Father of Kaikeyí" ;
    .

:Forest/Woods/Dandaka rdf:type :Place ;
    rdfs:label "Forest/Woods/Dandaka" ;
    :description "Wilderness full of woes: snakes, scorpions, flies, thorny trees, tangled grass, where elephant and roebuck roam, pathless wild, lonely shade, greenwood" ;
    .

:Ráma's_house/abode rdf:type :Place ;
    rdfs:label "Ráma's house/abode" ;
    :description "Bright dwelling rich in Lakshmí's love, five courts, where treasures distributed, where Sítá prepared to give wealth" ;
    .

:Preceptor's_hall rdf:type :Place ;
    rdfs:label "Preceptor's hall" ;
    :description "Teacher's hall where celestial arms preserved with care" ;
    .

:Hall_of_Fire rdf:type :Place ;
    rdfs:label "Hall of Fire" ;
    :description "Chapel where sacred fire used in worship is kept, where Suyajña found" ;
    .

:Sarjú_river rdf:type :Place ;
    rdfs:label "Sarjú river" ;
    :description "River with banks where herds of kine fed, farther bank where Trijata's staff landed" ;
    .

:Trijata's_cottage rdf:type :Place ;
    rdfs:label "Trijata's cottage" ;
    :description "Dwelling in grove where cows driven, home of poor Bráhman" ;
    .

:Heaven/worlds_of_Gods rdf:type :Place ;
    rdfs:label "Heaven/worlds of Gods" ;
    :description "Homes of Gods, celestial sphere ruled by Indra, worlds where devoted sons win place, Brahmá's glorious sphere" ;
    .

:Forest_perils rdf:type :Concept ;
    rdfs:label "Forest perils" ;
    :description "Woes of wilderness: snakes, scorpions, grasshoppers, flies, thorny bushes, tangled grass, fatigue, countless fears, grief and pain" ;
    .

:Hermit_life rdf:type :Concept ;
    rdfs:label "Hermit life" ;
    :description "Penance with every thought, no fear of things to fear, forever drear, coat of bark and matted hair, roots/fruit/honey as food" ;
    .

:Wifely_devotion rdf:type :Concept ;
    rdfs:label "Wifely devotion" ;
    :description "Woman follows husband as Sávitrí followed Satyaván, wife committed to husband in heart/body/soul/mind, husband is God" ;
    .

:Bráhmans'_prophecy rdf:type :Concept ;
    rdfs:label "Bráhmans' prophecy" ;
    :description "Truth-declaring Bráhmans foretold Sítá's fortune to dwell in wood, knew future by marks and signs" ;
    .

:Scripture_text rdf:type :Concept ;
    rdfs:label "Scripture text" ;
    :description "Ancient teaching that woman given by parents with holy rites is wife in this world and after life" ;
    .

:Filial_duty rdf:type :Concept ;
    rdfs:label "Filial duty" ;
    :description "Supreme duty to obey sire and mother, triple world comprises father/mother/holy guide, sonly love and reverence storms heaven" ;
    .

:Celestial_arms rdf:type :Concept ;
    rdfs:label "Celestial arms" ;
    :description "Two fearful bows given by Varuna to Janak, sword-proof mail, quivers with arrows that never fail, golden-hilted swords keen as sun" ;
    .

:Treasure_distribution rdf:type :Concept ;
    rdfs:label "Treasure distribution" ;
    :description "Gold, silver, gems, pearls, necklaces, girdles, bracelets, beds, elephants, thousand coins, kine given to Bráhmans and servants" ;
    .

:Sacred_girdle rdf:type :Concept ;
    rdfs:label "Sacred girdle" ;
    :description "Worn by those who wait on Kausalyá with care, mark of Bráhman status" ;
    .

:Ráma's_forest_warnings rdf:type :Event ;
    rdfs:label "Ráma's forest warnings" ;
    :description "Ráma described perils: snakes, scorpions, thorny trees, hope/anger cast aside, penance required, deemed Sítá unfit" ;
    .

:Sítá's_appeal rdf:type :Event ;
    rdfs:label "Sítá's appeal" ;
    :description "Lady with deep distress begged to accompany, cited love, father's command, Bráhmans' prophecy, threatened death if refused" ;
    .

:Sítá's_taunting rdf:type :Event ;
    rdfs:label "Sítá's taunting" ;
    :description "Daughter of Videha's king accused Ráma of being woman in disguise, likened to low actor, spirit tried by fear/anger/love/pride" ;
    .

:Ráma's_surrender rdf:type :Event ;
    rdfs:label "Ráma's surrender" ;
    :description "Hero's heart reconciled to take Sítá to Dandaka, embraced wife, sweet words bid her wake to life, approved her going" ;
    .

:Lakshmana's_prayer rdf:type :Event ;
    rdfs:label "Lakshmana's prayer" ;
    :description "Brother pressed Ráma's feet with fervor, begged to follow to woods with bow, would go before, carry basket/spade, guard sleeping" ;
    .

:Ráma's_instructions_to_Lakshmana rdf:type :Event ;
    rdfs:label "Ráma's instructions to Lakshmana" ;
    :description "Commanded brother to bid adieu, bring celestial bows from preceptor's hall, summon Suyajña, bestow wealth on Bráhmans" ;
    .

:Wealth_distribution_ceremony rdf:type :Event ;
    rdfs:label "Wealth distribution ceremony" ;
    :description "Ráma honored Suyajña with gems/pearls, gave gifts to Agastya/Kushika's son/Bráhmans/servants, distributed gold/silver/cows/elephants" ;
    .

:Trijata's_petition rdf:type :Event ;
    rdfs:label "Trijata's petition" ;
    :description "Poor aged Bráhman came to fifth court, described poverty, Ráma tested with staff-throw, gave thousand kine and wealth" ;
    .

:Journey_to_see_king rdf:type :Event ;
    rdfs:label "Journey to see king" ;
    :description "Sítá and princes with celestial arms went to monarch's house, crowds gathered on houses/terraces mourning" ;
    .

:Fire rdf:type :Deity ;
    rdfs:label "Fire" ;
    :description "Deity to whom oblations and offerings are burnt" ;
    .

:Wind_God rdf:type :Deity ;
    rdfs:label "Wind God" ;
    :description "Free spirit pervading all life, God who roves at will, wooed hundred daughters, bent them when rejected" ;
    .

:Sylvan_deities rdf:type :Deity ;
    rdfs:label "Sylvan deities" ;
    :description "Forest spirits addressed by Vishvámitra at Perfect Grove" ;
    .

:Chúli rdf:type :Character ;
    rdfs:label "Chúli" ;
    :description "Devoutest sage, most continent, glorious saint absorbed in penance, spiritual father of Brahmadatta" ;
    .

:Somadá rdf:type :Character ;
    rdfs:label "Somadá" ;
    :description "Heavenly maid, child of Urmilá, served Chúli, mother of Brahmadatta, lived unwed maiden life" ;
    .

:Richíka rdf:type :Character ;
    rdfs:label "Richíka" ;
    :description "Great sage, husband of Satyavatí" ;
    .

:Satyavatí rdf:type :Character ;
    rdfs:label "Satyavatí" ;
    :description "Elder sister of Vishvámitra, pure and good, married to Richíka, became celestial river Kaushikí" ;
    .

:Márícha rdf:type :Character ;
    rdfs:label "Márícha" ;
    :description "Rover of the Night, demon, man-eater foul of mind, struck by Ráma's arrow, hurled hundred leagues into ocean" ;
    .

:Suváhu rdf:type :Character ;
    rdfs:label "Suváhu" ;
    :description "Rover of the Night, demon who showered blood, killed by Ráma's flaming arrow" ;
    .

:Demon_train rdf:type :Character ;
    rdfs:label "Demon train" ;
    :description "Fiends accompanying Márícha and Suváhu, disturbers of holy rites, overthrown by Ráma" ;
    .

:Kushámba rdf:type :Character ;
    rdfs:label "Kushámba" ;
    :description "Prince of high renown, son of Kusha, builder of Kaushambí town" ;
    .

:Amúrtarajas rdf:type :Character ;
    rdfs:label "Amúrtarajas" ;
    :description "Son of Kusha, dwelt in Dharmáranya's citadel" ;
    .

:Vasu rdf:type :Character ;
    rdfs:label "Vasu" ;
    :description "Son of Kusha, built city Girivraja, ruled fertile Magadh's broad champaign" ;
    .

:Brahmadatta rdf:type :Character ;
    rdfs:label "Brahmadatta" ;
    :description "Spiritual son of Chúli, rich and great king, ruled Kámpilí, married hundred daughters of Kushanábha" ;
    .

:Sagara rdf:type :Character ;
    rdfs:label "Sagara" ;
    :description "Pious monarch of Ayodhyá in days of yore, childless, longed for children" ;
    .

:Keshini rdf:type :Character ;
    rdfs:label "Keshini" ;
    :description "Fair-faced consort of Sagar, sprang from Vidarbha's royal race, famed for truth from youth" ;
    .

:Lomapád rdf:type :Character ;
    rdfs:label "Lomapád" ;
    :description "King mentioned in context, likely ruler referenced" ;
    .

:Hundred_daughters rdf:type :Character ;
    rdfs:label "Hundred daughters" ;
    :description "Daughters of Kushanábha born to Queen Ghritáchí, lovely-faced with every charm, bent by Wind God, married to Brahmadatta" ;
    .

:Ghritáchí rdf:type :Character ;
    rdfs:label "Ghritáchí" ;
    :description "Nymph most fair, queen married to Kushanábha, mother of hundred daughters" ;
    .

:Ganga rdf:type :Character ;
    rdfs:label "Ganga" ;
    :description "Elder daughter of Himálaya and Mená, three-pathed river, purges sinners, cleanse and save, Rivers' Queen, also called Jáhnaví" ;
    .

:Umá rdf:type :Character ;
    rdfs:label "Umá" ;
    :description "Younger daughter of Himálaya, passed long time in vows and rigid fast, became Rudra's bride, supreme among Goddesses" ;
    .

:Mená rdf:type :Character ;
    rdfs:label "Mená" ;
    :description "Mother of Gangá and Umá, offspring of will of Meru, Himálaya's darling, beauty of dainty waist" ;
    .

:Perfect_Grove rdf:type :Place ;
    rdfs:label "Perfect Grove" ;
    :description "Consecrated wood, holy hermitage, perfect seat, dwelling of hermits, scene of Vishvámitra's sacrifice" ;
    .

:Mithila rdf:type :Place ;
    rdfs:label "Mithila" ;
    :description "Fertile land ruled by King Janak, location of planned sacrifice, where wondrous bow is kept" ;
    .

:Gangá's_northern_shore rdf:type :Place ;
    rdfs:label "Gangá's northern shore" ;
    :description "Beneath Himálaya's snowy peaks, destination of Vishvámitra's journey" ;
    .

:Sona_river rdf:type :Place ;
    rdfs:label "Sona river" ;
    :description "River where travelers halted, distant shore, also called Hiranyaráhu/Hiranyaráha (Golden-armed/Auriferous)" ;
    .

:Kaushambí rdf:type :Place ;
    rdfs:label "Kaushambí" ;
    :description "Town built by Kushámba" ;
    .

:Mahodaya rdf:type :Place ;
    rdfs:label "Mahodaya" ;
    :description "City with high towers raised by Kushanábha, another name of Kanyakubja" ;
    .

:Dharmáranya rdf:type :Place ;
    rdfs:label "Dharmáranya" ;
    :description "Citadel where Amúrtarajas chose to dwell, wood to which God of Justice fled" ;
    .

:Girivraja rdf:type :Place ;
    rdfs:label "Girivraja" ;
    :description "City built by Vasu, in Magadh neighbourhood" ;
    .

:Magadh rdf:type :Place ;
    rdfs:label "Magadh" ;
    :description "Vasu's old domain, fertile broad champaign with smiling fields adorned with golden corn" ;
    .

:Sumágadhí rdf:type :Place ;
    rdfs:label "Sumágadhí" ;
    :description "Lovely rill bursting from parent hill, flows between mountains like wreath, roves through Magadh's plains" ;
    .

:Kanyákubja rdf:type :Place ;
    rdfs:label "Kanyákubja" ;
    :description "City of Bent Virgins, modern Kanauj/Canouge, royal town named after Wind God bent maidens" ;
    .

:Kámpilí rdf:type :Place ;
    rdfs:label "Kámpilí" ;
    :description "Fortunate metropolis where King Brahmadatta maintained his state" ;
    .

:Brahmá's_world rdf:type :Place ;
    rdfs:label "Brahmá's world" ;
    :description "World of endless light where Kusha vanished to" ;
    .

:Zona rdf:type :Place ;
    rdfs:label "Zona" ;
    :description "River with distant shore, pleasant shore where night was passed" ;
    .

:Jáhnaví rdf:type :Place ;
    rdfs:label "Jáhnaví" ;
    :description "Another name for River Gangá, hermit-haunted flood, Rivers' Queen, daughter of Jahnu" ;
    .

:Vidarbha rdf:type :Place ;
    rdfs:label "Vidarbha" ;
    :description "Royal race from which Kushanábha's bride and Keshini came, modern Berar" ;
    .

:Initiatory_rites rdf:type :Concept ;
    rdfs:label "Initiatory rites" ;
    :description "High preliminary rite, Díkshá, ceremonies preliminary to sacrifice" ;
    .

:Dikshá rdf:type :Concept ;
    rdfs:label "Dikshá" ;
    :description "Certain ceremonies preliminary to sacrifice, period of speaking to none" ;
    .

:Wondrous_bow rdf:type :Concept ;
    rdfs:label "Wondrous bow" ;
    :description "Terrific vast bow of matchless might, given by assembled Gods to Janak, no giant/fiend/God can string it" ;
    .

:Imperial_sacrifice rdf:type :Concept ;
    rdfs:label "Imperial sacrifice" ;
    :description "Rite through which Janak gained the wondrous bow from Gods" ;
    .

:Lustral_water rdf:type :Concept ;
    rdfs:label "Lustral water" ;
    :description "Water from brook used for purification in morning worship" ;
    .

:Oblations rdf:type :Concept ;
    rdfs:label "Oblations" ;
    :description "Offerings paid to Fire, God and shade as per Scripture" ;
    .

:Morning_rites rdf:type :Concept ;
    rdfs:label "Morning rites" ;
    :description "Daily duties performed at dawn, including purification and prayer" ;
    .

:Sacred_oil rdf:type :Concept ;
    rdfs:label "Sacred oil" ;
    :description "Oil supplied to flame for sacrifice" ;
    .

:Mystic_spell rdf:type :Concept ;
    rdfs:label "Mystic spell" ;
    :description "Magic power winged on Ráma's arrows" ;
    .

:Wind_God's_dart rdf:type :Concept ;
    rdfs:label "Wind-God's dart" ;
    :description "Arrow belonging to Wind God, used by Ráma" ;
    .

:Chill_pointed_weapon rdf:type :Concept ;
    rdfs:label "Chill-pointed weapon" ;
    :description "Mortal dart that strikes numbing chill but leaves breathing" ;
    .

:Amrit rdf:type :Concept ;
    rdfs:label "Amrit" ;
    :description "Sweet nectar like substance, oil compared to it" ;
    .

:Three_pathed_Gangá rdf:type :Concept ;
    rdfs:label "Three-pathed Gangá" ;
    :description "Gangá flowing in three paths/realms, purifying and blessing" ;
    .

:Scripture rdf:type :Text ;
    rdfs:label "Scripture" ;
    :description "Holy texts dictating bathing and ritual procedures" ;
    .

:Vishvámitra's_sacrifice rdf:type :Event ;
    rdfs:label "Vishvámitra's sacrifice" ;
    :description "Holy rite conducted by Vishvámitra at Perfect Grove, protected by Ráma and Lakshmana" ;
    .

:Six_day_watch rdf:type :Event ;
    rdfs:label "Six-day watch" ;
    :description "Ráma and Lakshmana kept watch for six days and nights to guard sacrifice" ;
    .

:Demon_attack rdf:type :Event ;
    rdfs:label "Demon attack" ;
    :description "Márícha and Suváhu with demon train rushed on sacrifice, showering blood" ;
    .

:Battle_with_demons rdf:type :Event ;
    rdfs:label "Battle with demons" ;
    :description "Ráma slew demons disturbing sacrifice, using mystic arrows" ;
    .

:Journey_to_Míthilá rdf:type :Event ;
    rdfs:label "Journey to Míthilá" ;
    :description "Vishvámitra leads saints and princes to see Janak's sacrifice and wondrous bow" ;
    .

:Departure_from_Perfect_Grove rdf:type :Event ;
    rdfs:label "Departure from Perfect Grove" ;
    :description "Vishvámitra and company leave hermitage traveling north to Gangá's shore" ;
    .

:Halt_at_Sona rdf:type :Event ;
    rdfs:label "Halt at Sona" ;
    :description "Travelers made halt on Sona's distant shore at sunset" ;
    .

:Wind_God's_wooing rdf:type :Event ;
    rdfs:label "Wind God's wooing" ;
    :description "Wind God proposed to hundred daughters, bent them when rejected" ;
    .

:Marriage_of_hundred_daughters rdf:type :Event ;
    rdfs:label "Marriage of hundred daughters" ;
    :description "Kushanábha gave all hundred daughters to Brahmadatta, deformity removed upon marriage" ;
    .

:Birth_of_Gádhi rdf:type :Event ;
    rdfs:label "Birth of Gádhi" ;
    :description "Kushanábha gained son Gádhi through sacrifice, as foretold by Kusha" ;
    .

:Marriage_of_Satyavatí rdf:type :Event ;
    rdfs:label "Marriage of Satyavatí" ;
    :description "Satyavatí wed to Richíka, followed him in death, became celestial river" ;
    .

:Transformation_of_Satyavatí rdf:type :Event ;
    rdfs:label "Transformation of Satyavatí" ;
    :description "Satyavatí raised to heaven in human frame, became pure celestial stream from Himálaya" ;
    .

:Birth_of_Gangá_and_Umá rdf:type :Event ;
    rdfs:label "Birth of Gangá and Umá" ;
    :description "Himálaya and Mená bore two daughters: Gangá (elder) and Umá" ;
    .

:Gods'_request_for_Gangá rdf:type :Event ;
    rdfs:label "Gods' request for Gangá" ;
    :description "All Gods came to Himálaya praying for Gangá to help speed their vows" ;
    .

:Gangá_given_to_Gods rdf:type :Event ;
    rdfs:label "Gangá given to Gods" ;
    :description "Himálaya gave Gangá to Immortals for weal of three worlds" ;
    .

:Marriage_of_Umá rdf:type :Event ;
    rdfs:label "Marriage of Umá" ;
    :description "After vows and rigid fast, Umá given to immortal Rudra as bride" ;
    .

