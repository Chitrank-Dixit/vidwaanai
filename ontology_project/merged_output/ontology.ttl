    :description "Son of Devarát" ;
    .

:Mahábír rdf:type :Character ;
    rdfs:label "Mahábír" ;
    :description "Son of Vrihadratha, splendid hero who governed long in glory" ;
    .

:Sudhriti rdf:type :Character ;
    rdfs:label "Sudhriti" ;
    :description "Son of Mahábír, youth firm in purpose, brave" ;
    .

:Dhrishmaketu rdf:type :Character ;
    rdfs:label "Dhrishmaketu" ;
    :description "Son of Sudhriti, blessed with pious will and holy breast, won fame of royal saint" ;
    .

:Haryashva rdf:type :Character ;
    rdfs:label "Haryashva" ;
    :description "Son of Dhrishmaketu, princely" ;
    .

:Maru_(Videha) rdf:type :Character ;
