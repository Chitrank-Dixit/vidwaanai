    :description "Son of Pratíndhak, known for gentle virtues" ;
    .

:Devamidha rdf:type :Character ;
    rdfs:label "Devamidha" ;
    :description "Son of Kírtiratha" ;
    .

:Vibudh rdf:type :Character ;
    rdfs:label "Vibudh" ;
    :description "Son of Devamidha" ;
    .

:Mahándhrak rdf:type :Character ;
    rdfs:label "Mahándhrak" ;
    :description "Son of Vibudh" ;
    .

:Kírtirát rdf:type :Character ;
    rdfs:label "Kírtirát" ;
    :description "Son of Mahándhrak, of boundless might, loved the right, sainted king" ;
    .

:Maháromá rdf:type :Character ;
    rdfs:label "Maháromá" ;
    :description "Son of Kírtirát" ;
    .

:Swarnaromá rdf:type :Character ;
    rdfs:label "Swarnaromá" ;
    :description "Son of Maháromá" ;
    .

:Hrasvaromá rdf:type :Character ;
    rdfs:label "Hrasvaromá" ;
    :description "Son of Swarnaromá, good and great, father of Janak and Kushadhwaj" ;
    .

:Sudáman rdf:type :Character ;
    rdfs:label "Sudáman" ;
    :description "Best of councillors, sent by Janak to guide Dasharatha" ;
    .

:Kálindi rdf:type :Character ;
    rdfs:label "Kálindi" ;
    :description "Widowed queen with lotus eyes, other wife of Asit, mother of Sagar, received boon from Chyavan" ;
    .

:Rival_wife rdf:type :Character ;
    rdfs:label "Rival wife" ;
    :description "Wife of Asit who mixed poison to prevent conception" ;
    .

:Sudhanvá rdf:type :Character ;
    rdfs:label "Sudhanvá" ;
    :description "Mighty lord of Sánkáshyá, threatened siege, slain by Janak's hand" ;
    .

:Haihayas rdf:type :Character ;
    rdfs:label "Haihayas" ;
    :description "Rival kings who fought Asit" ;
    .

:Tálajanghas rdf:type :Character ;
    rdfs:label "Tálajanghas" ;
    :description "Rival kings who fought Asit" ;
    .

:Shashivindus rdf:type :Character ;
    rdfs:label "Shashivindus" ;
    :description "Rival kings, strong and wild, who fought Asit" ;
    .

:Sánkáshyá rdf:type :Place ;
    rdfs:label "Sánkáshyá" ;
    :description "Lovely town ruled by Kushadhwaj, decked with divine grace, bright as Pushpak, Ikshumatí river flows by" ;
    .

:Ikshumatí rdf:type :Place ;
    rdfs:label "Ikshumatí" ;
    :description "River rolling wave to lave Sánkáshyá's rampart" ;
    .

:Kekaya rdf:type :Place ;
    rdfs:label "Kekaya" ;
    :description "Realm ruled by father of Yudhájit" ;
    .

:Pushpak rdf:type :Place ;
    rdfs:label "Pushpak" ;
    :description "Place of divine shine, compared to Sánkáshyá" ;
    .

:Heavenly_bow rdf:type :Concept ;
    rdfs:label "Heavenly bow" ;
    :description "Best of bows, ponderous, held in eight-wheeled chest, gem of bows of monstrous size from skies, treasure from ages, broken by Ráma" ;
    .

:Shiva's_incomparable_bow rdf:type :Concept ;
    rdfs:label "Shiva's incomparable bow" ;
    :description "Peerless prize, bow of Shiva demanded by Sudhanvá" ;
    .

:Marriage_vow rdf:type :Concept ;
    rdfs:label "Marriage vow" ;
    :description "Janak's promise that valour's prize should gain the bride" ;
    .

:Gift_of_cows rdf:type :Concept ;
    rdfs:label "Gift of cows" ;
    :description "Four hundred thousand cows given as dowry, each with gold-adorned horns, calf, and pail of milk" ;
    .

:Nuptial_rites rdf:type :Concept ;
    rdfs:label "Nuptial rites" ;
    :description "Wedding ceremony on third night when moon in second Phálguni, lucky hour called Victory" ;
    .

:Maghá rdf:type :Concept ;
    rdfs:label "Maghá" ;
    :description "Tenth lunar asterism composed of five stars" ;
    .

:Phálguni rdf:type :Concept ;
    rdfs:label "Phálguni" ;
    :description "Two lunar asterisms (eleventh and twelfth mansions), ruled by genial deity, lucky for marriage" ;
    .

:Victory_hour rdf:type :Concept ;
    rdfs:label "Victory hour" ;
    :description "Lucky hour of high omen for nuptials" ;
    .

:Due_offerings rdf:type :Concept ;
    rdfs:label "Due offerings" ;
    :description "Offerings to spirits/shades to be paid" ;
    .

:Breaking_of_the_bow rdf:type :Event ;
    rdfs:label "Breaking of the bow" ;
    :description "Ráma broke heavenly bow in two, awful clang like tempest, earth shook, people fell senseless" ;
    .

:Journey_of_envoys rdf:type :Event ;
    rdfs:label "Journey of envoys" ;
    :context "Janak's ministers traveled three nights to Ayodhyá bearing news" ;
    .

:Dasharatha's_journey rdf:type :Event ;
    rdfs:label "Dasharatha's journey" ;
    :description "King traveled four days with quadruple host, priests, to Videha" ;
    .

:Kushadhwaj's_arrival rdf:type :Event ;
    rdfs:label "Kushadhwaj's arrival" ;
    :description "Younger brother summoned from Sánkáshyá to share in bliss" ;
    .

:Marriage_proposal rdf:type :Event ;
    rdfs:label "Marriage proposal" ;
    :description "Vasishtha claimed four daughters for four princes, Janak agreed" ;
    .

:Battle_with_Sudhanvá rdf:type :Event ;
    rdfs:label "Battle with Sudhanvá" ;
    :description "Janak fought and slew Sudhanvá who demanded Shiva's bow and Sítá" ;
    .

:Warfare_of_Asit rdf:type :Event ;
    rdfs:label "Warfare of Asit" ;
    :description "Fierce hot warfare with Haihayas, Tálajanghas, Shashivindus; Asit forced to flee" ;
    .

:Birth_of_Sagar rdf:type :Event ;
    rdfs:label "Birth of Sagar" ;
    :description "Kálindi bore son conceived by Chyavan, born with poison, named Sagar" ;
    .

:Four_weddings rdf:type :Event ;
    rdfs:label "Four weddings" ;
    :description "Four princes to marry four maidens on same lucky day in Phálguni" ;
    .

:Yudhájit's_arrival rdf:type :Event ;
    rdfs:label "Yudhájit's arrival" ;
    :description "Uncle came seeking to see nephew Bharat, bearing message from Kekaya" ;
    .

:Gift_of_kine_ceremony rdf:type :Event ;
    rdfs:label "Gift of kine ceremony" ;
    :description "Dasharatha gave 400,000 cows, one hundred thousand for each prince" ;
    .

:Vishvakarma rdf:type :Deity ;
    rdfs:label "Vishvakarma" ;
    :description "God who forms and fashions all, prayed to aid hospitable feast, art raised amazing structures" ;
    .

:Soma/Moon rdf:type :Deity ;
    rdfs:label "Soma/Moon" ;
    :description "Moon deity called to give noblest food to feed multitude" ;
    .

:Háhá rdf:type :Character ;
    rdfs:label "Háhá" ;
    :description "Celestial minstrel called by hermit to feast" ;
    .

:Huhú rdf:type :Character ;
    rdfs:label "Huhú" ;
    :description "Celestial minstrel called by hermit" ;
    .

:Vishvávasu rdf:type :Character ;
    rdfs:label "Vishvávasu" ;
    :description "Sweet celestial minstrel called to feast" ;
    .

:Alambúshá rdf:type :Character ;
    rdfs:label "Alambúshá" ;
    :description "Apsaras of beauty rare, fairest maid who danced to Bharat" ;
    .

:Tangled_Hair_Charmer rdf:type :Character ;
    rdfs:label "Tangled Hair Charmer" ;
    :description "Apsaras with distinctive tangled hair" ;
    .

:Vishváchi rdf:type :Character ;
    rdfs:label "Vishváchi" ;
    :description "Fair Apsaras" ;
    .

:Hemá rdf:type :Character ;
    rdfs:label "Hemá" ;
    :description "Apsaras sweet to view" ;
    .

:Bhímá rdf:type :Character ;
    rdfs:label "Bhímá" ;
    :description "Apsaras sweet to view" ;
    .

:Nágadantá rdf:type :Character ;
    rdfs:label "Nágadantá" ;
    :description "Lovely Apsaras" ;
    .

:Mishrakeshi rdf:type :Character ;
    rdfs:label "Mishrakeshi" ;
    :description "Apsaras bright to view who danced" ;
    .

:Ramaná rdf:type :Character ;
    rdfs:label "Ramaná" ;
    :description "Apsaras who danced" ;
    .

:Punjriká rdf:type :Character ;
    rdfs:label "Punjriká" ;
    :description "Apsaras who danced" ;
    .

:Gopa rdf:type :Character ;
    rdfs:label "Gopa" ;
    :description "Gandharva who came" ;
    .

:Sutanu rdf:type :Character ;
    rdfs:label "Sutanu" ;
    :description "Gandharva like radiant flame" ;
    .

:Ministers_and_councillors rdf:type :Character ;
    rdfs:label "Ministers and councillors" ;
    :description "Household officers, sat by degrees from chief to least" ;
    .

:Army_captains rdf:type :Character ;
    rdfs:label "Army captains" ;
    :description "Captain of host and honoured men" ;
    .

:Ingudí_Tree rdf:type :Place ;
    rdfs:label "Ingudí Tree" ;
    :description "Tree which lent shade, grass laid beneath, where Ráma and Sítá spent night together ere they went" ;
    .

:Gangá's_bank rdf:type :Place ;
    rdfs:label "Gangá's bank" ;
    :description "River bank where Raghu's son lay till break of day, army crossed pure wave" ;
    .

:Shringavera rdf:type :Place ;
    rdfs:label "Shringavera" ;
    :description "Town of Guha, lord of Nishádas, from where boats prepared" ;
    .

:Prayága rdf:type :Place ;
    rdfs:label "Prayága" ;
    :description "Famous wood where army stood in auspicious hour after crossing Gangá" ;
    .

:Bharadvája's_hermitage rdf:type :Place ;
    rdfs:label "Bharadvája's hermitage" ;
    :description "Holy dwelling, best of saints' abode, hermit's grove, holy shade, chapel where sacred fire burns" ;
    .

:Dandaka_forest rdf:type :Place ;
    rdfs:label "Dandaka forest" ;
    :description "Wilderness where Ráma roams in banishment" ;
    .

:Northern_Kuru rdf:type :Place ;
    rdfs:label "Northern Kuru" ;
    :description "Happy land in remote north, inhabitants enjoy natural perfection with complete happiness, no vicissitude/death/fear, Kuvera's garden lies there" ;
    .

:Nandan's_grove/shades rdf:type :Place ;
    rdfs:label "Nandan's grove/shades" ;
    :description "Blissful celestial garden, shade of trees where Gods take ease, twenty thousand maids came from" ;
    .

:Chaitraratha's_groves rdf:type :Place ;
    rdfs:label "Chaitraratha's groves" ;
    :description "Celestial gardens whose chaplets bloomed in Prayága's shade" ;
    .

:Malaya_hills rdf:type :Place ;
    rdfs:label "Malaya hills" ;
    :description "Scented mountain from which delicious cooling gales came" ;
    .

:Dardar_hills rdf:type :Place ;
    rdfs:label "Dardar hills" ;
    :description "Scented mountain from which gales came throwing auspicious fragrance" ;
    .

:Evening_worship rdf:type :Concept ;
    rdfs:label "Evening worship" ;
    :description "Three paid with ruled lips devoutly staid after sipping water" ;
    .

:Night_vigil rdf:type :Concept ;
    rdfs:label "Night vigil" ;
    :description "Lakshmana kept watch all night as sentinel, bow strung, hand gloved, arm braced, quivers hung" ;
    .

:Grass_bed rdf:type :Concept ;
    rdfs:label "Grass bed" ;
    :description "Sacred grass heaps, tumbled where Ráma and Sítá lay, pleasant bed spread by Lakshmana, stamped with signs of limbs" ;
    .

:Bharat's_grief rdf:type :Concept ;
    rdfs:label "Bharat's grief" ;
    :description "Saw bed, lion-lord on bare earth, sudden fall from bliss, senses distraught like dream, desolate fate" ;
    .

:Bharat's_vow_of_asceticism rdf:type :Concept ;
    rdfs:label "Bharat's vow of asceticism" ;
    :description "From this hour nights pass on earth/grass, eat only fruit/roots, wear bark coat and matted hair, remain for Ráma's term" ;
    .

:Army_crossing rdf:type :Concept ;
    rdfs:label "Army crossing" ;
    :description "Five hundred boats moored, mystic signs raised, mighty bells hung, some swam with pitchers, rafts, arms" ;
    .

:Bharadvája's_feast rdf:type :Concept ;
    rdfs:label "Bharadvája's feast" ;
    :description "Mighty banquet, hospitable entertainment, magical celestial feast with divine food, drink, dancers, musicians" ;
    .

:Vishvakarma's_magic rdf:type :Concept ;
    rdfs:label "Vishvakarma's magic" ;
    :description "Art raised structures: five leagues smooth ground, mansions with halls, palace high as cloud, throne, trees blooming" ;
    .

:Celestial_invocation rdf:type :Concept ;
    rdfs:label "Celestial invocation" ;
    :description "Hermit prayed to Gods, minstrels, rivers, Apsarases, all came in manifest semblance" ;
    .

:Divine_revelry rdf:type :Concept ;
    rdfs:label "Divine revelry" ;
    :description "Army delirious with delight, soldiers cried ne'er return to Ayodhyá, exulting in lawless glee, heaven for perfect bliss" ;
    .

:Night_at_Ingudí_Tree rdf:type :Event ;
    rdfs:label "Night at Ingudí Tree" ;
    :description "Three paid evening worship, Lakshmana spread grass bed, Ráma and Sítá lay reclining, Lakshmana kept vigil all night" ;
    .

:Bharat_visits_bed_site rdf:type :Event ;
    rdfs:label "Bharat visits bed site" ;
    :description "Bharat with friends and mothers saw tree and bed, beheld tumbled grass, particles of gold, silken threads, lamented" ;
    .

:Dawn_at_Gangá rdf:type :Event ;
    rdfs:label "Dawn at Gangá" ;
    :description "Raghu's son woke with earliest light, spoke to Shatrughna, Guha came with kindly questioning" ;
    .

:Boat_preparation rdf:type :Event ;
    rdfs:label "Boat preparation" ;
    :description "Guha sped to town, told kinsmen, five hundred boats ready moored, mystic signs raised, bells hung" ;
    .

:Crossing_Gangá rdf:type :Event ;
    rdfs:label "Crossing Gangá" ;
    :description "Army boarded boats, Bharat/Shatrughna/queens/priest/elders first, boats manned by Guha's servants, swimming elephants appeared, all crossed" ;
    .

:Arrival_at_Prayága rdf:type :Event ;
    rdfs:label "Arrival at Prayága" ;
    :description "Army stood in famous wood in auspicious hour, prince addressed weary men to rest" ;
    .

:Approaching_Bharadvája rdf:type :Event ;
    rdfs:label "Approaching Bharadvája" ;
    :description "Prince saw dwelling league away, left multitude, went on foot with two linen robes, Vasishtha walked before" ;
    .

:Meeting_Bharadvája rdf:type :Event ;
    rdfs:label "Meeting Bharadvája" ;
    :description "Hermit saw Vasishtha drawing near, gave grace-gift water and fruit, questioned in order, Bharat paid reverence due" ;
    .

:Bharadvája's_questioning rdf:type :Event ;
    rdfs:label "Bharadvája's questioning" ;
    :description "Saint asked why Bharat came, if to harm Ráma, enjoy realm without thorn, Bharat sobbed denied" ;
    .

:Bharadvája's_approval rdf:type :Event ;
    rdfs:label "Bharadvája's approval" ;
    :description "Hermit pressed by Vasishtha and priests replied graciously, granted prayer, told Chitrakúta location, urged stay for feast" ;
    .

:Invocation_of_deities rdf:type :Event ;
    rdfs:label "Invocation of deities" ;
    :description "Hermit prayed to Vishvakarma, three world-guards, streams, minstrels, Apsarases, all came in manifest semblance" ;
    .

:Celestial_manifestations rdf:type :Event ;
    rdfs:label "Celestial manifestations" ;
    :description "Delicious gales blew, immortal flowers fell, heavenly drums sounded, Apsarases danced, minstrels sang" ;
    .

:Magical_transformation rdf:type :Event ;
    rdfs:label "Magical transformation" ;
    :description "Vishvakarma's art raised structures: five leagues level ground, fruit trees, streams, mansions, palace high as cloud" ;
    .

:The_great_feast rdf:type :Event ;
    rdfs:label "The great feast" ;
    :description "Army amazed and delighted, twenty thousand nymphs served, Gandharvas sang, danced, all fed with celestial food" ;
    .

:Night_of_revelry rdf:type :Event ;
    rdfs:label "Night of revelry" ;
    :description "Army spent night in joy, entranced, soldiers cried to stay forever, exulting in lawless glee, seemed like dream" ;
    .

:Morning_departure rdf:type :Event ;
    rdfs:label "Morning departure" ;
    :description "Minstrels/streams/dames returned, Bharat with morning's light drew near hermit, questioned if night content" ;
    .

:Vaishtha rdf:type :Character ;
    rdfs:label "Vaishtha" ;
    :description "The royal household priest and chief counselor who directs the envoys to summon Bharat from Rájagriha." ;
    .

:Jáválí rdf:type :Character ;
    rdfs:label "Jáválí" ;
    :description "A renowned Bráhman sage who attends the assembly after Dasharatha's death." ;
    .

:Márkandeya rdf:type :Character ;
    rdfs:label "Márkandeya" ;
    :description "An ancient revered sage present at the assembly of Bráhmans in Ayodhyá." ;
    .

:Hermit's_Son rdf:type :Character ;
    rdfs:label "Hermit's Son" ;
    :description "An innocent young ascetic accidentally shot by Dasharatha while he was filling a water-pot at the Sarju river." ;
    .

:VishGu rdf:type :Deity ;
    rdfs:label "VishGu" ;
    :description "The preserver of the universe, invoked in Kaushalya's blessing; Ráma is compared to his power." ;
    .

:VaruGa rdf:type :Deity ;
    rdfs:label "VaruGa" ;
    :description "The God of cosmic waters and moral order, invoked in blessings for Ráma's protection." ;
    .

:Parjanya rdf:type :Deity ;
    rdfs:label "Parjanya" ;
    :description "The God of rain, mentioned in the discourse on the necessity of a king for prosperous lands." ;
    .

:Zukra rdf:type :Deity ;
    rdfs:label "Zukra" ;
    :description "The regent of the planet Venus, invoked for Ráma's protection in the forest." ;
    .

:DaG_ak_Forest rdf:type :Place ;
    rdfs:label "DaG ak Forest" ;
    :description "The dense forest wilderness where Ráma, Sítá, and LakshmaG are exiled for fourteen years." ;
    .

:Sarju_River rdf:type :Place ;
    rdfs:label "Sarju River" ;
    :description "The river on whose bank Dasharatha accidentally shot the hermit's son, an event that cursed his fate." ;
    .

:Rájagriha rdf:type :Place ;
    rdfs:label "Rájagriha" ;
    :description "The city of Bharat's maternal grandfather A[vapati, where Bharat and Zatrughna reside during the exile." ;
    .

:Prayág rdf:type :Place ;
    rdfs:label "Prayág" ;
    :description "The sacred confluence of Gangá and Yamuná rivers, near Bharadvája's hermitage; modern Allahabad." ;
    .

:Ko[ala rdf:type :Place ;
    rdfs:label "Ko[ala" ;
    :description "The prosperous kingdom ruled by Dasharatha with Ayodhyá as its capital." ;
    .

:Ráma's_Exile rdf:type :Event ;
    rdfs:label "Ráma's Exile" ;
    :description "The 14-year banishment of Ráma to the DaGak forest, initiated by Kaikeyí's boon from Dasharatha." ;
    .

:Dasharatha's_Death rdf:type :Event ;
    rdfs:label "Dasharatha's Death" ;
    :description "The death of King Dasharatha from grief following Ráma's departure into exile." ;
    .

:Kaushalya's_Blessing rdf:type :Event ;
    rdfs:label "Kaushalya's Blessing" ;
    :description "The ceremonial blessing and rites performed by Queen Kaushalya for Ráma before his departure." ;
    .

:Ráma's_Departure rdf:type :Event ;
    rdfs:label "Ráma's Departure" ;
    :description "The formal leave-taking of Ráma, Sítá, and LakshmaG from Ayodhyá in Sumantra's chariot." ;
    .

:Sumantra's_Return rdf:type :Event ;
    rdfs:label "Sumantra's Return" ;
    :description "Sumantra's return to Ayodhyá alone after leaving Ráma at the forest, conveying Ráma's final message." ;
    .

:Shooting_of_the_Hermit's_Son rdf:type :Event ;
    rdfs:label "Shooting of the Hermit's Son" ;
    :description "Dasharatha's accidental killing of a hermit's son on the Sarju bank while hunting by sound in his youth." ;
    .

:Assembly_After_Dasharatha's_Death rdf:type :Event ;
    rdfs:label "Assembly After Dasharatha's Death" ;
    :description "The council of Bráhmans and ministers who met after Dasharatha's death to decide on installing a king." ;
    .

:Envoys_Sent_to_Rájagriha rdf:type :Event ;
    rdfs:label "Envoys Sent to Rájagriha" ;
    :description "Vaishtha's dispatch of fast messengers to summon Bharat back to Ayodhyá after the king's death." ;
    .

:Halt_at_Ingudí rdf:type :Event ;
    rdfs:label "Halt at Ingudí" ;
    :description "Ráma's first night halt under the Ingudí tree on the Gangá bank during the forest journey." ;
    .

:Visit_to_Bharadvája's_Hermitage rdf:type :Event ;
    rdfs:label "Visit to Bharadvája's Hermitage" ;
    :description "Ráma and LakshmaG's arrival at the sage Bharadvája's hermitage near Prayag during the exile journey." ;
    .

:Filial_Duty rdf:type :Concept ;
    rdfs:label "Filial Duty" ;
    :description "The obligation of a son to honor and obey his parents, central to Ráma's acceptance of exile." ;
    .

:Kingship rdf:type :Concept ;
    rdfs:label "Kingship" ;
    :description "The concept of righteous rule; the assembly's discourse highlights the necessity of a king for justice and prosperity." ;
    .

:Truth_/_Oath rdf:type :Concept ;
    rdfs:label "Truth / Oath" ;
    :description "The keeping of sworn words; Dasharatha's oath to Kaikeyí and Ráma's own pledge drive key events." ;
    .

:Exile rdf:type :Concept ;
    rdfs:label "Exile" ;
    :description "Banishment to the forest as a form of renunciation and testing, undertaken by Ráma for 14 years." ;
    .

:The_Praise_of_Kings_(Canto_LXVII) rdf:type :Text ;
    rdfs:label "The Praise of Kings (Canto LXVII)" ;
    :description "A canto in which the Bráhmans lament the dangers of a kingless land after Dasharatha's death." ;
    .

:The_Envoys_(Canto_LXVIII) rdf:type :Text ;
    rdfs:label "The Envoys (Canto LXVIII)" ;
    :description "The canto in which Vaishtha sends swift messengers to bring Bharat back from Rájagriha." ;
    .

:The_Hermit's_Son_(Canto_LXIII) rdf:type :Text ;
    rdfs:label "The Hermit's Son (Canto LXIII)" ;
    :description "The canto in which Dasharatha confesses to Kaushalya his past sin of accidentally killing a hermit's son." ;
    .

:Kausalyá's_Blessing_(Canto_XXV) rdf:type :Text ;
    rdfs:label "Kausalyá's Blessing (Canto XXV)" ;
    :description "The canto recording Queen Kaushalya's elaborate ritual blessing of Ráma before his departure into exile." ;
    .

:The_Triumph_of_Love_(Canto_XXX) rdf:type :Text ;
    rdfs:label "The Triumph of Love (Canto XXX)" ;
    :description "The canto where Sítá successfully persuades Ráma to allow her to accompany him into the forest." ;
    .

:Ráma's_Departure_(Canto_XL) rdf:type :Text ;
    rdfs:label "Ráma's Departure (Canto XL)" ;
    :description "The canto describing the formal departure of Ráma, Sítá, and LakshmaG from Ayodhyá." ;
    .

:The_Halt_Under_The_Ingudí_(Canto_L) rdf:type :Text ;
    rdfs:label "The Halt Under The Ingudí (Canto L)" ;
    :description "The canto in which Ráma rests at the Gangá bank under the Ingudí tree and meets the Nisháda king Guha." ;
    .

:Lakshman's_Lament_(Canto_LI) rdf:type :Text ;
    rdfs:label "Lakshman's Lament (Canto LI)" ;
    :description "The canto in which LakshmaG laments the suffering caused by Ráma's exile while keeping night watch." ;
    .

:Bharadvája's_Hermitage_(Canto_LIV) rdf:type :Text ;
    rdfs:label "Bharadvája's Hermitage (Canto LIV)" ;
    :description "The canto describing Ráma's visit to the sage Bharadvája at the confluence of Gangá and Yamuná." ;
    .

:Thunder_wielder rdf:type :Deity ;
    rdfs:label "Thunder-wielder" ;
    :description "God whose hands wield thunder, invoked to guard east" ;
    .

:Warders rdf:type :Character ;
    rdfs:label "Warders" ;
    :description "Guards of hoary age held in honor, sat at portal with many more, sprang to feet with acclamation" ;
    .

:Old_dames_and_tender_girls rdf:type :Character ;
    rdfs:label "Old dames and tender girls" ;
    :description "Stationed to keep doors, flew to chamber to bear tidings to Kausalyá" ;
    .

:Weeping_women rdf:type :Character ;
    rdfs:label "Weeping women" ;
    :description "Women in palace who wailed and lamented at Ráma's exile, compared to kine bereaved of calves" ;
    .

:Bráhmans rdf:type :Character ;
    rdfs:label "Bráhmans" ;
    :description "Crowd of good and sage masters of Veda text, dear to king for lore and age, venerate majesty and royal state" ;
    .

:Rohiní rdf:type :Character ;
    rdfs:label "Rohiní" ;
    :description "Lunar asterism, favorite wife of Moon, compared to Sítá blessed with Ráma's love" ;
    .

:Moon rdf:type :Character ;
    rdfs:label "Moon" ;
    :description "Lord of Cooling Rays, retains sweet splendor in time of wane, King of Rivers waits for darling moon" ;
    .

:Titans rdf:type :Character ;
    rdfs:label "Titans" ;
    :description "Demons who fought Gods in ancient war when Dasharatha saved Kaikeyí" ;
    .

:Palace/Royal_house rdf:type :Place ;
    rdfs:label "Palace/Royal house" ;
    :description "Dasharatha's dwelling with lofty halls, ladies' bower, three broad courts with bowmen, chambers with lattice windows, central court" ;
    .

:Kausalyá's_mansion rdf:type :Place ;
    rdfs:label "Kausalyá's mansion" ;
    :description "Queen's dwelling with splendid bower, portal guarded by warders, multiple courts, where offerings made" ;
    .

:Ladies'_bower rdf:type :Place ;
    rdfs:label "Ladies' bower" ;
    :description "Women's quarters where Dasharatha sat with Kaikeyí, where sentence pronounced" ;
    .

:Royal_street rdf:type :Place ;
    rdfs:label "Royal street" ;
    :description "Path traversed by Ráma, filled with incense of aloe, high palaces like pale clouds, flowers of myriad colors, food for varied taste" ;
    .

:City_gates rdf:type :Place ;
    rdfs:label "City gates" ;
    :description "Where multitude stood watching in street expecting Ráma's return" ;
    .

:Consecration/Throning rdf:type :Concept ;
    rdfs:label "Consecration/Throning" ;
    :description "Imperial rite to join Ráma in royal sway, sanctifies ruler's might, lustral rites and fast, when moon and Pushya meet, all royal pomp" ;
    .

:Hermit's_garb rdf:type :Concept ;
    rdfs:label "Hermit's garb" ;
    :description "Coat of bark and matted hair, black deer's skin and roebuck's horn, hermit dress" ;
    .

:Duty_to_father rdf:type :Concept ;
    rdfs:label "Duty to father" ;
    :description "First and paramount duty that sons obediently fulfill father's word and will, father as deity on earth" ;
    .

:Holy_offerings rdf:type :Concept ;
    rdfs:label "Holy offerings" ;
    :description "Sacrificial elements: oil, grain, vases, wreaths, curds, cates, wood, milk, sesamum, rice, poured in sacred fire" ;
    .

:Regent_power rdf:type :Concept ;
    rdfs:label "Regent power" ;
    :description "Imperial sway and governance to be yielded to Bharat by king's decree" ;
    .

:Hermit's_food rdf:type :Concept ;
    rdfs:label "Hermit's food" ;
    :description "Roots, fruit, honey, abstaining from flesh, living in solitude" ;
    .

:Ráma's_summons rdf:type :Event ;
    rdfs:label "Ráma's summons" ;
    :description "Sumantra brought message that king and Kaikeyí seek interview with Ráma" ;
    .

:Ráma's_journey_to_palace rdf:type :Event ;
    rdfs:label "Ráma's journey to palace" ;
    :description "Hero rode lofty car like fire, coursers swift, Lakshmana behind, crowds following, women throwing chaplets, benedictions" ;
    .

:Meeting_with_Dasharatha rdf:type :Event ;
    rdfs:label "Meeting with Dasharatha" ;
    :description "Ráma found father with hopeless eye, pallid mien, voice choked, prostrate, could not speak or look" ;
    .

:Kaikeyí's_sentence rdf:type :Event ;
    rdfs:label "Kaikeyí's sentence" ;
    :description "Ruthless dame revealed two boons: Bharat to throne, Ráma to exile for 14 years in Dandaka" ;
    .

:Ráma's_acceptance rdf:type :Event ;
    rdfs:label "Ráma's acceptance" ;
    :description "Noble youth calm and unmoved, promised to fulfill father's word, go to forest, yield empire to Bharat" ;
    .

:Ancient_Gods_Titans_war rdf:type :Event ;
    rdfs:label "Ancient Gods-Titans war" ;
    :description "Battle when Dasharatha fought transfixed with darts, bathed in gore, saved by Kaikeyí who earned two boons" ;
    .

:Ráma's_departure_from_bower rdf:type :Event ;
    rdfs:label "Ráma's departure from bower" ;
    :description "Hero left ladies' bower, dismissed retinue, refused chouries and umbrella, sought mother's mansion" ;
    .

:Visit_to_Kausalyá rdf:type :Event ;
    rdfs:label "Visit to Kausalyá" ;
    :description "Ráma came to mother's splendid bower, she fed sacred flame, made offerings, embraced and blessed son" ;
    .

:Kausalyá's_lament_preparation rdf:type :Event ;
    rdfs:label "Kausalyá's lament preparation" ;
    :description "Mother wore white, fasted, kept vigil, made offerings to Vishnu and Lakshmí, awaited son's consecration" ;
    .

:Paulomí rdf:type :Deity ;
    rdfs:label "Paulomí" ;
    :description "Consort of Indra, also called Shachí and Indrání" ;
    .

:Tára rdf:type :Character ;
    rdfs:label "Tára" ;
    :description "Mighty monkey, offspring of Vrihaspati, matchless chieftain boast for wisdom of Vánar host" ;
    .

:Gandhamádan rdf:type :Character ;
    rdfs:label "Gandhamádan" ;
    :description "Brave and bold monkey, son of Lord of Gold" ;
    .

:Dwivida rdf:type :Character ;
    rdfs:label "Dwivida" ;
    :description "Monkey, son of Ashvins, famed for beauty like sires" ;
    .

:Sushen rdf:type :Character ;
    rdfs:label "Sushen" ;
    :description "Monkey, son of Varuna" ;
    .

:Sarabh rdf:type :Character ;
    rdfs:label "Sarabh" ;
    :description "Monkey, son of rain god Parjanya" ;
    .

:Rishyasring rdf:type :Character ;
    rdfs:label "Rishyasring" ;
    :description "Well-honoured sage, hermit of noble mind, guided king's rites, married to Shántá, son of Kashyapa/Vibhándak" ;
    .

:Shántá rdf:type :Character ;
    rdfs:label "Shántá" ;
    :description "Daughter of Dasharatha, wife of Rishyasring, Kshatriya who married Bráhman, devoted to husband" ;
    .

:Vibhándak rdf:type :Character ;
    rdfs:label "Vibhándak" ;
    :description "Hermit, father of Rishyasring, son of Kashyapa, of Bráhmans first and best" ;
    .

:Celestial_envoy rdf:type :Character ;
    rdfs:label "Celestial envoy" ;
    :description "Vast being of awful might from sacrificial flame, dark robed in red, brought golden vase of nectar" ;
    .

:Heaven rdf:type :Place ;
    rdfs:label "Heaven" ;
    :description "Realm of Gods where nectar is quaffed, home of celestial beings" ;
    .

:Earth rdf:type :Place ;
    rdfs:label "Earth" ;
    :description "Mortal world where Vishnu takes birth, domain guarded by Ráma for ten thousand years" ;
    .

:Champá rdf:type :Place ;
    rdfs:label "Champá" ;
    :description "Town of Lomapád, wreathed with Champacs' leafy crown, where Rishyasring returned" ;
    .

:Forest_hermitage rdf:type :Place ;
    rdfs:label "Forest hermitage" ;
    :description "Woodland dwelling of Rishyasring and Shántá, where they returned after rites" ;
    .

:Swarga rdf:type :Place ;
    rdfs:label "Swarga" ;
    :description "Indra's heaven where Ashvins serve as physicians" ;
    .

:Ashvamedha rdf:type :Concept ;
    rdfs:label "Ashvamedha" ;
    :description "Horse Sacrifice, rite that wins an heir, performed by Dasharatha" ;
    .

:Celestial_nectar rdf:type :Concept ;
    rdfs:label "Celestial nectar" ;
    :description "Divine drink/Amrit brought in golden vase, gives sons and wealth, blessed by Gods" ;
    .

:Vánars rdf:type :Concept ;
    rdfs:label "Vánars" ;
    :description "Monkey-formed beings created by Gods as helps for Vishnu, skilled in war, change form at will" ;
    .

:Penance rdf:type :Concept ;
    rdfs:label "Penance" ;
    :description "Spiritual practice through which Rávana gained favor from Brahmá" ;
    .

:Chaitra rdf:type :Concept ;
    rdfs:label "Chaitra" ;
    :description "First month of spring, corresponds to latter half March and former half April" ;
    .

:Punarvasu rdf:type :Concept ;
    rdfs:label "Punarvasu" ;
    :description "Seventh lunar mansion, presided over by Aditi" ;
    .

:Ashleshá rdf:type :Concept ;
    rdfs:label "Ashleshá" ;
    :description "Ninth lunar mansion called the Snake" ;
    .

:Cancer rdf:type :Concept ;
    rdfs:label "Cancer" ;
    :description "Zodiacal sign, the Crab, where sun was when twins were born" ;
    .

:Pisces rdf:type :Concept ;
    rdfs:label "Pisces" ;
    :description "Zodiacal sign Mina (fish), under which Bharat was born" ;
    .

:Proshthapada rdf:type :Concept ;
    rdfs:label "Proshthapada" ;
    :description "Constellation containing stars in wing of Pegasus, four-fold light" ;
    .

:Pradakshiná rdf:type :Concept ;
    rdfs:label "Pradakshiná" ;
    :description "Walking round object keeping right side towards it, mark of great respect" ;
    .

:Expiatory_ceremony rdf:type :Concept ;
    rdfs:label "Expiatory ceremony" ;
    :description "Rite freeing from stain, performed for Rishyasring's inter-caste marriage" ;
    .

:Gandharvas rdf:type :Concept ;
    rdfs:label "Gandharvas" ;
    :description "Celestial musicians inhabiting Indra's heaven, orchestra at divine banquets" ;
    .

:Yakshas rdf:type :Concept ;
    rdfs:label "Yakshas" ;
    :description "Demigods attendant on Kuvera, employed in care of garden and treasures" ;
    .

:Kimpurushas rdf:type :Concept ;
    rdfs:label "Kimpurushas" ;
    :description "Demigods serving Kuvera, celestial musicians, like centaurs with human figures and horses' heads" ;
    .

:Siddhas rdf:type :Concept ;
    rdfs:label "Siddhas" ;
    :description "Demigods/spirits occupying middle air between earth and sun" ;
    .

:Gods'_supplication_to_Vishnu rdf:type :Event ;
    rdfs:label "Gods' supplication to Vishnu" ;
    :description "Gods pray to Nárāyana/Vishnu to take human birth and slay Rávana" ;
    .

:Vishnu's_promise rdf:type :Event ;
    rdfs:label "Vishnu's promise" ;
    :description "Vishnu agrees to take mortal birth, divide being in four, reign 10,000 years" ;
    .

:Horse_Sacrifice_of_Dasharatha rdf:type :Event ;
    rdfs:label "Horse Sacrifice of Dasharatha" ;
    :description "Ashvamedha rite performed by childless king to win an heir" ;
    .

:Appearance_of_celestial_envoy rdf:type :Event ;
    rdfs:label "Appearance of celestial envoy" ;
    :description "Vast being emerges from sacrificial flame bearing golden vase of nectar" ;
    .

:Distribution_of_nectar rdf:type :Event ;
    rdfs:label "Distribution of nectar" ;
    :description "King gives divine drink to three queens: Kausalyá (half), Kaikeyí (half residue), Sumitrá (twice)" ;
    .

:Creation_of_Vánars rdf:type :Event ;
    rdfs:label "Creation of Vánars" ;
    :description "Brahmá commands Gods to create monkey-formed helpers for Vishnu's incarnation" ;
    .

:Birth_of_Vánar_chiefs rdf:type :Event ;
    rdfs:label "Birth of Vánar chiefs" ;
    :description "Gods, sages, celestial beings beget sons in monkey forms with divine powers" ;
    .

:Birth_of_Ráma rdf:type :Event ;
    rdfs:label "Birth of Ráma" ;
    :description "Kausalyá bears Ráma on Chaitra's ninth day, moon in Punarvasu, five planets at apex" ;
    .

:Birth_of_Bharat rdf:type :Event ;
    rdfs:label "Birth of Bharat" ;
    :description "Kaikeyí bears Bharat under Pushya mansion and Pisces sign" ;
    .

:Birth_of_twins rdf:type :Event ;
    rdfs:label "Birth of twins" ;
    :description "Sumitrá bears Lakshmana and Shatrughna when sun reached Cancer, moon with Snake" ;
    .

:Rishyasring's_return_to_Ayodhyá rdf:type :Event ;
    rdfs:label "Rishyasring's return to Ayodhyá" ;
    :description "Sage returns with Shántá after completing Dasharatha's rites" ;
    .

:Rishyasring's_return_to_forest rdf:type :Event ;
    rdfs:label "Rishyasring's return to forest" ;
    :description "Sage and Shántá depart from Ayodhyá back to hermitage" ;
    .

:Vibhándak's_visit rdf:type :Event ;
    rdfs:label "Vibhándak's visit" ;
    :description "Kashyapa's son travels to city to see his son Rishyasring" ;
    .

:Expiatory_rite rdf:type :Event ;
    rdfs:label "Expiatory rite" ;
    :description "Vibhándak performs ceremony to free Rishyasring from stain of inter-caste marriage" ;
    .

:Celestial_celebration rdf:type :Event ;
    rdfs:label "Celestial celebration" ;
    :description "Nymphs danced, minstrels sang, heavenly drums pealed, flowers rained at princes' births" ;
    .

:Vishvedevas rdf:type :Deity ;
    rdfs:label "Vishvedevas" ;
    :description "Deities of particular class with five or ten enumerated, worshipped at funeral obsequies for deceased progenitors" ;
    .

:Gods_of_heaven rdf:type :Deity ;
    rdfs:label "Gods of heaven" ;
    :description "Celestial beings who assemble at Brahmá's call, advance in shining train" ;
    .

:Leafy_hut/cottage rdf:type :Place ;
    rdfs:label "Leafy hut/cottage" ;
    :description "Cot built by Lakshmana with timber from wood, firmly built, roofed with leaves, fair to see, well-set, fenced from wind and rain" ;
    .

:Mandar_peak rdf:type :Place ;
    rdfs:label "Mandar peak" ;
    :description "Mountain beneath whose peak woods hang where Ashvins seek" ;
    .

:Cottage_sacrifice rdf:type :Concept ;
    rdfs:label "Cottage sacrifice" ;
    :description "Sacrifice paid for lengthened life with antelope venison, as Scripture bids, verses repeated to make complete" ;
    .

:Sacred_rites rdf:type :Concept ;
    rdfs:label "Sacred rites" ;
    :description "Ritual with muttered prayer, water, grass, wood, fire, offerings to Gods and shades, bathed duly in river, good offerings remove sin" ;
    .

:Altars_and_shrines rdf:type :Concept ;
    rdfs:label "Altars and shrines" ;
    :description "Many built to suit holy shade, decked with woodland chaplets, fruit, roots, roasted meat" ;
    .

:Ráma's_messages rdf:type :Concept ;
    rdfs:label "Ráma's messages" ;
    :description "Joining hands, head bent, greeting sent to father's feet, mother's blessing, honor to king like Gods, duty to monarchs paramount" ;
    .

:Lakshmana's_anger rdf:type :Concept ;
    rdfs:label "Lakshmana's anger" ;
    :description "Soul on fire, breathing fast words of ire, king is cause/poor slave, questioned king's authority, ties loosed" ;
    .

:Votive_coils rdf:type :Concept ;
    rdfs:label "Votive coils" ;
    :description "Locks wound in votive fashion, coats of bark bound" ;
    .

:Nature's_sympathy_with_grief rdf:type :Concept ;
    rdfs:label "Nature's sympathy with grief" ;
    :description "Trees hang low, shoot/bud/flower dead, floods dried, groves drear, beasts still, serpents don't crawl, lethargy of woe, blossoms lost scent" ;
    .

:Dasharatha's_sea_of_sorrow rdf:type :Concept ;
    rdfs:label "Dasharatha's sea of sorrow" ;
    :description "Elaborate metaphor: sorrow raging sea, Ráma's absence swells tide, Sítá's absence makes wide, tears foam, sighs billows, cries roar, Kaikeyí fire beneath" ;
    .

:Sumantra's_consolation rdf:type :Concept ;
    rdfs:label "Sumantra's consolation" ;
    :description "Persuasive art, soothing fancies, pleasant words to cheer, conduct buys wide glory" ;
    .

:Kausalyá's_longing rdf:type :Concept ;
    rdfs:label "Kausalyá's longing" ;
    :description "Cannot live single hour without them, needs must go to forest or Yama's realm, shrill lament 'My son, my son!'" ;
    .

:Meeting_Válmíki rdf:type :Event ;
    rdfs:label "Meeting Válmíki" ;
    :description "Ráma, Lakshmana, Sítá spoke raising suppliant hands to anchoret, requested to stay, saint entertained with honor" ;
    .

:Building_the_cottage rdf:type :Event ;
    rdfs:label "Building the cottage" ;
    :description "Lakshmana brought timber, built leafy hut deftly with branches, firmly built and walled with wood" ;
    .

:Cottage_consecration rdf:type :Event ;
    rdfs:label "Cottage consecration" ;
    :description "Sacrifice paid with antelope venison, Lakshmana shot deer, meat broiled, sacred rites begun, Ráma repeated verses, celestial hosts came" ;
    .

:Settling_at_Chitrakúta rdf:type :Event ;
    rdfs:label "Settling at Chitrakúta" ;
    :description "Paid Vishvedevas, Rudra, Vishnu due, wonted blessings, made altars and shrines, entered pleasant cot, forgot exile's woe" ;
    .

:Sumantra's_return_journey rdf:type :Event ;
    rdfs:label "Sumantra's return journey" ;
    :description "Guha's heart sank, spent with sorrow, yoked steeds, sped to Ayodhyá, third day reached gate, city drowned in sorrow" ;
    .

:People's_query_about_Ráma rdf:type :Event ;
    rdfs:label "People's query about Ráma" ;
    :description "Hundreds/thousands ran crying 'Where is Ráma?', drew deep sighs, wailed, tears fell when knew he crossed flood" ;
    .

:Arrival_at_palace rdf:type :Event ;
    rdfs:label "Arrival at palace" ;
    :description "Sumantra through seven courts, royal ladies flocked from terraces, heard them mourn for Ráma, reached monarch's hall" ;
    .

:Dasharatha's_collapse rdf:type :Event ;
    rdfs:label "Dasharatha's collapse" ;
    :description "King heard message, heart well-nigh broke, fainting fell to earth, senses astray, overcome by grief" ;
    .

:Kausalyá's_revival rdf:type :Event ;
    rdfs:label "Kausalyá's revival" ;
    :description "With Sumitrá raised lord dismayed, cried to him, lay prostrate, voice drowned by sobs, flocked around and wept" ;
    .

:Ráma's_message_delivery rdf:type :Event ;
    rdfs:label "Ráma's message delivery" ;
    :description "Sumantra told greeting to father's feet, mother's blessing, honor king like Gods, message to Bharat, Lakshmana's angry words" ;
    .

:Journey_details_recounted rdf:type :Event ;
    rdfs:label "Journey details recounted" ;
    :description "Locks in votive coils, bark coats, crossed Gangá, went to Prayág, Lakshmana walked ahead, forced to return" ;
    .

:Nature's_mourning_described rdf:type :Event ;
    rdfs:label "Nature's mourning described" ;
    :context "Realms mourn, trees withering, floods dried, groves drear, beasts still, wood silent, crushed with grief" ;
    .

:Kausalyá's_desperation rdf:type :Event ;
    rdfs:label "Kausalyá's desperation" ;
    :description "Trembling, lying prostrate, half awoke, begged to be borne to forest or Yama's realm, no power to linger" ;
    .

:Sumantra's_consolation_speech rdf:type :Event ;
    rdfs:label "Sumantra's consolation speech" ;
    :description "Choked by tears, suppliant hands, urged dismiss grief, described Sítá's contentment, Ráma's protection, conduct buys glory" ;
    .

:Day_God rdf:type :Deity ;
    rdfs:label "Day-God" ;
    :description "Sun deity whose rays consume parching plain in summer's noontide blaze" ;
    .

:Fortune rdf:type :Deity ;
    rdfs:label "Fortune" ;
    :description "Will share glories with Sítá and Earth awaiting heir" ;
    .

:Warders_of_palace rdf:type :Character ;
    rdfs:label "Warders of palace" ;
    :description "Led monarch to Kausalyá's bower, laid him with reverential care" ;
    .

:Aged_Bráhmans rdf:type :Character ;
    rdfs:label "Aged Bráhmans" ;
    :description "Saintly twice-born, triply old in glory/knowledge/seasons, hoary heads bowed, walked with Ráma, wailed with wild lament" ;
    .

:People_of_Ayodhyá rdf:type :Character ;
    rdfs:label "People of Ayodhyá" ;
    :description "Followed Ráma, felt fond affection, wept, lay around on grassy shore, sleeping crowd, citizens who roam, devoted" ;
    .

:Kausalyá's_bower rdf:type :Place ;
    rdfs:label "Kausalyá's bower" ;
    :description "Queen's chamber where warders laid Dasharatha with reverential care" ;
    .

:Forest/Woods rdf:type :Place ;
    rdfs:label "Forest/Woods" ;
    :description "Wilderness where Ráma sent, unpeopled, tenants creep to lair/den/nest, hermit-haunted wood, desert place, dark with lovely trees" ;
    .

:Tamasá_river rdf:type :Place ;
    rdfs:label "Tamasá river" ;
    :description "River with eddying flood and fast waves, grassy shore, fringed with grassy mead, where Ráma halted first night" ;
    .

:Ikshváku's_ancient_home rdf:type :Place ;
    rdfs:label "Ikshváku's ancient home" ;
    :description "Ancestral dwelling from which citizens far roam" ;
    .

:Banishment rdf:type :Concept ;
    rdfs:label "Banishment" ;
    :description "Exile to wilderness, forest life, fourteen years in wild, hermit's garb, sent to abide by woe untried" ;
    .

:Dasharatha's_grief rdf:type :Concept ;
    rdfs:label "Dasharatha's grief" ;
    :description "King's soul disquieted, tossed arms lamenting, sight went with Ráma, choking sobs, voice half spent, piteous cry" ;
    .

:Kausalyá's_lament rdf:type :Concept ;
    rdfs:label "Kausalyá's lament" ;
    :description "Mother's bitter grief, years of woe, tears of anguish, quenchless flames burn, compared to lioness robbed" ;
    .

:Former_life_sin rdf:type :Concept ;
    rdfs:label "Former life sin" ;
    :description "Kausalyá believes she dried udders of kine, left calves to pine, hence childless now" ;
    .

:Sumitrá's_consolation rdf:type :Concept ;
    rdfs:label "Sumitrá's consolation" ;
    :description "Righteous words, hopeful argument, soothing eloquent speech, grief began to leave" ;
    .

:People's_devotion rdf:type :Concept ;
    rdfs:label "People's devotion" ;
    :description "Fond affection, followed Ráma, would not consent to quit lives, never leave firm intent, care of house resigned" ;
    .

:Ráma's_virtues rdf:type :Concept ;
    rdfs:label "Ráma's virtues" ;
    :description "Keeps vows firm and sure, duty makes spirit pure, noble gifts abound, decked with all grace, filial duty path" ;
    .

:Bráhmans'_worship_fires rdf:type :Concept ;
    rdfs:label "Bráhmans' worship fires" ;
    :description "Sacred fires borne on aged shoulders following to woods, Vájapeya rites canopies, Vedic lore deep in bosoms" ;
    .

:First_night_fast rdf:type :Concept ;
    rdfs:label "First night fast" ;
    :description "Ráma took only water to slake thirst on first night, varied store wood provides" ;
    .

:Deceptive_departure rdf:type :Concept ;
    rdfs:label "Deceptive departure" ;
    :description "Ráma left while people slept, drove north then back to mislead, so citizens wouldn't follow" ;
    .

:Citizens'_despair rdf:type :Concept ;
    rdfs:label "Citizens' despair" ;
    :description "Woke to find no Ráma, fear and grief subdued senses, contemplated death by fire, pilgrimage to Himálayas" ;
    .

:Ayodhyá's_desolation rdf:type :Concept ;
    rdfs:label "Ayodhyá's desolation" ;
    :description "City wore no beauty, dull river, moonless sky, dry sea, all joy fled, no trader showed wares, mothers scarce smiled" ;
    .

:Women's_keen_taunts rdf:type :Concept ;
    rdfs:label "Women's keen taunts" ;
    :description "Wives assailed returning lords with piercing words like steel, questioned worth of home/sons/wealth without Ráma" ;
    .

:Nature's_reverence rdf:type :Concept ;
    rdfs:label "Nature's reverence" ;
    :description "Pools/fountains made holy by Ráma's use, forests yearn to please, mountains welcome, trees fling wealth before him" ;
    .

:Night_of_doom rdf:type :Event ;
    rdfs:label "Night of doom" ;
    :description "Hated gloom fell on Dasharatha, at midnight cried for Kausalyá, sight went with Ráma" ;
    .

:Kausalyá's_lament_to_Dasharatha rdf:type :Event ;
    rdfs:label "Kausalyá's lament to Dasharatha" ;
    :description "Queen addressed lord on bed, accused Kaikeyí of venom, mourned son's banishment, questioned former life sins" ;
    .

:Sumitrá's_consolation_speech rdf:type :Event ;
    rdfs:label "Sumitrá's consolation speech" ;
    :description "Fair queen gave righteous answer, praised Ráma's virtues, prophesied joyful return, soothed Kausalyá's heart" ;
    .

:Journey_to_Tamasá rdf:type :Event ;
    rdfs:label "Journey to Tamasá" ;
    :description "People followed Ráma, king turned back, citizens still tracked chariot, reached delightful river place" ;
    .

:Ráma's_speech_to_people rdf:type :Event ;
    rdfs:label "Ráma's speech to people" ;
    :description "Hero spoke to cheer like own children, urged them to love Bharat, praised Bharat's virtues, people longed for his empire" ;
    .

:Aged_Bráhmans'_plea rdf:type :Event ;
    rdfs:label "Aged Bráhmans' plea" ;
    :description "Twice-born wailed, raised hoary heads, called on horses to return, walked with Ráma, bore worship fires" ;
    .

:First_night_halt rdf:type :Event ;
    rdfs:label "First night halt" ;
    :description "Sun set at Tamasá, Sumantra tended horses, Ráma took only water, laid on leafy bed, Lakshmana kept watch all night" ;
    .

:Secret_departure_at_dawn rdf:type :Event ;
    rdfs:label "Secret departure at dawn" ;
    :description "Ráma rose, saw sleeping crowd, commanded swift journey while unconscious, drove north then back to mislead" ;
    .

:Citizens_awake_bereaved rdf:type :Event ;
    rdfs:label "Citizens awake bereaved" ;
    :description "Morn shone, people found no Ráma, fear and grief subdued senses, searched every place, contemplated death" ;
    .

:Women's_lament_and_taunt rdf:type :Event ;
    rdfs:label "Women's lament and taunt" ;
    :description "Each mansion filled with wailing, wives assailed returning lords, praised Lakshmana's loyalty, blessed nature Ráma touches" ;
    .

:Trijatá rdf:type :Character ;
    rdfs:label "Trijatá" ;
    :description "A compassionate Rakshasa matron who dreams of Lanka's fall and comforts Sita." ;
    .

:Mályaván rdf:type :Character ;
    rdfs:label "Mályaván" ;
    :description "An old and wise Rakshasa counselor who advises Ravana to make peace with Rama." ;
    .

:Sarama rdf:type :Character ;
    rdfs:label "Sarama" ;
    :description "A friendly Rakshasa woman who consoles Sita during her captivity." ;
    .

:Suka rdf:type :Character ;
    rdfs:label "Suka" ;
    :description "A spy sent by Ravana to inspect the Vanara army, captured and released by Rama's forces." ;
    .

:SáraGa rdf:type :Character ;
    rdfs:label "SáraGa" ;
    :description "Another spy of Ravana who describes the main Vanara chiefs to his king." ;
    .

:Suvela rdf:type :Place ;
    rdfs:label "Suvela" ;
    :description "The mountain near Lanka from which Rama and the Vanaras survey the enemy city." ;
    .

:Ocean rdf:type :Place ;
    rdfs:label "Ocean" ;
    :description "The great sea separating India and Lanka, bridged by the Vanara army." ;
    .

:Signet_Ring rdf:type :Concept ;
    rdfs:label "Signet Ring" ;
    :description "Rama's ring delivered by Hanuman to Sita as a token of identity." ;
    .

:ChúdámaGi rdf:type :Concept ;
    rdfs:label "ChúdámaGi" ;
    :description "Sita's crest jewel given to Hanuman to deliver to Rama." ;
    .

:Magic_Head rdf:type :Concept ;
    rdfs:label "Magic Head" ;
    :description "A deceptive illusion of Rama's severed head created by Ravana's magician to grieve Sita." ;
    .

:Trijatá's_Dream rdf:type :Event ;
    rdfs:label "Trijatá's Dream" ;
    :description "A prophetic dream indicating the victory of Rama and the destruction of Lanka." ;
    .

:VibhíshaGa's_Alliance rdf:type :Event ;
    rdfs:label "VibhíshaGa's Alliance" ;
    :description "Vibhishana defecting from Ravana and allying with Rama." ;
    .

:Bridging_of_the_Ocean rdf:type :Event ;
    rdfs:label "Bridging of the Ocean" ;
    :description "The construction of the bridge (Setu) by Nala and Neela to cross over to Lanka." ;
    .

:Vyasa rdf:type :Character ;
    rdfs:label "Vyasa" ;
    :description "The legendary sage credited with compiling the Vedas and Puranas." ;
    .

:Dhruva rdf:type :Character ;
    rdfs:label "Dhruva" ;
    :description "A devotee of Vishnu who attained the status of the pole star." ;
    .

:Mahapuranas rdf:type :Text ;
    rdfs:label "Mahapuranas" ;
    :description "The genre of 18 major Hindu encyclopedic scriptures." ;
    .

:Devi rdf:type :Deity ;
    rdfs:label "Devi" ;
    :description "The supreme goddess, representing cosmic energy and female divinity." ;
    .

:Yajna rdf:type :Concept ;
    rdfs:label "Yajna" ;
    :description "Ritual fire sacrifices and offerings." ;
    .

:Yuga rdf:type :Concept ;
    rdfs:label "Yuga" ;
    :description "Cosmic age cyclical divisions (Satya, Treta, Dvapara, Kali)." ;
    .

:Ganesha rdf:type :Deity ;
    rdfs:label "Ganesha" ;
    :description "The elephant-headed deity of wisdom and remover of obstacles." ;
    .

:Skanda rdf:type :Deity ;
    rdfs:label "Skanda" ;
    :description "The god of war, son of Shiva and Parvati." ;
    .

:Creation rdf:type :Event ;
    rdfs:label "Creation" ;
    :description "The cosmic creation process described in the Sarga sections of Puranas." ;
    .

:Krishna rdf:type :Deity ;
    rdfs:label "Krishna" ;
    :description "Avatara of Vishnu, supreme deity, ally of the Pandavas, and teacher of Arjuna." ;
    .

:Arjuna rdf:type :Character ;
    rdfs:label "Arjuna" ;
    :description "Third Pandava prince, the archer disciple of Sri Krishna on the battlefield of Kurukshetra." ;
    .

:Yudhishthira rdf:type :Character ;
    rdfs:label "Yudhishthira" ;
    :description "Eldest Pandava prince, known for his adherence to truth and righteousness." ;
    .

:Bhima rdf:type :Character ;
    rdfs:label "Bhima" ;
    :description "Second Pandava brother, known for his colossal physical strength." ;
    .

:Nakula rdf:type :Character ;
    rdfs:label "Nakula" ;
    :description "Fourth Pandava prince, twin of Sahadeva, known for his beauty and expertise with swords." ;
    .

:Sahadeva rdf:type :Character ;
    rdfs:label "Sahadeva" ;
    :description "Fifth Pandava prince, twin of Nakula, renowned for his wisdom and astrological skills." ;
    .

:Draupadi rdf:type :Character ;
    rdfs:label "Draupadi" ;
    :description "The princess of Panchala, common wife of the five Pandava brothers." ;
    .

:Karna rdf:type :Character ;
    rdfs:label "Karna" ;
    :description "Great warrior and ally of Duryodhana, son of Surya and Kunti." ;
    .

:Duryodhana rdf:type :Character ;
    rdfs:label "Duryodhana" ;
    :description "The eldest son of Dhritarashtra and leader of the Kaurava faction." ;
    .

:Dhritarashtra rdf:type :Character ;
    rdfs:label "Dhritarashtra" ;
    :description "The blind king of Hastinapura, father of the Kauravas." ;
    .

:Vidura rdf:type :Character ;
    rdfs:label "Vidura" ;
    :description "Half-brother of Dhritarashtra and Pandu, prime minister of Hastinapura, famous for his wisdom." ;
    .

:Bhishma rdf:type :Character ;
    rdfs:label "Bhishma" ;
    :description "The grand patriarch of the Kuru dynasty, commander of the Kaurava army." ;
    .

:Drona rdf:type :Character ;
    rdfs:label "Drona" ;
    :description "The royal preceptor and teacher of military arts to both Pandavas and Kauravas." ;
    .

:Kripa rdf:type :Character ;
    rdfs:label "Kripa" ;
    :description "A family preceptor of the Kurus who fought on the Kaurava side." ;
    .

:Pandu rdf:type :Character ;
    rdfs:label "Pandu" ;
    :description "King of Hastinapura, younger brother of Dhritarashtra, father of the Pandavas." ;
    .

:Hastinapura rdf:type :Place ;
    rdfs:label "Hastinapura" ;
    :description "The capital city of the Kuru kingdom, over which the war is fought." ;
    .

:Indraprastha rdf:type :Place ;
    rdfs:label "Indraprastha" ;
    :description "The capital city built by the Pandavas in the forest of Khandavaprastha." ;
    .

:Dwarka rdf:type :Place ;
    rdfs:label "Dwarka" ;
    :description "The island city ruled by Krishna." ;
    .

:Karma rdf:type :Concept ;
    rdfs:label "Karma" ;
    :description "Action and its corresponding consequences." ;
    .

:Kurukshetra_War rdf:type :Event ;
    rdfs:label "Kurukshetra War" ;
    :description "The great 18-day battle between the Pandavas and Kauravas." ;
    .

:Mahabharata rdf:type :Text ;
    rdfs:label "Mahabharata" ;
    :description "The monumental Sanskrit epic detailing the history of the Kuru dynasty." ;
    .

:Kurukshetra rdf:type :Place ;
    rdfs:label "Kurukshetra" ;
    :description "The sacred battlefield where the Mahabharata war and Gita dialogue occur." ;
    .

:Moksha rdf:type :Concept ;
    rdfs:label "Moksha" ;
    :description "Liberation from the cycle of samsara." ;
    .

:Bhakti rdf:type :Concept ;
    rdfs:label "Bhakti" ;
    :description "The spiritual path of love, devotion, and surrender to the Divine." ;
    .

:Shakuni rdf:type :Character ;
    rdfs:label "Shakuni" ;
    :description "Prince of Gandhara, maternal uncle of Duryodhana, architect of the game of dice." ;
    .

:Vaikuntha rdf:type :Place ;
    rdfs:label "Vaikuntha" ;
    :description "The celestial abode of Lord Vishnu." ;
    .

:Narada rdf:type :Character ;
    rdfs:label "Narada" ;
    :description "The divine sage and messenger of the gods." ;
    .

:Bali rdf:type :Character ;
    rdfs:label "Bali" ;
    :description "The benevolent demon king who offered three paces of land to Vamana avatar." ;
    .

:Kashi rdf:type :Place ;
    rdfs:label "Kashi" ;
    :description "The sacred city of Shiva, center of pilgrimage." ;
    .

:Mitra rdf:type :Deity ;
    rdfs:label "Mitra" ;
    :description "Vedic solar deity of friendship, contracts, and alliances, closely associated with Varuna." ;
    .

:Rta rdf:type :Concept ;
    rdfs:label "Rta" ;
    :description "The physical and moral order of the universe that gods and humans must follow." ;
    .

:Rigveda rdf:type :Text ;
    rdfs:label "Rigveda" ;
    :description "The oldest of the four Vedas, containing hymns to the deities." ;
    .

:Purusha rdf:type :Concept ;
    rdfs:label "Purusha" ;
    :description "The cosmic giant or primeval being from whose sacrifice the universe was created." ;
    .

:Ushas rdf:type :Deity ;
    rdfs:label "Ushas" ;
    :description "The goddess of dawn, bringing light and life to the world." ;
    .

:Savitr rdf:type :Deity ;
    rdfs:label "Savitr" ;
    :description "Vedic solar deity representing the morning sun, associated with the Gayatri mantra." ;
    .

:Soma rdf:type :Deity ;
    rdfs:label "Soma" ;
    :description "The deified sacred plant and drink of immortality offered in Vedic rituals." ;
    .

:Prithvi rdf:type :Deity ;
    rdfs:label "Prithvi" ;
    :description "The earth goddess, consort of Dyaus Pita." ;
    .

:Maruts rdf:type :Deity ;
    rdfs:label "Maruts" ;
    :description "The storm deities, companions of Indra and sons of Rudra." ;
    .

:Prahlada rdf:type :Character ;
    rdfs:label "Prahlada" ;
    :description "A saintly prince, devotee of Vishnu, saved from his demon father Hiranyakashipu." ;
    .

:Manvantara rdf:type :Concept ;
    rdfs:label "Manvantara" ;
    :description "Cosmic era ruled by a specific Manu, consisting of 71 Mahayugas." ;
    .

:Kailash rdf:type :Place ;
    rdfs:label "Kailash" ;
    :description "The sacred mountain abode of Lord Shiva." ;
    .

:Samaveda rdf:type :Text ;
    rdfs:label "Samaveda" ;
    :description "The Veda of melodies and chants chanted by Udgatri priests." ;
    .

:Savarí rdf:type :Character ;
    rdfs:label "Savarí" ;
    :description "An aged, pious votaress and pupil of Matanga who waits for Ráma's arrival before ascending to heaven." ;
    .

:Janasthán rdf:type :Place ;
    rdfs:label "Janasthán" ;
    :description "The forest region where Ráma dwelt in exile and where he slew the giant Khara and his host." ;
    .

:Matanga's_Wood rdf:type :Place ;
    rdfs:label "Matanga's Wood" ;
    :description "A sacred grove once inhabited by Saint Matanga and his pupils, where Savarí maintains her hermitage." ;
    .

:The_League rdf:type :Event ;
    rdfs:label "The League" ;
    :description "The formal alliance between Ráma and Sugríva, witnessed by the sacred fire." ;
    .

:King_Dasaratha rdf:type :Character ;
    rdfs:label "King Dasaratha" ;
    :description "Monarch of Ayodhya and father of Rama, Bharat, Lakshmana, and Shatrughna." ;
    :state "Grief-stricken by the exile of his son" ;
    .

:King_Janaka rdf:type :Character ;
    rdfs:label "King Janaka" ;
    :description "Ruler of Mithila and father of Sita and Urmila." ;
    :legacy "Guardian of the Great Bow of Rudra" ;
    .

:Manthara rdf:type :Character ;
    rdfs:label "Manthara" ;
    :description "A hump-backed slave-born handmaid who plots against Rama." ;
    .

:Fate rdf:type :Concept ;
    rdfs:label "Fate" ;
    :description "The resistless power described by Rama as the reason for his sudden change in fortune." ;
    .

:Dandaka_Forest rdf:type :Place ;
    rdfs:label "Dandaka Forest" ;
    :description "The wild forest where Rama is sentenced to spend 14 years in exile." ;
    .

:Breaking_of_the_Bow rdf:type :Event ;
    rdfs:label "Breaking of the Bow" ;
    :description "Rama strings and snaps the celestial bow of Shiva, winning Sita's hand." ;
    .

:The_Two_Boons rdf:type :Event ;
    rdfs:label "The Two Boons" ;
    :description "Kaikeyi's demand for Bharat's kingship and Rama's 14-year banishment." ;
    .

:Dyaus rdf:type :Deity ;
    rdfs:label "Dyaus" ;
    :description "The sky father deity, oldest deity of the Vedic pantheon." ;
    .

:Yajurveda rdf:type :Text ;
    rdfs:label "Yajurveda" ;
    :description "The Veda of prose mantras and ritual formulas." ;
    .

:Atharvaveda rdf:type :Text ;
    rdfs:label "Atharvaveda" ;
    :description "The Veda of spells, charms, and everyday procedures." ;
    .

:Satyavati rdf:type :Character ;
