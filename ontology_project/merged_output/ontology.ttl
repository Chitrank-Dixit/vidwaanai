    :description "Son of first Janak, blessed with all virtues, good and true" ;
    .

:Nandivardhan rdf:type :Character ;
    rdfs:label "Nandivardhan" ;
    :description "Son of Udávasu, dear for pious heart and worth sincere" ;
    .

:Suketu rdf:type :Character ;
    rdfs:label "Suketu" ;
    :description "Son of Nandivardhan, hero brave" ;
    .

:Devarát rdf:type :Character ;
