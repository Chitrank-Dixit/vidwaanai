{
    "entities": [
        {
            "name": "Rama",
            "type": "Character",
            "attributes": {
                "description": "The eldest son of King Da[aratha, described as truthful, just, and supreme in war; the intended Regent Heir."
            }
        },
        {
            "name": "Dasharatha",
            "type": "Character",
            "attributes": {
                "description": "The aged King of Ayodhyá who seeks to retire and install his son Ráma as his successor."
            }
        },
        {
            "name": "Lakshmana",
            "type": "Character",
            "attributes": {
                "description": "Ráma's devoted brother and 'second self', son of Queen Sumitrá."
            }
        },
        {
            "name": "Sita",
            "type": "Character",
            "attributes": {
                "description": "Ráma's wife who joins him in the sacred fast preceding his intended consecration."
            }
        },
        {
            "name": "Kausalya",
            "type": "Character",
            "attributes": {
                "description": "The first queen of Da[aratha and mother of Ráma; a devout worshipper of Fortune's Queen."
            }
        },
        {
            "name": "Vashishtha",
            "type": "Character",
            "attributes": {
                "description": "The chief holy priest of the royal court who directs the religious rites and the fast for Ráma."
            }
        },
        {
            "name": "Sumantra",
            "type": "Character",
            "attributes": {
                "description": "The royal charioteer and trusted envoy of King Da[aratha."
            }
        },
        {
            "name": "Bharat",
            "type": "Character",
            "attributes": {
                "description": "Ráma's brother who is away visiting his royal kin in Kekaya during the time of the decree."
            }
        },
        {
            "name": "Ayodhya",
            "type": "Place",
            "attributes": {
                "description": "The capital city of the Ikshváku line where the assembly meets."
            }
        },
        {
            "name": "Indra",
            "type": "Deity",
            "attributes": {
                "description": "The King of Gods, used as a frequent comparison for Da[aratha's glory and Ráma's bravery."
            }
        },
        {
            "name": "Pushya",
            "type": "Concept",
            "attributes": {
                "description": "An auspicious lunar asterism (star sign) chosen for Ráma's consecration ceremony."
            }
        },
        {
            "name": "Vedas",
            "type": "Text",
            "attributes": {
                "description": "The holy scriptures in which Ráma is highly trained."
            }
        },
        {
            "name": "Consecration of Ráma",
            "type": "Event",
            "attributes": {
                "description": "The planned ceremony to install Ráma as the Regent Heir to the throne of Ayodhyá."
            }
        }
    ],
