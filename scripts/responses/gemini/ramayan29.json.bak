            "attributes": {
                "description": "Son of Daśaratha and heir of Ikshváku, currently undergoing fourteen years of banishment."
            }
        },
        {
            "name": "Sita",
            "type": "Character",
            "attributes": {
                "description": "Daughter of Janak and wife of Ráma; also referred to as the Maithil dame and Videhan lady."
            }
        },
        {
            "name": "Lakshmana",
            "type": "Character",
            "attributes": {
                "description": "Son of Sumitrá and loyal brother to Ráma, serving as his protector during the exile."
            }
        },
        {
            "name": "Bharadvája",
            "type": "Character",
            "attributes": {
                "description": "A high-souled hermit residing at Prayág near the confluence of the Gangá and Yamuná."
            }
        },
        {
            "name": "Ganga",
            "type": "Deity",
            "attributes": {
                "description": "The Goddess of the holy stream, spouse of the God o'er floods, originating from Brahmá's sphere."
            }
        },
        {
            "name": "Kálindí",
            "type": "Deity",
            "attributes": {
                "description": "Another name for the river Yamuná, personified as the Sun-born Goddess."
            }
        },
        {
            "name": "Chitrakuta",
            "type": "Place",
            "attributes": {
                "description": "A holy mountain with varied peaks, located ten leagues from Prayág, chosen as Ráma's forest home."
            }
        },
        {
            "name": "Prayág",
            "type": "Place",
            "attributes": {
                "description": "The sacred confluence where the Yamuná and Gangá rivers meet."
            }
        },
        {
            "name": "Banishment",
            "type": "Event",
            "attributes": {
                "duration": "14 years",
                "description": "The forced exile of Ráma from Ayodhyá due to Kaikeyí's wish."
            }
        },
        {
            "name": "Scripture",
            "type": "Text",
            "attributes": {
                "description": "The sacred Hindu texts (Vedas) prescribing religious rites and social duties."
