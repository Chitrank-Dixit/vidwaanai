            }
        },
        {
            "from": "Hanuman",
            "to": "Rama",
            "type": "RELATED_TO",
            "attributes": {
                "context": "Hanumán wins Ráma's steadfast friendship and serves as his envoy."
            }
        },
        {
            "from": "Ravana",
            "to": "Sita",
            "type": "PARTICIPATED_IN",
            "attributes": {
                "context": "RávaG abducts Sítá from the hermitage using magic art."
            }
        },
        {
            "from": "Sugriva",
            "to": "Rama",
            "type": "RELATED_TO",
            "attributes": {
                "context": "Sugríva and Ráma swear alliance before the sacred flame."
            }
        },
        {
            "from": "Bharat",
            "to": "Rama",
            "type": "RELATED_TO",
            "attributes": {
                "context": "Bharat is the brother who refuses the throne and rules as a regent via Ráma's sandals."
            }
        }
    ]
